        }
      ],
      "FunctionSignature": "Autodesk.AutoCAD.DynamoNodes.Property.SetValue@var",
      "Replication": "Auto",
      "Description": "Sets the value of a property\n\nProperty.SetValue (value: var): Property"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] = CorridorName (string)\r\n# IN[1] = BaselineName (string)\r\n\r\nimport clr\r\n\r\ndef to_clean_string(x):\r\n    if x is None:\r\n        return \"\"\r\n    return str(x).strip()\r\n\r\ndef result(ok, msg, validated=None, original=None):\r\n    return (ok, msg, validated, original)\r\n\r\ncorridor_name = to_clean_string(IN[0])\r\nbaseline_name_original = \"\" if IN[1] is None else str(IN[1])  # echo EXACT original (no strip)\r\nbaseline_name_check = to_clean_string(IN[1])                  # used for validation (trimmed)\r\n\r\n# ---------- Input validation ----------\r\nif corridor_name == \"\":\r\n    OUT = result(False, \"ERROR: CorridorName is empty.\", None, baseline_name_original)\r\n    raise SystemExit\r\n\r\nif baseline_name_check == \"\":\r\n    OUT = result(False, \"ERROR: BaselineName is empty.\", None, baseline_name_original)\r\n    raise SystemExit\r\n\r\ntry:\r\n    clr.AddReference(\"AcMgd\")\r\n    clr.AddReference(\"AcDbMgd\")\r\n    clr.AddReference(\"AeccDbMgd\")\r\n\r\n    from Autodesk.AutoCAD.ApplicationServices import Application\r\n    from Autodesk.AutoCAD.DatabaseServices import OpenMode\r\n    import Autodesk.Civil.ApplicationServices as civApp\r\n\r\n    doc = Application.DocumentManager.MdiActiveDocument\r\n    db = doc.Database\r\n    civil_doc = civApp.CivilApplication.ActiveDocument\r\n\r\n    exists = False\r\n\r\n    with doc.LockDocument():\r\n        tr = db.TransactionManager.StartTransaction()\r\n        try:\r\n            corridor = None\r\n            for cid in civil_doc.CorridorCollection:\r\n                cor = tr.GetObject(cid, OpenMode.ForRead)\r\n                if cor.Name == corridor_name:\r\n                    corridor = cor\r\n                    break\r\n\r\n            if corridor is None:\r\n                OUT = result(\r\n                    False,\r\n                    \"ERROR: Corridor '{}' was not found.\".format(corridor_name),\r\n                    None,\r\n                    baseline_name_original\r\n                )\r\n                tr.Commit()\r\n                raise SystemExit\r\n\r\n            if corridor.Baselines.Count == 0:\r\n                OUT = result(\r\n                    False,\r\n                    \"ERROR: Corridor '{}' contains no baselines.\".format(corridor_name),\r\n                    None,\r\n                    baseline_name_original\r\n                )\r\n                tr.Commit()\r\n                raise SystemExit\r\n\r\n            for bl in corridor.Baselines:\r\n                if bl.Name == baseline_name_check:\r\n                    exists = True\r\n                    break\r\n\r\n            if exists:\r\n                OUT = result(\r\n                    True,\r\n                    \"OK: Baseline '{}' exists in corridor '{}'.\".format(baseline_name_check, corridor_name),\r\n                    baseline_name_check,\r\n                    baseline_name_original\r\n                )\r\n            else:\r\n                OUT = result(\r\n                    False,\r\n                    \"ERROR: Baseline '{}' does not exist in corridor '{}'.\".format(\r\n                        baseline_name_check, corridor_name\r\n                    ),\r\n                    None,\r\n                    baseline_name_original\r\n                )\r\n\r\n            tr.Commit()\r\n        finally:\r\n            tr.Dispose()\r\n\r\nexcept Exception as ex:\r\n    OUT = result(\r\n        False,\r\n        \"ERROR: Civil 3D API failure: {}\".format(ex),\r\n        None,\r\n        baseline_name_original\r\n    )",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0e5b3e1949994b77b9c8f830d86bfc0d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "2bbe63253ea947298bd255ba8eb65649",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
