    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "54d3f2a288534994b7e846f5e815a484",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "a5d90800ac5f45a99cb23fdc2e994343",
          "Name": "property",
          "Description": "Autodesk.AutoCAD.DynamoNodes.Property",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d520353dc28642278019897d754414ca",
