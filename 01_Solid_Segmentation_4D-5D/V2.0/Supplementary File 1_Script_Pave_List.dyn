          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "bfda13879d064ce1b4edb0ebff48cadc",
          "Name": "item",
          "Description": "Item in the list at the given index.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.GetItemAtIndex@var[]..[],int",
      "Replication": "Auto",
      "Description": "Returns an item from the given list that's located at the specified index.\n\nList.GetItemAtIndex (list: var[]..[], index: int): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] = list to validate (expected strictly increasing numeric sequence)\r\n\r\ndef result(ok, msg, clean=None, issues=None):\r\n    return (ok, msg, clean, issues)\r\n\r\ndata = IN[0]\r\n\r\n# ---------- Basic checks ----------\r\nif data is None:\r\n    OUT = result(False, \"ERROR: Input list is None.\", None, None)\r\n    raise SystemExit\r\n\r\nif not isinstance(data, (list, tuple)):\r\n    OUT = result(False, \"ERROR: Input is not a list.\", None, None)\r\n    raise SystemExit\r\n\r\nif len(data) == 0:\r\n    OUT = result(False, \"ERROR: Input list is empty.\", None, None)\r\n    raise SystemExit\r\n\r\nissues = {\r\n    \"non_numeric\": [],      # (index, value)\r\n    \"not_increasing\": [],   # (prev_index, curr_index, prev_value, curr_value)\r\n    \"duplicates\": []        # (prev_index, curr_index, value)\r\n}\r\n\r\n# ---------- Parse to floats (accept numeric strings like \"10.5\"; reject \"10+5\") ----------\r\nclean = []\r\nfor i, v in enumerate(data):\r\n    if v is None:\r\n        issues[\"non_numeric\"].append((i, v))\r\n        continue\r\n    try:\r\n        # Dynamo may pass numbers as int/float; strings may appear from Excel/CSV\r\n        fv = float(str(v).strip()) if isinstance(v, str) else float(v)\r\n        clean.append(fv)\r\n    except:\r\n        issues[\"non_numeric\"].append((i, v))\r\n\r\nif issues[\"non_numeric\"]:\r\n    OUT = result(\r\n        False,\r\n        \"ERROR: Non-numeric values detected in the input list.\",\r\n        None,\r\n        issues\r\n    )\r\n    raise SystemExit\r\n\r\n# ---------- Strictly increasing check (no duplicates, no decreases) ----------\r\n# Tolerance helps with floating point noise (e.g., 50.2540000001)\r\ntol = 1e-9\r\n\r\nfor i in range(1, len(clean)):\r\n    prev = clean[i - 1]\r\n    curr = clean[i]\r\n\r\n    if abs(curr - prev) <= tol:\r\n        issues[\"duplicates\"].append((i - 1, i, prev))\r\n    elif curr < prev - tol:\r\n        issues[\"not_increasing\"].append((i - 1, i, prev, curr))\r\n\r\n# ---------- Final decision ----------\r\nif issues[\"duplicates\"] or issues[\"not_increasing\"]:\r\n    parts = []\r\n    if issues[\"duplicates\"]:\r\n        parts.append(\"duplicate values (equal consecutive entries)\")\r\n    if issues[\"not_increasing\"]:\r\n        parts.append(\"non-increasing steps (a value is smaller than the previous one)\")\r\n\r\n    OUT = result(\r\n        False,\r\n        \"ERROR: Input list is invalid: \" + \" and \".join(parts) + \".\",\r\n        None,\r\n        issues\r\n    )\r\nelse:\r\n    OUT = result(\r\n        True,\r\n        \"OK: Input list is strictly increasing and numeric (decimals allowed).\",\r\n        clean,\r\n        None\r\n    )\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b766f9e197444941a84eef26899df313",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "36190c77a13b4fc29d4b30b1e571c0ce",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0b396468272b4c7bba3f130c746c5582",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
