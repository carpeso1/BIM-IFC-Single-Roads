    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "fad50af9c22e4fb2a23f58e83f7e48e4",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "f97f2a9771144543a812133d99dd7aac",
          "Name": "list",
          "Description": "List to flatten.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4e13811a0ac24eb3858e7e1dc5b9a3bc",
          "Name": "amount",
          "Description": "Layers of list nesting to remove (-1 will remove all list nestings)\n\nint\nDefault value : -1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "987154766f8a4939b37df0f0bcfac181",
          "Name": "list",
          "Description": "Flattened list by amount",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.Flatten@var[]..[],int",
      "Replication": "Auto",
      "Description": "Flattens a nested list of lists by a certain amount.\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - Diagnose and select outermost ETW/EPS feature line\r\n#\r\n# IN[0] = Corridor Feature Lines for one side\r\n# IN[1] = Stations (PKValue)\r\n# IN[2] = Excel offsets measured outward from the pavement edge\r\n#\r\n# OUT[0] = Selected reference offsets\r\n# OUT[1] = Selected elevations\r\n# OUT[2] = Final offsets from baseline alignment\r\n# OUT[3] = Diagnostic candidates\r\n# OUT[4] = Warnings\r\n\r\nfeature_lines_input = IN[0]\r\nstations_input = IN[1]\r\nexcel_offsets_input = IN[2]\r\n\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    if \"+\" in text:\r\n        text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_value(result, key):\r\n    if result is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(result, dict):\r\n            return result.get(key)\r\n\r\n        if hasattr(result, \"ValueAtKey\"):\r\n            return result.ValueAtKey(key)\r\n\r\n        return result[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef object_label(obj):\r\n    \"\"\"Returns a readable label for diagnostic purposes.\"\"\"\r\n    if obj is None:\r\n        return \"None\"\r\n\r\n    try:\r\n        return str(obj)\r\n    except Exception:\r\n        return obj.GetType().Name\r\n\r\n\r\nfeature_lines = as_list(feature_lines_input)\r\nstations = as_list(stations_input)\r\nexcel_offsets = as_list(excel_offsets_input)\r\n\r\nselected_reference_offsets = []\r\nselected_elevations = []\r\nfinal_offsets = []\r\ndiagnostics = []\r\nwarnings = []\r\n\r\n\r\nfor index, station_value in enumerate(stations):\r\n\r\n    station = to_number(station_value)\r\n\r\n    excel_offset = (\r\n        to_number(excel_offsets[index])\r\n        if index < len(excel_offsets)\r\n        else 0.0\r\n    )\r\n\r\n    if excel_offset is None:\r\n        excel_offset = 0.0\r\n\r\n    if station is None:\r\n        selected_reference_offsets.append(None)\r\n        selected_elevations.append(None)\r\n        final_offsets.append(None)\r\n        diagnostics.append([])\r\n\r\n        warnings.append(\r\n            \"Item {}: invalid station value.\".format(index)\r\n        )\r\n        continue\r\n\r\n    candidates = []\r\n    item_diagnostics = []\r\n\r\n    for line_index, feature_line in enumerate(feature_lines):\r\n\r\n        if feature_line is None:\r\n            continue\r\n\r\n        try:\r\n            result = feature_line.OffsetElevationByStation(station)\r\n\r\n            offset = to_number(\r\n                get_value(result, \"Offset\")\r\n            )\r\n\r\n            elevation = to_number(\r\n                get_value(result, \"Elevation\")\r\n            )\r\n\r\n            item_diagnostics.append({\r\n                \"LineIndex\": line_index,\r\n                \"FeatureLine\": object_label(feature_line),\r\n                \"Station\": station,\r\n                \"Offset\": offset,\r\n                \"Elevation\": elevation\r\n            })\r\n\r\n            if offset is not None and elevation is not None:\r\n                candidates.append(\r\n                    (\r\n                        abs(offset),\r\n                        offset,\r\n                        elevation,\r\n                        line_index,\r\n                        object_label(feature_line)\r\n                    )\r\n                )\r\n\r\n        except Exception as error:\r\n            item_diagnostics.append({\r\n                \"LineIndex\": line_index,\r\n                \"FeatureLine\": object_label(feature_line),\r\n                \"Station\": station,\r\n                \"Error\": str(error)\r\n            })\r\n\r\n    diagnostics.append(item_diagnostics)\r\n\r\n    if len(candidates) == 0:\r\n        selected_reference_offsets.append(None)\r\n        selected_elevations.append(None)\r\n        final_offsets.append(None)\r\n\r\n        warnings.append(\r\n            \"Item {}: no valid ETW or EPS feature line \"\r\n            \"was found at station {}.\"\r\n            .format(index, station)\r\n        )\r\n        continue\r\n\r\n    # Largest absolute lateral offset\r\n    selected = max(\r\n        candidates,\r\n        key=lambda item: item[0]\r\n    )\r\n\r\n    reference_offset = selected[1]\r\n    elevation = selected[2]\r\n\r\n    direction = 1.0 if reference_offset >= 0 else -1.0\r\n\r\n    final_offset = (\r\n        reference_offset\r\n        + direction * abs(excel_offset)\r\n    )\r\n\r\n    selected_reference_offsets.append(reference_offset)\r\n    selected_elevations.append(elevation)\r\n    final_offsets.append(final_offset)\r\n\r\n\r\nOUT = (\r\n    selected_reference_offsets,  # 0\r\n    selected_elevations,         # 1\r\n    final_offsets,               # 2\r\n    diagnostics,                 # 3\r\n    warnings                     # 4\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c4f956a5710b440db63ab9b027f5b7e4",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "901a695073e2454d8367bef32275a852",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "76bea65ac6274664a70571e618c8b6e9",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "009b260e639f4877b83e8bd07172750f",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "988563cb4b5347269b3a6c3097bb58ae",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - Diagnose and select outermost ETW/EPS feature line\r\n#\r\n# IN[0] = Corridor Feature Lines for one side\r\n# IN[1] = Stations (PKValue)\r\n# IN[2] = Excel offsets measured outward from the pavement edge\r\n#\r\n# OUT[0] = Selected reference offsets\r\n# OUT[1] = Selected elevations\r\n# OUT[2] = Final offsets from baseline alignment\r\n# OUT[3] = Diagnostic candidates\r\n# OUT[4] = Warnings\r\n\r\nfeature_lines_input = IN[0]\r\nstations_input = IN[1]\r\nexcel_offsets_input = IN[2]\r\n\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    if \"+\" in text:\r\n        text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_value(result, key):\r\n    if result is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(result, dict):\r\n            return result.get(key)\r\n\r\n        if hasattr(result, \"ValueAtKey\"):\r\n            return result.ValueAtKey(key)\r\n\r\n        return result[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef object_label(obj):\r\n    \"\"\"Returns a readable label for diagnostic purposes.\"\"\"\r\n    if obj is None:\r\n        return \"None\"\r\n\r\n    try:\r\n        return str(obj)\r\n    except Exception:\r\n        return obj.GetType().Name\r\n\r\n\r\nfeature_lines = as_list(feature_lines_input)\r\nstations = as_list(stations_input)\r\nexcel_offsets = as_list(excel_offsets_input)\r\n\r\nselected_reference_offsets = []\r\nselected_elevations = []\r\nfinal_offsets = []\r\ndiagnostics = []\r\nwarnings = []\r\n\r\n\r\nfor index, station_value in enumerate(stations):\r\n\r\n    station = to_number(station_value)\r\n\r\n    excel_offset = (\r\n        to_number(excel_offsets[index])\r\n        if index < len(excel_offsets)\r\n        else 0.0\r\n    )\r\n\r\n    if excel_offset is None:\r\n        excel_offset = 0.0\r\n\r\n    if station is None:\r\n        selected_reference_offsets.append(None)\r\n        selected_elevations.append(None)\r\n        final_offsets.append(None)\r\n        diagnostics.append([])\r\n\r\n        warnings.append(\r\n            \"Item {}: invalid station value.\".format(index)\r\n        )\r\n        continue\r\n\r\n    candidates = []\r\n    item_diagnostics = []\r\n\r\n    for line_index, feature_line in enumerate(feature_lines):\r\n\r\n        if feature_line is None:\r\n            continue\r\n\r\n        try:\r\n            result = feature_line.OffsetElevationByStation(station)\r\n\r\n            offset = to_number(\r\n                get_value(result, \"Offset\")\r\n            )\r\n\r\n            elevation = to_number(\r\n                get_value(result, \"Elevation\")\r\n            )\r\n\r\n            item_diagnostics.append({\r\n                \"LineIndex\": line_index,\r\n                \"FeatureLine\": object_label(feature_line),\r\n                \"Station\": station,\r\n                \"Offset\": offset,\r\n                \"Elevation\": elevation\r\n            })\r\n\r\n            if offset is not None and elevation is not None:\r\n                candidates.append(\r\n                    (\r\n                        abs(offset),\r\n                        offset,\r\n                        elevation,\r\n                        line_index,\r\n                        object_label(feature_line)\r\n                    )\r\n                )\r\n\r\n        except Exception as error:\r\n            item_diagnostics.append({\r\n                \"LineIndex\": line_index,\r\n                \"FeatureLine\": object_label(feature_line),\r\n                \"Station\": station,\r\n                \"Error\": str(error)\r\n            })\r\n\r\n    diagnostics.append(item_diagnostics)\r\n\r\n    if len(candidates) == 0:\r\n        selected_reference_offsets.append(None)\r\n        selected_elevations.append(None)\r\n        final_offsets.append(None)\r\n\r\n        warnings.append(\r\n            \"Item {}: no valid ETW or EPS feature line \"\r\n            \"was found at station {}.\"\r\n            .format(index, station)\r\n        )\r\n        continue\r\n\r\n    # Largest absolute lateral offset\r\n    selected = max(\r\n        candidates,\r\n        key=lambda item: item[0]\r\n    )\r\n\r\n    reference_offset = selected[1]\r\n    elevation = selected[2]\r\n\r\n    direction = 1.0 if reference_offset >= 0 else -1.0\r\n\r\n    final_offset = (\r\n        reference_offset\r\n        + direction * abs(excel_offset)\r\n    )\r\n\r\n    selected_reference_offsets.append(reference_offset)\r\n    selected_elevations.append(elevation)\r\n    final_offsets.append(final_offset)\r\n\r\n\r\nOUT = (\r\n    selected_reference_offsets,  # 0\r\n    selected_elevations,         # 1\r\n    final_offsets,               # 2\r\n    diagnostics,                 # 3\r\n    warnings                     # 4\r\n)",
