    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - VALIDATE_PK_WITH_CORRIDOR\r\n# Validates whether each sign station is within the selected corridor range.\r\n#\r\n# IN[0] = Excel data passed through BlockDirectory\r\n# IN[1] = Corridor FeatureLine\r\n#\r\n# OUT[0] = Valid rows\r\n# OUT[1] = Invalid rows\r\n# OUT[2] = Validation errors\r\n\r\nimport re\r\n\r\ndata = IN[0]\r\nfeature_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef first_valid_featureline(obj):\r\n    \"\"\"\r\n    Returns the first valid CorridorFeatureLine found in a nested input.\r\n    \"\"\"\r\n    if obj is None:\r\n        return None\r\n\r\n    if isinstance(obj, (list, tuple)):\r\n        for item in obj:\r\n            result = first_valid_featureline(item)\r\n\r\n            if result is not None:\r\n                return result\r\n\r\n        return None\r\n\r\n    return obj\r\n\r\n\r\ndef is_empty_row(row):\r\n    \"\"\"\r\n    Checks whether an imported Excel row is empty.\r\n    \"\"\"\r\n    if row is None:\r\n        return True\r\n\r\n    if not isinstance(row, (list, tuple)):\r\n        return True\r\n\r\n    return all(\r\n        value is None or str(value).strip() == \"\"\r\n        for value in row\r\n    )\r\n\r\n\r\ndef to_number(value):\r\n    \"\"\"\r\n    Converts Excel numbers or station labels into float values.\r\n    Examples:\r\n        6351.00  -> 6351.0\r\n        6+351.00 -> 6351.0\r\n        6351,00  -> 6351.0\r\n    \"\"\"\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    if \"+\" in text:\r\n        text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    text = re.sub(r\"[^0-9.\\-]\", \"\", text)\r\n\r\n    try:\r\n        return float(text)\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# INITIALIZATION\r\n# ============================================================\r\n\r\nfeature_line = first_valid_featureline(feature_input)\r\n\r\nvalid_rows = []\r\ninvalid_rows = []\r\nerrors = []\r\n\r\n\r\n# ============================================================\r\n# VALIDATION\r\n# ============================================================\r\n\r\nif feature_line is None:\r\n\r\n    OUT = (\r\n        [],\r\n        data if data is not None else [],\r\n        [\"No valid CorridorFeatureLine was received.\"]\r\n    )\r\n\r\nelse:\r\n\r\n    if data is None:\r\n        data = []\r\n\r\n    for index, row in enumerate(data):\r\n\r\n        excel_row_number = index + 2\r\n\r\n        if is_empty_row(row):\r\n            continue\r\n\r\n        # Current SIGNS worksheet contains 22 columns\r\n        if not isinstance(row, (list, tuple)) or len(row) < 22:\r\n\r\n            invalid_rows.append(row)\r\n\r\n            errors.append(\r\n                \"Row {}: Incomplete data structure. \"\r\n                \"The current SIGNS worksheet requires 22 columns.\"\r\n                .format(excel_row_number)\r\n            )\r\n\r\n            continue\r\n\r\n        # ----------------------------------------------------\r\n        # CURRENT SIGNS COLUMN ORDER\r\n        # ----------------------------------------------------\r\n\r\n        element_id = row[0]\r\n        block_name = row[1]\r\n        side = row[2]\r\n        pk_value = to_number(row[3])\r\n        pk_label = row[4]\r\n\r\n        # ----------------------------------------------------\r\n        # VALIDATE PK VALUE\r\n        # ----------------------------------------------------\r\n\r\n        if pk_value is None:\r\n\r\n            # Optional fallback using PKLabel\r\n            pk_value = to_number(pk_label)\r\n\r\n        if pk_value is None:\r\n\r\n            invalid_rows.append(row)\r\n\r\n            errors.append(\r\n                \"Row {} | ID: {} | Invalid PKValue and PKLabel.\"\r\n                .format(\r\n                    excel_row_number,\r\n                    element_id\r\n                )\r\n            )\r\n\r\n            continue\r\n\r\n        # ----------------------------------------------------\r\n        # CHECK STATION AGAINST THE CORRIDOR FEATURE LINE\r\n        # ----------------------------------------------------\r\n\r\n        try:\r\n\r\n            test_result = feature_line.OffsetElevationByStation(\r\n                pk_value\r\n            )\r\n\r\n            if test_result is None:\r\n\r\n                invalid_rows.append(row)\r\n\r\n                errors.append(\r\n                    \"Row {} | ID: {} | Block: {} | Side: {} | \"\r\n                    \"PK: {} / {} is outside the corridor range.\"\r\n                    .format(\r\n                        excel_row_number,\r\n                        element_id,\r\n                        block_name,\r\n                        side,\r\n                        pk_label,\r\n                        pk_value\r\n                    )\r\n                )\r\n\r\n            else:\r\n\r\n                valid_rows.append(row)\r\n\r\n        except Exception as error:\r\n\r\n            invalid_rows.append(row)\r\n\r\n            errors.append(\r\n                \"Row {} | ID: {} | Block: {} | PK: {} / {} \"\r\n                \"could not be validated. Details: {}\"\r\n                .format(\r\n                    excel_row_number,\r\n                    element_id,\r\n                    block_name,\r\n                    pk_label,\r\n                    pk_value,\r\n                    str(error)\r\n                )\r\n            )\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    valid_rows,      # 0 - Valid Excel rows\r\n    invalid_rows,    # 1 - Invalid Excel rows\r\n    errors           # 2 - Validation messages\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6152f76ffcda4c36b35ff84e1251a27d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b6534e04979f42d19c214143abfda82e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a0dc0e4d6f3e4e43911d65814b95a717",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0628cb6f7e794b568be09d0fc17db8b7",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
