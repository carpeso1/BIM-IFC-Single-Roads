      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - Dynamo / Civil 3D\r\nimport re\r\n\r\ndata = IN[0]\r\nSIDE_TARGET = \"RIGHT\"  # Cambiar a \"LEFT\" en el nodo del lado izquierdo\r\n\r\n\r\ndef to_number(value):\r\n    \"\"\"Convierte valores numéricos o textos de Excel a float.\"\"\"\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    # Permite leer PK escritos como 6+351.00\r\n    if \"+\" in text:\r\n        text = text.replace(\"+\", \"\")\r\n\r\n    # Convierte coma decimal a punto\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    text = re.sub(r\"[^0-9.\\-]\", \"\", text)\r\n\r\n    try:\r\n        return float(text)\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef norm_side(value):\r\n    \"\"\"Normaliza diferentes formas de escribir LEFT y RIGHT.\"\"\"\r\n    text = str(value).strip().upper()\r\n\r\n    if text in [\"RIGHT\", \"R\", \"DERECHA\", \"DER\", \"D\"]:\r\n        return \"RIGHT\"\r\n\r\n    if text in [\"LEFT\", \"L\", \"IZQUIERDA\", \"IZQ\", \"I\"]:\r\n        return \"LEFT\"\r\n\r\n    return text\r\n\r\n\r\n# ============================================================\r\n# LISTAS DE SALIDA EN EL MISMO ORDEN DE LA HOJA SIGNS\r\n# ============================================================\r\n\r\nids = []             # 0\r\nblocknames = []      # 1\r\nsides = []           # 2\r\npkvalues = []        # 3\r\npklabels = []        # 4\r\noffsets = []         # 5\r\nheights = []         # 6\r\neyeheights = []      # 7\r\nnotes = []           # 8\r\nmaterials = []       # 9\r\nrotationmodes = []   # 10\r\nlayers = []          # 11\r\ndwgnames = []        # 12\r\nsigncodes = []       # 13\r\nifcentities = []     # 14\r\ncategories = []      # 15\r\nnormatives = []      # 16\r\ndescriptions = []    # 17\r\nquantities = []      # 18\r\nunittimes = []       # 19\r\nunitcosts = []       # 20\r\ntotalcosts = []      # 21\r\n\r\nwarnings = []        # 22\r\n\r\n\r\n# ============================================================\r\n# LECTURA Y FILTRADO DE FILAS\r\n# ============================================================\r\n\r\nfor idx, row in enumerate(data):\r\n    excel_row = idx + 2\r\n\r\n    try:\r\n        # La estructura actual requiere al menos 22 columnas\r\n        if row is None or len(row) < 22:\r\n            continue\r\n\r\n        element_id = row[0]\r\n        blockname = row[1]\r\n        side = norm_side(row[2])\r\n        pkvalue = to_number(row[3])\r\n        pklabel = row[4]\r\n        offset = to_number(row[5])\r\n        height = to_number(row[6])\r\n        eyeheight = to_number(row[7])\r\n        note = row[8]\r\n        material = row[9]\r\n        rotationmode = row[10]\r\n        layer = row[11]\r\n        dwgname = row[12]\r\n        signcode = row[13]\r\n        ifcentity = row[14]\r\n        category = row[15]\r\n        normative = row[16]\r\n        description = row[17]\r\n        quantity = to_number(row[18])\r\n        unittime = to_number(row[19])\r\n        unitcost = to_number(row[20])\r\n        totalcost = to_number(row[21])\r\n\r\n        # Ignorar filas sin bloque seleccionado\r\n        if blockname is None or str(blockname).strip() == \"\":\r\n            continue\r\n\r\n        # Separar señales según el lado\r\n        if side != SIDE_TARGET:\r\n            continue\r\n\r\n        # PKValue es el dato utilizado para la geometría\r\n        if pkvalue is None:\r\n            pkvalue = to_number(pklabel)\r\n\r\n        if pkvalue is None:\r\n            warnings.append(\r\n                \"Fila {}: PKValue/PKLabel inválido.\".format(excel_row)\r\n            )\r\n            continue\r\n\r\n        if offset is None:\r\n            warnings.append(\r\n                \"Fila {}: Offset inválido.\".format(excel_row)\r\n            )\r\n            continue\r\n\r\n        # Valores predeterminados\r\n        if quantity is None:\r\n            quantity = 1.0\r\n\r\n        if unittime is None:\r\n            unittime = 0.0\r\n\r\n        if unitcost is None:\r\n            unitcost = 0.0\r\n\r\n        if totalcost is None:\r\n            totalcost = quantity * unitcost\r\n\r\n        # Agregar datos conservando el orden de SIGNS\r\n        ids.append(element_id)\r\n        blocknames.append(blockname)\r\n        sides.append(side)\r\n        pkvalues.append(pkvalue)\r\n        pklabels.append(pklabel)\r\n        offsets.append(offset)\r\n        heights.append(height)\r\n        eyeheights.append(eyeheight)\r\n        notes.append(note)\r\n        materials.append(material)\r\n        rotationmodes.append(rotationmode)\r\n        layers.append(layer)\r\n        dwgnames.append(dwgname)\r\n        signcodes.append(signcode)\r\n        ifcentities.append(ifcentity)\r\n        categories.append(category)\r\n        normatives.append(normative)\r\n        descriptions.append(description)\r\n        quantities.append(quantity)\r\n        unittimes.append(unittime)\r\n        unitcosts.append(unitcost)\r\n        totalcosts.append(totalcost)\r\n\r\n    except Exception as error:\r\n        warnings.append(\r\n            \"Fila {}: {}\".format(excel_row, str(error))\r\n        )\r\n\r\n\r\n# ============================================================\r\n# SALIDAS\r\n# ============================================================\r\n\r\nOUT = (\r\n    ids,             # 0  ID\r\n    blocknames,      # 1  BlockName\r\n    sides,           # 2  Side\r\n    pkvalues,        # 3  PKValue / Station\r\n    pklabels,        # 4  PKLabel\r\n    offsets,         # 5  Offset\r\n    heights,         # 6  Height\r\n    eyeheights,      # 7  EyeHeight\r\n    notes,           # 8  Notes\r\n    materials,       # 9  Material\r\n    rotationmodes,   # 10 RotationMode\r\n    layers,          # 11 Layer\r\n    dwgnames,        # 12 DWGName\r\n    signcodes,       # 13 SignCode\r\n    ifcentities,     # 14 IFCEntity\r\n    categories,      # 15 Category\r\n    normatives,      # 16 Normative\r\n    descriptions,   # 17 Description\r\n    quantities,      # 18 Quantity\r\n    unittimes,       # 19 UnitTime\r\n    unitcosts,       # 20 UnitCost\r\n    totalcosts,      # 21 TotalCost\r\n    warnings         # 22 Warnings\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f3f9b85a333341cfa2863fd9dccadc1e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e23be2b6de5f4c3eae3da2f2335cfa2e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3812387d850a4484aab1290b14f08476",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - Dynamo / Civil 3D\r\nimport re\r\n\r\ndata = IN[0]\r\nSIDE_TARGET = \"LEFT\"  # Cambiar a \"LEFT\" en el nodo del lado izquierdo\r\n\r\n\r\ndef to_number(value):\r\n    \"\"\"Convierte valores numéricos o textos de Excel a float.\"\"\"\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    # Permite leer PK escritos como 6+351.00\r\n    if \"+\" in text:\r\n        text = text.replace(\"+\", \"\")\r\n\r\n    # Convierte coma decimal a punto\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    text = re.sub(r\"[^0-9.\\-]\", \"\", text)\r\n\r\n    try:\r\n        return float(text)\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef norm_side(value):\r\n    \"\"\"Normaliza diferentes formas de escribir LEFT y RIGHT.\"\"\"\r\n    text = str(value).strip().upper()\r\n\r\n    if text in [\"RIGHT\", \"R\", \"DERECHA\", \"DER\", \"D\"]:\r\n        return \"RIGHT\"\r\n\r\n    if text in [\"LEFT\", \"L\", \"IZQUIERDA\", \"IZQ\", \"I\"]:\r\n        return \"LEFT\"\r\n\r\n    return text\r\n\r\n\r\n# ============================================================\r\n# LISTAS DE SALIDA EN EL MISMO ORDEN DE LA HOJA SIGNS\r\n# ============================================================\r\n\r\nids = []             # 0\r\nblocknames = []      # 1\r\nsides = []           # 2\r\npkvalues = []        # 3\r\npklabels = []        # 4\r\noffsets = []         # 5\r\nheights = []         # 6\r\neyeheights = []      # 7\r\nnotes = []           # 8\r\nmaterials = []       # 9\r\nrotationmodes = []   # 10\r\nlayers = []          # 11\r\ndwgnames = []        # 12\r\nsigncodes = []       # 13\r\nifcentities = []     # 14\r\ncategories = []      # 15\r\nnormatives = []      # 16\r\ndescriptions = []    # 17\r\nquantities = []      # 18\r\nunittimes = []       # 19\r\nunitcosts = []       # 20\r\ntotalcosts = []      # 21\r\n\r\nwarnings = []        # 22\r\n\r\n\r\n# ============================================================\r\n# LECTURA Y FILTRADO DE FILAS\r\n# ============================================================\r\n\r\nfor idx, row in enumerate(data):\r\n    excel_row = idx + 2\r\n\r\n    try:\r\n        # La estructura actual requiere al menos 22 columnas\r\n        if row is None or len(row) < 22:\r\n            continue\r\n\r\n        element_id = row[0]\r\n        blockname = row[1]\r\n        side = norm_side(row[2])\r\n        pkvalue = to_number(row[3])\r\n        pklabel = row[4]\r\n        offset = to_number(row[5])\r\n        height = to_number(row[6])\r\n        eyeheight = to_number(row[7])\r\n        note = row[8]\r\n        material = row[9]\r\n        rotationmode = row[10]\r\n        layer = row[11]\r\n        dwgname = row[12]\r\n        signcode = row[13]\r\n        ifcentity = row[14]\r\n        category = row[15]\r\n        normative = row[16]\r\n        description = row[17]\r\n        quantity = to_number(row[18])\r\n        unittime = to_number(row[19])\r\n        unitcost = to_number(row[20])\r\n        totalcost = to_number(row[21])\r\n\r\n        # Ignorar filas sin bloque seleccionado\r\n        if blockname is None or str(blockname).strip() == \"\":\r\n            continue\r\n\r\n        # Separar señales según el lado\r\n        if side != SIDE_TARGET:\r\n            continue\r\n\r\n        # PKValue es el dato utilizado para la geometría\r\n        if pkvalue is None:\r\n            pkvalue = to_number(pklabel)\r\n\r\n        if pkvalue is None:\r\n            warnings.append(\r\n                \"Fila {}: PKValue/PKLabel inválido.\".format(excel_row)\r\n            )\r\n            continue\r\n\r\n        if offset is None:\r\n            warnings.append(\r\n                \"Fila {}: Offset inválido.\".format(excel_row)\r\n            )\r\n            continue\r\n\r\n        # Valores predeterminados\r\n        if quantity is None:\r\n            quantity = 1.0\r\n\r\n        if unittime is None:\r\n            unittime = 0.0\r\n\r\n        if unitcost is None:\r\n            unitcost = 0.0\r\n\r\n        if totalcost is None:\r\n            totalcost = quantity * unitcost\r\n\r\n        # Agregar datos conservando el orden de SIGNS\r\n        ids.append(element_id)\r\n        blocknames.append(blockname)\r\n        sides.append(side)\r\n        pkvalues.append(pkvalue)\r\n        pklabels.append(pklabel)\r\n        offsets.append(offset)\r\n        heights.append(height)\r\n        eyeheights.append(eyeheight)\r\n        notes.append(note)\r\n        materials.append(material)\r\n        rotationmodes.append(rotationmode)\r\n        layers.append(layer)\r\n        dwgnames.append(dwgname)\r\n        signcodes.append(signcode)\r\n        ifcentities.append(ifcentity)\r\n        categories.append(category)\r\n        normatives.append(normative)\r\n        descriptions.append(description)\r\n        quantities.append(quantity)\r\n        unittimes.append(unittime)\r\n        unitcosts.append(unitcost)\r\n        totalcosts.append(totalcost)\r\n\r\n    except Exception as error:\r\n        warnings.append(\r\n            \"Fila {}: {}\".format(excel_row, str(error))\r\n        )\r\n\r\n\r\n# ============================================================\r\n# SALIDAS\r\n# ============================================================\r\n\r\nOUT = (\r\n    ids,             # 0  ID\r\n    blocknames,      # 1  BlockName\r\n    sides,           # 2  Side\r\n    pkvalues,        # 3  PKValue / Station\r\n    pklabels,        # 4  PKLabel\r\n    offsets,         # 5  Offset\r\n    heights,         # 6  Height\r\n    eyeheights,      # 7  EyeHeight\r\n    notes,           # 8  Notes\r\n    materials,       # 9  Material\r\n    rotationmodes,   # 10 RotationMode\r\n    layers,          # 11 Layer\r\n    dwgnames,        # 12 DWGName\r\n    signcodes,       # 13 SignCode\r\n    ifcentities,     # 14 IFCEntity\r\n    categories,      # 15 Category\r\n    normatives,      # 16 Normative\r\n    descriptions,   # 17 Description\r\n    quantities,      # 18 Quantity\r\n    unittimes,       # 19 UnitTime\r\n    unitcosts,       # 20 UnitCost\r\n    totalcosts,      # 21 TotalCost\r\n    warnings         # 22 Warnings\r\n)",
