      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "/*\nFUNCION PARA AÑADIR PROPIEDADES\n*/\ndef setProp(obj, pset, prop, val)\n{\n    return = CivilObject.UpdateProperty(obj, pset, prop, val);\n};\n\n// DERECHA\nd01 = setProp(obj_der, conjunto, \"ID\", id_d);\nd02 = setProp(obj_der, conjunto, \"Block\", blockname_d);\nd03 = setProp(obj_der, conjunto, \"Side\", side_d);\nd04 = setProp(obj_der, conjunto, \"PKValue\", pkvalue_d);\nd05 = setProp(obj_der, conjunto, \"PKLabel\", pklabel_d);\nd06 = setProp(obj_der, conjunto, \"Offset\", offset_d);\nd07 = setProp(obj_der, conjunto, \"Height\", height_d);\nd08 = setProp(obj_der, conjunto, \"EyeHeight\", eyeheight_d);\nd09 = setProp(obj_der, conjunto, \"Notes\", notes_d);\nd10 = setProp(obj_der, conjunto, \"Material\", material_d);\nd11 = setProp(obj_der, conjunto, \"RotationMode\", rotationmode_d);\nd12 = setProp(obj_der, conjunto, \"Layer\", layer_d);\nd13 = setProp(obj_der, conjunto, \"DWGName\", dwgname_d);\nd14 = setProp(obj_der, conjunto, \"SignalCode\", signcode_d);\nd15 = setProp(obj_der, conjunto, \"IFCEntity\", ifcentity_d);\nd16 = setProp(obj_der, conjunto, \"Category\", category_d);\nd17 = setProp(obj_der, conjunto, \"Normative\", normative_d);\nd18 = setProp(obj_der, conjunto, \"Description\", description_d);\nd19 = setProp(obj_der, conjunto, \"Quantity\", quantity_d);\nd20 = setProp(obj_der, conjunto, \"TimeUnit(h)\", unittime_d);\nd21 = setProp(obj_der, conjunto, \"CostUnit\", unitcost_d);\nd22 = setProp(obj_der, conjunto, \"TotalCost\", totalcost_d);\n\n\nd23 = setProp(obj_der, conjunto, \"CoordinateX\", coordx_d);\nd24 = setProp(obj_der, conjunto, \"CoordinateY\", coordy_d);\nd25 = setProp(obj_der, conjunto, \"CoordinateZ\", coordz_d);\nd26 = setProp(obj_der, conjunto, \"Elevation\", elevation_d);\nd27 = setProp(obj_der, conjunto, \"Alignment\", alignment_d);\n\n// IZQUIERDA\ni01 = setProp(obj_izq, conjunto, \"ID\", id_i);\ni02 = setProp(obj_izq, conjunto, \"Block\", blockname_i);\ni03 = setProp(obj_izq, conjunto, \"Side\", side_i);\ni04 = setProp(obj_izq, conjunto, \"PKValue\", pkvalue_i);\ni05 = setProp(obj_izq, conjunto, \"PKLabel\", pklabel_i);\ni06 = setProp(obj_izq, conjunto, \"Offset\", offset_i);\ni07 = setProp(obj_izq, conjunto, \"Height\", height_i);\ni08 = setProp(obj_izq, conjunto, \"EyeHeight\", eyeheight_i);\ni09 = setProp(obj_izq, conjunto, \"Notes\", notes_i);\ni10 = setProp(obj_izq, conjunto, \"Material\", material_i);\ni11 = setProp(obj_izq, conjunto, \"RotationMode\", rotationmode_i);\ni12 = setProp(obj_izq, conjunto, \"Layer\", layer_i);\ni13 = setProp(obj_izq, conjunto, \"DWGName\", dwgname_i);\ni14 = setProp(obj_izq, conjunto, \"SignalCode\", signcode_i);\ni15 = setProp(obj_izq, conjunto, \"IFCEntity\", ifcentity_i);\ni16 = setProp(obj_izq, conjunto, \"Category\", category_i);\ni17 = setProp(obj_izq, conjunto, \"Normative\", normative_i);\ni18 = setProp(obj_izq, conjunto, \"Description\", description_i);\ni19 = setProp(obj_izq, conjunto, \"Quantity\", quantity_i);\ni20 = setProp(obj_izq, conjunto, \"TimeUnit(h)\", unittime_i);\ni21 = setProp(obj_izq, conjunto, \"CostUnit\", unitcost_i);\ni22 = setProp(obj_izq, conjunto, \"TotalCost\", totalcost_i);\n\n\ni23 = setProp(obj_izq, conjunto, \"CoordinateX\", coordx_i);\ni24 = setProp(obj_izq, conjunto, \"CoordinateY\", coordy_i);\ni25 = setProp(obj_izq, conjunto, \"CoordinateZ\", coordz_i);\ni26 = setProp(obj_izq, conjunto, \"Elevation\", elevation_i);\ni27 = setProp(obj_izq, conjunto, \"Alignment\", alignment_i);"
    },
