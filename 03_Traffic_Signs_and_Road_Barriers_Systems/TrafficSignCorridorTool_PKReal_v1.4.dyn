    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - Dynamo / Civil 3D\r\n# Loads external DWG files as block definitions in the active drawing.\r\n#\r\n# IN[0] = User-selected DWG library folder\r\n# IN[1] = Complete Excel table imported from the SIGNS worksheet\r\n#\r\n# OUT[0] = Block definitions loaded from DWG files\r\n# OUT[1] = Block definitions already existing in the active drawing\r\n# OUT[2] = Missing DWG files\r\n# OUT[3] = Errors and warnings\r\n# OUT[4] = Excel table passed to the next node\r\n# OUT[5] = General status: True when all required blocks are available\r\n\r\nimport clr\r\nimport os\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    Database,\r\n    OpenMode,\r\n    FileOpenMode\r\n)\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef clean_text(value):\r\n    \"\"\"Converts Dynamo, Excel, or Directory Path values to clean text.\"\"\"\r\n    if value is None:\r\n        return \"\"\r\n\r\n    # Directory Path nodes may return a DirectoryInfo object\r\n    if hasattr(value, \"FullName\"):\r\n        return str(value.FullName).strip()\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef ensure_rows(value):\r\n    \"\"\"Ensures that the Excel input is represented as a list of rows.\"\"\"\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        return list(value)\r\n\r\n    return [value]\r\n\r\n\r\ndef block_exists(database, block_name):\r\n    \"\"\"Checks whether a block definition already exists in the active DWG.\"\"\"\r\n    transaction = database.TransactionManager.StartTransaction()\r\n\r\n    try:\r\n        block_table = transaction.GetObject(\r\n            database.BlockTableId,\r\n            OpenMode.ForRead\r\n        )\r\n\r\n        exists = block_table.Has(block_name)\r\n        transaction.Commit()\r\n\r\n        return exists\r\n\r\n    except Exception:\r\n        transaction.Abort()\r\n        raise\r\n\r\n    finally:\r\n        transaction.Dispose()\r\n\r\n\r\ndef find_header_index(header, possible_names):\r\n    \"\"\"\r\n    Finds a column index from a list of possible header names.\r\n    Spaces and uppercase/lowercase differences are ignored.\r\n    \"\"\"\r\n    normalized_headers = {}\r\n\r\n    for index, value in enumerate(header):\r\n        key = clean_text(value).replace(\" \", \"\").lower()\r\n        normalized_headers[key] = index\r\n\r\n    for name in possible_names:\r\n        key = clean_text(name).replace(\" \", \"\").lower()\r\n\r\n        if key in normalized_headers:\r\n            return normalized_headers[key]\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nlibrary_folder = clean_text(IN[0])\r\nexcel_data = ensure_rows(IN[1])\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\nloaded_blocks = []\r\nexisting_blocks = []\r\nmissing_files = []\r\nerrors = []\r\n\r\n# Prevents repeated processing of the same block type\r\nchecked_blocks = set()\r\n\r\n\r\n# ============================================================\r\n# INITIAL VALIDATION\r\n# ============================================================\r\n\r\nif library_folder == \"\":\r\n    errors.append(\"No DWG library folder was selected.\")\r\n\r\nelif not os.path.isdir(library_folder):\r\n    errors.append(\r\n        \"The selected DWG library folder does not exist: {}\"\r\n        .format(library_folder)\r\n    )\r\n\r\nelif len(excel_data) == 0:\r\n    errors.append(\"The imported Excel table is empty.\")\r\n\r\n\r\n# ============================================================\r\n# COLUMN IDENTIFICATION\r\n# ============================================================\r\n\r\n# Default positions in the current SIGNS worksheet:\r\n# Column B = BlockName = index 1\r\n# Column M = DWGName   = index 12\r\n\r\nblock_index = 1\r\ndwg_index = 12\r\nfirst_data_row = 0\r\n\r\nif len(excel_data) > 0:\r\n    first_row = excel_data[0]\r\n\r\n    if isinstance(first_row, (list, tuple)):\r\n        detected_block_index = find_header_index(\r\n            first_row,\r\n            [\"BlockName\", \"Block\"]\r\n        )\r\n\r\n        detected_dwg_index = find_header_index(\r\n            first_row,\r\n            [\"DWGName\", \"DWGFile\"]\r\n        )\r\n\r\n        # If headers are included in the imported range, use their positions\r\n        if (\r\n            detected_block_index is not None\r\n            and detected_dwg_index is not None\r\n        ):\r\n            block_index = detected_block_index\r\n            dwg_index = detected_dwg_index\r\n            first_data_row = 1\r\n\r\n\r\n# ============================================================\r\n# LOAD EXTERNAL DWG FILES AS BLOCK DEFINITIONS\r\n# ============================================================\r\n\r\nif len(errors) == 0:\r\n\r\n    document = Application.DocumentManager.MdiActiveDocument\r\n\r\n    if document is None:\r\n        errors.append(\"No active Civil 3D document was found.\")\r\n\r\n    else:\r\n        current_database = document.Database\r\n\r\n        try:\r\n            with document.LockDocument():\r\n\r\n                data_rows = excel_data[first_data_row:]\r\n\r\n                for local_index, row in enumerate(data_rows):\r\n                    excel_row_number = (\r\n                        local_index + first_data_row + 1\r\n                    )\r\n\r\n                    try:\r\n                        if row is None:\r\n                            continue\r\n\r\n                        if not isinstance(row, (list, tuple)):\r\n                            errors.append(\r\n                                \"Row {}: The imported value is not a valid row.\"\r\n                                .format(excel_row_number)\r\n                            )\r\n                            continue\r\n\r\n                        required_length = max(\r\n                            block_index,\r\n                            dwg_index\r\n                        ) + 1\r\n\r\n                        if len(row) < required_length:\r\n                            errors.append(\r\n                                \"Row {}: Required columns are missing.\"\r\n                                .format(excel_row_number)\r\n                            )\r\n                            continue\r\n\r\n                        block_name = clean_text(row[block_index])\r\n                        dwg_name = clean_text(row[dwg_index])\r\n\r\n                        # Ignore completely empty table rows\r\n                        if block_name == \"\" and dwg_name == \"\":\r\n                            continue\r\n\r\n                        if block_name == \"\":\r\n                            errors.append(\r\n                                \"Row {}: BlockName is empty.\"\r\n                                .format(excel_row_number)\r\n                            )\r\n                            continue\r\n\r\n                        if dwg_name == \"\":\r\n                            errors.append(\r\n                                \"Row {}: DWGName is empty for block '{}'.\"\r\n                                .format(\r\n                                    excel_row_number,\r\n                                    block_name\r\n                                )\r\n                            )\r\n                            continue\r\n\r\n                        block_key = block_name.lower()\r\n\r\n                        # Avoid processing repeated signal types\r\n                        if block_key in checked_blocks:\r\n                            continue\r\n\r\n                        checked_blocks.add(block_key)\r\n\r\n                        # ------------------------------------------------\r\n                        # 1. Check whether the block already exists\r\n                        # ------------------------------------------------\r\n\r\n                        if block_exists(\r\n                            current_database,\r\n                            block_name\r\n                        ):\r\n                            existing_blocks.append(block_name)\r\n                            continue\r\n\r\n                        # ------------------------------------------------\r\n                        # 2. Build the complete DWG file path\r\n                        # ------------------------------------------------\r\n\r\n                        full_path = os.path.normpath(\r\n                            os.path.join(\r\n                                library_folder,\r\n                                dwg_name\r\n                            )\r\n                        )\r\n\r\n                        # ------------------------------------------------\r\n                        # 3. Verify that the DWG file exists\r\n                        # ------------------------------------------------\r\n\r\n                        if not os.path.isfile(full_path):\r\n                            missing_files.append(\r\n                                \"{} -> {}\".format(\r\n                                    block_name,\r\n                                    full_path\r\n                                )\r\n                            )\r\n                            continue\r\n\r\n                        # ------------------------------------------------\r\n                        # 4. Read the external DWG\r\n                        # ------------------------------------------------\r\n\r\n                        source_database = Database(False, True)\r\n\r\n                        try:\r\n                            source_database.ReadDwgFile(\r\n                                full_path,\r\n                                FileOpenMode.OpenForReadAndAllShare,\r\n                                True,\r\n                                \"\"\r\n                            )\r\n\r\n                            source_database.CloseInput(True)\r\n\r\n                            # --------------------------------------------\r\n                            # 5. Register the external DWG as a block\r\n                            #    definition using BlockName from Excel\r\n                            # --------------------------------------------\r\n\r\n                            current_database.Insert(\r\n                                block_name,\r\n                                source_database,\r\n                                False\r\n                            )\r\n\r\n                            loaded_blocks.append(block_name)\r\n\r\n                        finally:\r\n                            source_database.Dispose()\r\n\r\n                    except Exception as row_error:\r\n                        error_text = str(row_error)\r\n\r\n                        if \"eSelfReference\" in error_text:\r\n                            errors.append(\r\n                                \"Row {}: '{}' contains a self-referenced \"\r\n                                \"block definition. Open the DWG file, explode \"\r\n                                \"all nested block references until only Model \"\r\n                                \"Space entities remain, run PURGE, save the \"\r\n                                \"file, and try again.\"\r\n                                .format(\r\n                                    excel_row_number,\r\n                                    dwg_name\r\n                                )\r\n                            )\r\n\r\n                        else:\r\n                            errors.append(\r\n                                \"Row {}: {}\"\r\n                                .format(\r\n                                    excel_row_number,\r\n                                    error_text\r\n                                )\r\n                            )\r\n\r\n            # Regenerate Civil 3D after loading the definitions\r\n            try:\r\n                document.Editor.Regen()\r\n            except Exception:\r\n                pass\r\n\r\n        except Exception as general_error:\r\n            errors.append(\r\n                \"Unexpected error while loading block definitions: {}\"\r\n                .format(str(general_error))\r\n            )\r\n\r\n\r\n# ============================================================\r\n# FINAL AVAILABILITY CHECK\r\n# ============================================================\r\n\r\n# A valid run requires:\r\n# - no missing DWG files;\r\n# - no loading errors.\r\n\r\nall_ready = (\r\n    len(missing_files) == 0\r\n    and len(errors) == 0\r\n)\r\n\r\n# Only pass the Excel table to the next node when all required\r\n# block definitions are available.\r\nif all_ready:\r\n    data_passthrough = excel_data\r\nelse:\r\n    data_passthrough = []\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    loaded_blocks,      # 0 - Newly loaded block definitions\r\n    existing_blocks,    # 1 - Blocks already present in the active DWG\r\n    missing_files,      # 2 - DWG files not found\r\n    errors,             # 3 - Errors and diagnostic messages\r\n    data_passthrough,   # 4 - Excel data for VALIDATE_PK_WITH_CORRIDOR\r\n    all_ready           # 5 - True when all required blocks are available\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7a079b2598f44021a2994adb45431fbb",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "5a7f238f88fa4b188fd4b98f9302fc5b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "63fc4311f1844d0eb2a358942f9b72a4",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "29679f5c8fcc4ef59e71c693b93a0557",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
