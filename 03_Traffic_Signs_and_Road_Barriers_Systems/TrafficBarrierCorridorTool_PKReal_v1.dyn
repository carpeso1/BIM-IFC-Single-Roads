    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# PREPARE_BARRIER_PSET_DATA\r\n# CPython3 - Dynamo / Civil 3D\r\n#\r\n# IN[0] = Inserted POST objects metadata\r\n# IN[1] = Inserted LINEAR objects metadata\r\n# IN[2] = Validated BARRIERS data\r\n#\r\n# OUT[0] = POST PropertySet data\r\n# OUT[1] = LINEAR PropertySet data\r\n# OUT[2] = Warnings\r\n# OUT[3] = Summary\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\npost_inserted_input = IN[0]\r\nlinear_inserted_input = IN[1]\r\nbarrier_data_input = IN[2]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n\r\n        result = []\r\n\r\n        for item in value:\r\n\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef to_number(value, default=0.0):\r\n\r\n    if value is None:\r\n        return default\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    try:\r\n\r\n        text = str(value).strip().replace(\",\", \".\")\r\n        return float(text)\r\n\r\n    except:\r\n        return default\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUT LISTS\r\n# ============================================================\r\n\r\npost_inserted = as_list(\r\n    post_inserted_input\r\n)\r\n\r\nlinear_inserted = as_list(\r\n    linear_inserted_input\r\n)\r\n\r\nbarrier_data = as_list(\r\n    barrier_data_input\r\n)\r\n\r\n\r\n# ============================================================\r\n# BUILD LOOKUP BY BARRIER ID\r\n#\r\n# Example:\r\n# B001 → original BARRIERS record\r\n# ============================================================\r\n\r\nbarrier_lookup = {}\r\n\r\n\r\nfor item in barrier_data:\r\n\r\n    barrier_id = clean_text(\r\n        get_value(\r\n            item,\r\n            \"ID\"\r\n        )\r\n    )\r\n\r\n    if barrier_id == \"\":\r\n        continue\r\n\r\n    barrier_lookup[\r\n        barrier_id\r\n    ] = item\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\npost_pset_data = []\r\nlinear_pset_data = []\r\n\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# CREATE PROPERTY SET RECORD\r\n# ============================================================\r\n\r\ndef build_pset_record(\r\n    inserted,\r\n    component_type\r\n):\r\n\r\n    parent_id = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"ParentID\"\r\n        )\r\n    )\r\n\r\n    segment_id = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"ID\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FIND ORIGINAL BARRIER RECORD\r\n    # --------------------------------------------------------\r\n\r\n    source = barrier_lookup.get(\r\n        parent_id\r\n    )\r\n\r\n\r\n    if source is None:\r\n\r\n        warnings.append(\r\n            \"{} object | ParentID '{}': \"\r\n            \"original BARRIERS record not found.\"\r\n            .format(\r\n                component_type,\r\n                parent_id\r\n            )\r\n        )\r\n\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # INSERTED OBJECT INFORMATION\r\n    # --------------------------------------------------------\r\n\r\n    handle = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"Handle\"\r\n        )\r\n    )\r\n\r\n    object_id = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"ObjectId\"\r\n        )\r\n    )\r\n\r\n    station = to_number(\r\n        get_value(\r\n            inserted,\r\n            \"Station\"\r\n        )\r\n    )\r\n\r\n    side = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"Side\"\r\n        )\r\n    )\r\n\r\n    block_name = clean_text(\r\n        get_value(\r\n            inserted,\r\n            \"BlockName\"\r\n        )\r\n    )\r\n\r\n    x = to_number(\r\n        get_value(\r\n            inserted,\r\n            \"X\"\r\n        )\r\n    )\r\n\r\n    y = to_number(\r\n        get_value(\r\n            inserted,\r\n            \"Y\"\r\n        )\r\n    )\r\n\r\n    z = to_number(\r\n        get_value(\r\n            inserted,\r\n            \"Z\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ORIGINAL BARRIER DATA\r\n    # --------------------------------------------------------\r\n\r\n    barrier_family = clean_text(\r\n        get_value(\r\n            source,\r\n            \"BarrierFamily\"\r\n        )\r\n    )\r\n\r\n    barrier_type = clean_text(\r\n        get_value(\r\n            source,\r\n            \"BarrierType\"\r\n        )\r\n    )\r\n\r\n    material = clean_text(\r\n        get_value(\r\n            source,\r\n            \"Material\"\r\n        )\r\n    )\r\n\r\n    layer = clean_text(\r\n        get_value(\r\n            source,\r\n            \"Layer\"\r\n        )\r\n    )\r\n\r\n    containment_level = clean_text(\r\n        get_value(\r\n            source,\r\n            \"ContainmentLevel\"\r\n        )\r\n    )\r\n\r\n    working_width = clean_text(\r\n        get_value(\r\n            source,\r\n            \"WorkingWidth\"\r\n        )\r\n    )\r\n\r\n    notes = clean_text(\r\n        get_value(\r\n            source,\r\n            \"Notes\"\r\n        )\r\n    )\r\n\r\n    pk_start_value = to_number(\r\n        get_value(\r\n            source,\r\n            \"PKStartValue\"\r\n        )\r\n    )\r\n\r\n    pk_end_value = to_number(\r\n        get_value(\r\n            source,\r\n            \"PKEndValue\"\r\n        )\r\n    )\r\n\r\n    pk_start_label = clean_text(\r\n        get_value(\r\n            source,\r\n            \"PKStartLabel\"\r\n        )\r\n    )\r\n\r\n    pk_end_label = clean_text(\r\n        get_value(\r\n            source,\r\n            \"PKEndLabel\"\r\n        )\r\n    )\r\n\r\n    offset = to_number(\r\n        get_value(\r\n            source,\r\n            \"DefaultOffset\"\r\n        )\r\n    )\r\n\r\n    height = to_number(\r\n        get_value(\r\n            source,\r\n            \"Height\"\r\n        )\r\n    )\r\n\r\n    width = to_number(\r\n        get_value(\r\n            source,\r\n            \"Width\"\r\n        )\r\n    )\r\n\r\n    post_spacing = to_number(\r\n        get_value(\r\n            source,\r\n            \"PostSpacing\"\r\n        )\r\n    )\r\n\r\n    module_length = to_number(\r\n        get_value(\r\n            source,\r\n            \"ModuleLength\"\r\n        )\r\n    )\r\n\r\n    time_unit_length = to_number(\r\n        get_value(\r\n            source,\r\n            \"TimeUnitLength(h)\"\r\n        )\r\n    )\r\n\r\n    cost_unit_length = to_number(\r\n        get_value(\r\n            source,\r\n            \"CostUnitLength\"\r\n        )\r\n    )\r\n\r\n    ifc_entity = clean_text(\r\n        get_value(\r\n            source,\r\n            \"IFCEntity\"\r\n        )\r\n    )\r\n\r\n    type_code = clean_text(\r\n        get_value(\r\n            source,\r\n            \"Type\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DERIVED VALUES\r\n    # --------------------------------------------------------\r\n\r\n    segment_length = max(\r\n        0.0,\r\n        pk_end_value - pk_start_value\r\n    )\r\n\r\n\r\n    cost_segment = (\r\n        cost_unit_length\r\n        * segment_length\r\n    )\r\n\r\n\r\n    time_segment = (\r\n        time_unit_length\r\n        * segment_length\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COMMON PROPERTY SET DATA\r\n    # --------------------------------------------------------\r\n\r\n    record = {\r\n\r\n        # --------------------------------------------\r\n        # OBJECT IDENTIFICATION\r\n        # --------------------------------------------\r\n\r\n        \"Handle\":\r\n            handle,\r\n\r\n        \"ObjectId\":\r\n            object_id,\r\n\r\n        \"ComponentType\":\r\n            component_type,\r\n\r\n        \"ParentID\":\r\n            parent_id,\r\n\r\n        \"ID\":\r\n            segment_id,\r\n\r\n        \"Type\":\r\n            type_code,\r\n\r\n        \"Side\":\r\n            side,\r\n\r\n        \"Block\":\r\n            block_name,\r\n\r\n        \"IFCEntity\":\r\n            ifc_entity,\r\n\r\n\r\n        # --------------------------------------------\r\n        # BARRIER INFORMATION\r\n        # --------------------------------------------\r\n\r\n        \"BarrierFamily\":\r\n            barrier_family,\r\n\r\n        \"BarrierType\":\r\n            barrier_type,\r\n\r\n        \"Material\":\r\n            material,\r\n\r\n        \"Layer\":\r\n            layer,\r\n\r\n        \"ContainmentLevel\":\r\n            containment_level,\r\n\r\n        \"WorkingWidth\":\r\n            working_width,\r\n\r\n        \"Notes\":\r\n            notes,\r\n\r\n\r\n        # --------------------------------------------\r\n        # ALIGNMENT / STATION INFORMATION\r\n        # --------------------------------------------\r\n\r\n        \"Station\":\r\n            station,\r\n\r\n        \"PKStartValue\":\r\n            pk_start_value,\r\n\r\n        \"PKEndValue\":\r\n            pk_end_value,\r\n\r\n        \"PKStartLabel\":\r\n            pk_start_label,\r\n\r\n        \"PKEndLabel\":\r\n            pk_end_label,\r\n\r\n        \"Offset\":\r\n            offset,\r\n\r\n\r\n        # --------------------------------------------\r\n        # COORDINATES\r\n        # --------------------------------------------\r\n\r\n        \"CoordinateX\":\r\n            x,\r\n\r\n        \"CoordinateY\":\r\n            y,\r\n\r\n        \"CoordinateZ\":\r\n            z,\r\n\r\n        \"Elevation\":\r\n            z,\r\n\r\n\r\n        # --------------------------------------------\r\n        # GEOMETRY\r\n        # --------------------------------------------\r\n\r\n        \"Height\":\r\n            height,\r\n\r\n        \"Width\":\r\n            width,\r\n\r\n        \"PostSpacing\":\r\n            post_spacing,\r\n\r\n        \"ModuleLength\":\r\n            module_length,\r\n\r\n\r\n        # --------------------------------------------\r\n        # 4D / 5D\r\n        # --------------------------------------------\r\n\r\n        \"TimeUnitLength(h)\":\r\n            time_unit_length,\r\n\r\n        \"CostUnitLength\":\r\n            cost_unit_length,\r\n\r\n        \"TimeSegment(h)\":\r\n            time_segment,\r\n\r\n        \"CostSegment\":\r\n            cost_segment,\r\n\r\n\r\n        # --------------------------------------------\r\n        # GUID\r\n        #\r\n        # Left empty for now.\r\n        # We can populate it later when IFC/ObjectGUID\r\n        # generation is implemented.\r\n        # --------------------------------------------\r\n\r\n        \"ObjectGUID\":\r\n            \"\"\r\n    }\r\n\r\n\r\n    return record\r\n\r\n\r\n# ============================================================\r\n# POSTS\r\n# ============================================================\r\n\r\nfor item in post_inserted:\r\n\r\n    record = build_pset_record(\r\n        item,\r\n        \"POST\"\r\n    )\r\n\r\n    if record is not None:\r\n\r\n        post_pset_data.append(\r\n            record\r\n        )\r\n\r\n\r\n# ============================================================\r\n# LINEAR MODULES\r\n# ============================================================\r\n\r\nfor item in linear_inserted:\r\n\r\n    record = build_pset_record(\r\n        item,\r\n        \"LINEAR\"\r\n    )\r\n\r\n    if record is not None:\r\n\r\n        linear_pset_data.append(\r\n            record\r\n        )\r\n\r\n\r\n# ============================================================\r\n# SUMMARY\r\n# ============================================================\r\n\r\nsummary = {\r\n\r\n    \"PostInsertedInput\":\r\n        len(post_inserted),\r\n\r\n    \"PostPsetRecords\":\r\n        len(post_pset_data),\r\n\r\n    \"LinearInsertedInput\":\r\n        len(linear_inserted),\r\n\r\n    \"LinearPsetRecords\":\r\n        len(linear_pset_data),\r\n\r\n    \"BarrierRecords\":\r\n        len(barrier_data),\r\n\r\n    \"WarningCount\":\r\n        len(warnings)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    post_pset_data,       # 0\r\n    linear_pset_data,     # 1\r\n    warnings,             # 2\r\n    summary               # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "83a7c48a35914fdca73bf7bb14b9ae36",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "4f83e4d1296a4fe5ba39854afecdf4c0",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1697d5368b9349c2aff8ca232b31962a",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "83f33218a5af47fa9c692d468b31665c",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
