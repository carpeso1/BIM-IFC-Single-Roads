    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# ASSIGN_BARRIER_PROPERTYSET_V4\r\n# CPython3 - Civil 3D / AEC Property Data\r\n#\r\n# IN[0] = Prepared PsetData\r\n# IN[1] = Property Set Definition Name\r\n#\r\n# OUT[0] = Assigned objects\r\n# OUT[1] = Errors\r\n# OUT[2] = Summary\r\n# ============================================================\r\n\r\nimport clr\r\n\r\n# ============================================================\r\n# REFERENCES\r\n# ============================================================\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\n\r\nclr.AddReference(\"AecBaseMgd\")\r\nclr.AddReference(\"AecPropDataMgd\")\r\n\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\n\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    OpenMode,\r\n    Handle\r\n)\r\n\r\nfrom Autodesk.Aec.PropertyData.DatabaseServices import (\r\n    PropertyDataServices,\r\n    DictionaryPropertySetDefinitions\r\n)\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ndata_input = IN[0]\r\npset_name_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# BASIC HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        return list(value)\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# HANDLE → OBJECT ID\r\n# ============================================================\r\n\r\ndef get_object_id_from_handle(\r\n    database,\r\n    handle_text\r\n):\r\n\r\n    try:\r\n\r\n        handle_number = int(\r\n            str(handle_text),\r\n            16\r\n        )\r\n\r\n        acad_handle = Handle(\r\n            handle_number\r\n        )\r\n\r\n        return database.GetObjectId(\r\n            False,\r\n            acad_handle,\r\n            0\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# GET PROPERTY SET DEFINITION\r\n#\r\n# IMPORTANT:\r\n# We do NOT use .Has().\r\n# We ask directly for GetAt(name).\r\n# ============================================================\r\n\r\ndef get_pset_definition_id(\r\n    database,\r\n    definition_name\r\n):\r\n\r\n    try:\r\n\r\n        definitions = (\r\n            DictionaryPropertySetDefinitions(\r\n                database\r\n            )\r\n        )\r\n\r\n        definition_id = definitions.GetAt(\r\n            definition_name\r\n        )\r\n\r\n        return definition_id\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# FIND ATTACHED PROPERTY SET\r\n# ============================================================\r\n\r\ndef find_attached_pset(\r\n    db_object,\r\n    definition_id,\r\n    transaction\r\n):\r\n\r\n    try:\r\n\r\n        pset_ids = (\r\n            PropertyDataServices\r\n            .GetPropertySets(\r\n                db_object\r\n            )\r\n        )\r\n\r\n        for pset_id in pset_ids:\r\n\r\n            try:\r\n\r\n                pset = transaction.GetObject(\r\n                    pset_id,\r\n                    OpenMode.ForRead\r\n                )\r\n\r\n                if (\r\n                    pset.PropertySetDefinition\r\n                    == definition_id\r\n                ):\r\n\r\n                    return pset_id\r\n\r\n            except:\r\n                pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# SET PROPERTY\r\n# ============================================================\r\n\r\ndef set_property(\r\n    pset,\r\n    property_name,\r\n    value\r\n):\r\n\r\n    if value is None:\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PROPERTY NAME → PROPERTY ID\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        property_id = (\r\n            pset.PropertyNameToId(\r\n                property_name\r\n            )\r\n        )\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        if property_id < 0:\r\n            return False\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DATA TYPE\r\n    # --------------------------------------------------------\r\n\r\n    if isinstance(value, bool):\r\n\r\n        final_value = value\r\n\r\n    elif isinstance(\r\n        value,\r\n        (int, float)\r\n    ):\r\n\r\n        final_value = float(value)\r\n\r\n    else:\r\n\r\n        final_value = str(value)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # WRITE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        pset.SetAt(\r\n            property_id,\r\n            final_value\r\n        )\r\n\r\n        return True\r\n\r\n    except:\r\n\r\n        # Some AEC properties are picky about datatype.\r\n        try:\r\n\r\n            pset.SetAt(\r\n                property_id,\r\n                str(final_value)\r\n            )\r\n\r\n            return True\r\n\r\n        except:\r\n\r\n            return False\r\n\r\n\r\n# ============================================================\r\n# PREPARE\r\n# ============================================================\r\n\r\nrecords = as_list(\r\n    data_input\r\n)\r\n\r\npset_name = clean_text(\r\n    pset_name_input\r\n)\r\n\r\nassigned = []\r\nerrors = []\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = (\r\n    Application\r\n    .DocumentManager\r\n    .MdiActiveDocument\r\n)\r\n\r\ndb = doc.Database\r\n\r\ndoc_lock = None\r\ntransaction = None\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    # --------------------------------------------------------\r\n    # LOCK DOCUMENT\r\n    # --------------------------------------------------------\r\n\r\n    doc_lock = doc.LockDocument()\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TRANSACTION\r\n    # --------------------------------------------------------\r\n\r\n    transaction = (\r\n        db.TransactionManager\r\n        .StartTransaction()\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FIND PSET DEFINITION\r\n    # ========================================================\r\n\r\n    definition_id = (\r\n        get_pset_definition_id(\r\n            db,\r\n            pset_name\r\n        )\r\n    )\r\n\r\n\r\n    if definition_id is None:\r\n\r\n        raise Exception(\r\n            \"Property Set Definition '{}' could not be resolved.\"\r\n            .format(\r\n                pset_name\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS OBJECTS\r\n    # ========================================================\r\n\r\n    for index, record in enumerate(records):\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # HANDLE\r\n        # ----------------------------------------------------\r\n\r\n        handle_text = clean_text(\r\n            get_value(\r\n                record,\r\n                \"Handle\"\r\n            )\r\n        )\r\n\r\n\r\n        if handle_text == \"\":\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Reason\":\r\n                    \"Handle is empty\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # HANDLE → OBJECT ID\r\n        # ----------------------------------------------------\r\n\r\n        object_id = (\r\n            get_object_id_from_handle(\r\n                db,\r\n                handle_text\r\n            )\r\n        )\r\n\r\n\r\n        if object_id is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Could not resolve ObjectId from Handle\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OPEN BLOCKREFERENCE / AUTOCAD OBJECT\r\n        # ----------------------------------------------------\r\n\r\n        try:\r\n\r\n            db_object = transaction.GetObject(\r\n                object_id,\r\n                OpenMode.ForWrite\r\n            )\r\n\r\n        except Exception as ex:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Could not open AutoCAD object\",\r\n\r\n                \"Detail\":\r\n                    str(ex)\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # CHECK IF PSET ALREADY EXISTS\r\n        # ====================================================\r\n\r\n        pset_id = (\r\n            find_attached_pset(\r\n                db_object,\r\n                definition_id,\r\n                transaction\r\n            )\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # ATTACH PSET IF NECESSARY\r\n        # ====================================================\r\n\r\n        if pset_id is None:\r\n\r\n            try:\r\n\r\n                PropertyDataServices.AddPropertySet(\r\n                    db_object,\r\n                    definition_id\r\n                )\r\n\r\n            except Exception as ex:\r\n\r\n                errors.append({\r\n\r\n                    \"Index\":\r\n                        index,\r\n\r\n                    \"Handle\":\r\n                        handle_text,\r\n\r\n                    \"Reason\":\r\n                        \"Could not attach Property Set\",\r\n\r\n                    \"Detail\":\r\n                        str(ex)\r\n                })\r\n\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # FIND NEWLY ATTACHED PSET\r\n            # ------------------------------------------------\r\n\r\n            pset_id = (\r\n                find_attached_pset(\r\n                    db_object,\r\n                    definition_id,\r\n                    transaction\r\n                )\r\n            )\r\n\r\n\r\n        if pset_id is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Pset was not found after AddPropertySet\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # OPEN PSET FOR WRITE\r\n        # ====================================================\r\n\r\n        pset = transaction.GetObject(\r\n            pset_id,\r\n            OpenMode.ForWrite\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # COMMON PROPERTIES\r\n        # ====================================================\r\n\r\n        properties_to_write = {\r\n\r\n            \"ParentID\":\r\n                get_value(record, \"ParentID\"),\r\n\r\n            \"ID\":\r\n                get_value(record, \"ID\"),\r\n               \r\n            \"Type\":\r\n                get_value(record, \"Type\"),\r\n\r\n            \"BarrierFamily\":\r\n                get_value(record, \"BarrierFamily\"),\r\n            \r\n            \"IfcEntity\":\r\n                get_value(record, \"IFCEntity\"),\r\n\r\n            \"BarrierType\":\r\n                get_value(record, \"BarrierType\"),\r\n\r\n            \"Block\":\r\n                get_value(record, \"Block\"),\r\n\r\n            \"Side\":\r\n                get_value(record, \"Side\"),\r\n\r\n            \"PKStartValue\":\r\n                get_value(record, \"PKStartValue\"),\r\n\r\n            \"PKEndValue\":\r\n                get_value(record, \"PKEndValue\"),\r\n\r\n            \"PKStartLabel\":\r\n                get_value(record, \"PKStartLabel\"),\r\n\r\n            \"PKEndLabel\":\r\n                get_value(record, \"PKEndLabel\"),\r\n\r\n            \"Offset\":\r\n                get_value(record, \"Offset\"),\r\n\r\n            \"CoordinateX\":\r\n                get_value(record, \"CoordinateX\"),\r\n\r\n            \"CoordinateY\":\r\n                get_value(record, \"CoordinateY\"),\r\n\r\n            \"CoordinateZ\":\r\n                get_value(record, \"CoordinateZ\"),\r\n\r\n            \"Elevation\":\r\n                get_value(record, \"Elevation\"),\r\n\r\n            \"Height\":\r\n                get_value(record, \"Height\"),\r\n\r\n            \"Width\":\r\n                get_value(record, \"Width\"),\r\n\r\n            \"Material\":\r\n                get_value(record, \"Material\"),\r\n\r\n            \"Layer\":\r\n                get_value(record, \"Layer\"),\r\n\r\n            \"ContainmentLevel\":\r\n                get_value(record, \"ContainmentLevel\"),\r\n\r\n            \"WorkingWidth\":\r\n                get_value(record, \"WorkingWidth\"),\r\n\r\n            \"TimeUnitLength(h)\":\r\n                get_value(record, \"TimeUnitLength(h)\"),\r\n\r\n            \"CostUnitLength\":\r\n                get_value(record, \"CostUnitLength\"),\r\n\r\n            \"TimeSegment(h)\":\r\n                get_value(record, \"TimeSegment(h)\"),\r\n\r\n            \"CostSegment\":\r\n                get_value(record, \"CostSegment\"),\r\n\r\n            \"Notes\":\r\n                get_value(record, \"Notes\"),\r\n\r\n            \"ObjectGUID\":\r\n                get_value(record, \"ObjectGUID\")\r\n        }\r\n\r\n\r\n        # ====================================================\r\n        # COMPONENT-SPECIFIC PROPERTIES\r\n        # ====================================================\r\n\r\n        component_type = clean_text(\r\n            get_value(\r\n                record,\r\n                \"ComponentType\"\r\n            )\r\n        ).upper()\r\n\r\n\r\n        if component_type == \"POST\":\r\n\r\n            properties_to_write[\r\n                \"PostSpacing\"\r\n            ] = get_value(\r\n                record,\r\n                \"PostSpacing\"\r\n            )\r\n\r\n\r\n        elif component_type == \"LINEAR\":\r\n\r\n            properties_to_write[\r\n                \"ModuleLength\"\r\n            ] = get_value(\r\n                record,\r\n                \"ModuleLength\"\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # WRITE PROPERTY VALUES\r\n        # ====================================================\r\n\r\n        written_count = 0\r\n        skipped_properties = []\r\n\r\n\r\n        for (\r\n            property_name,\r\n            property_value\r\n        ) in properties_to_write.items():\r\n\r\n            if set_property(\r\n                pset,\r\n                property_name,\r\n                property_value\r\n            ):\r\n\r\n                written_count += 1\r\n\r\n            else:\r\n\r\n                skipped_properties.append(\r\n                    property_name\r\n                )\r\n\r\n\r\n        # ====================================================\r\n        # SUCCESS\r\n        # ====================================================\r\n\r\n        assigned.append({\r\n\r\n            \"Index\":\r\n                index,\r\n\r\n            \"Handle\":\r\n                handle_text,\r\n\r\n            \"Pset\":\r\n                pset_name,\r\n\r\n            \"ParentID\":\r\n                get_value(\r\n                    record,\r\n                    \"ParentID\"\r\n                ),\r\n\r\n            \"ID\":\r\n                get_value(\r\n                    record,\r\n                    \"ID\"\r\n                ),\r\n\r\n            \"ComponentType\":\r\n                component_type,\r\n\r\n            \"PropertiesWritten\":\r\n                written_count,\r\n\r\n            \"PropertiesSkipped\":\r\n                skipped_properties\r\n        })\r\n\r\n\r\n    # ========================================================\r\n    # COMMIT\r\n    # ========================================================\r\n\r\n    transaction.Commit()\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Abort()\r\n        except:\r\n            pass\r\n\r\n\r\n    errors.append({\r\n\r\n        \"GeneralError\":\r\n            str(ex)\r\n    })\r\n\r\n\r\nfinally:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n    if doc_lock is not None:\r\n\r\n        try:\r\n            doc_lock.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# SUMMARY\r\n# ============================================================\r\n\r\nsummary = {\r\n\r\n    \"PsetName\":\r\n        pset_name,\r\n\r\n    \"InputRecords\":\r\n        len(records),\r\n\r\n    \"AssignedObjects\":\r\n        len(assigned),\r\n\r\n    \"ErrorCount\":\r\n        len(errors)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    assigned,      # 0\r\n    errors,        # 1\r\n    summary        # 2\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "01301714400244839bce717a853e4c8a",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "810bf223a25e49f1a4e2e7b441d3228b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7a881ad76e9e4071a5c8bff989a643b4",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d5022d3abaf2487b85051316f0c4e896",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# ASSIGN_BARRIER_PROPERTYSET_V4\r\n# CPython3 - Civil 3D / AEC Property Data\r\n#\r\n# IN[0] = Prepared PsetData\r\n# IN[1] = Property Set Definition Name\r\n#\r\n# OUT[0] = Assigned objects\r\n# OUT[1] = Errors\r\n# OUT[2] = Summary\r\n# ============================================================\r\n\r\nimport clr\r\n\r\n# ============================================================\r\n# REFERENCES\r\n# ============================================================\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\n\r\nclr.AddReference(\"AecBaseMgd\")\r\nclr.AddReference(\"AecPropDataMgd\")\r\n\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\n\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    OpenMode,\r\n    Handle\r\n)\r\n\r\nfrom Autodesk.Aec.PropertyData.DatabaseServices import (\r\n    PropertyDataServices,\r\n    DictionaryPropertySetDefinitions\r\n)\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ndata_input = IN[0]\r\npset_name_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# BASIC HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        return list(value)\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# HANDLE → OBJECT ID\r\n# ============================================================\r\n\r\ndef get_object_id_from_handle(\r\n    database,\r\n    handle_text\r\n):\r\n\r\n    try:\r\n\r\n        handle_number = int(\r\n            str(handle_text),\r\n            16\r\n        )\r\n\r\n        acad_handle = Handle(\r\n            handle_number\r\n        )\r\n\r\n        return database.GetObjectId(\r\n            False,\r\n            acad_handle,\r\n            0\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# GET PROPERTY SET DEFINITION\r\n#\r\n# IMPORTANT:\r\n# We do NOT use .Has().\r\n# We ask directly for GetAt(name).\r\n# ============================================================\r\n\r\ndef get_pset_definition_id(\r\n    database,\r\n    definition_name\r\n):\r\n\r\n    try:\r\n\r\n        definitions = (\r\n            DictionaryPropertySetDefinitions(\r\n                database\r\n            )\r\n        )\r\n\r\n        definition_id = definitions.GetAt(\r\n            definition_name\r\n        )\r\n\r\n        return definition_id\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# FIND ATTACHED PROPERTY SET\r\n# ============================================================\r\n\r\ndef find_attached_pset(\r\n    db_object,\r\n    definition_id,\r\n    transaction\r\n):\r\n\r\n    try:\r\n\r\n        pset_ids = (\r\n            PropertyDataServices\r\n            .GetPropertySets(\r\n                db_object\r\n            )\r\n        )\r\n\r\n        for pset_id in pset_ids:\r\n\r\n            try:\r\n\r\n                pset = transaction.GetObject(\r\n                    pset_id,\r\n                    OpenMode.ForRead\r\n                )\r\n\r\n                if (\r\n                    pset.PropertySetDefinition\r\n                    == definition_id\r\n                ):\r\n\r\n                    return pset_id\r\n\r\n            except:\r\n                pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# SET PROPERTY\r\n# ============================================================\r\n\r\ndef set_property(\r\n    pset,\r\n    property_name,\r\n    value\r\n):\r\n\r\n    if value is None:\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PROPERTY NAME → PROPERTY ID\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        property_id = (\r\n            pset.PropertyNameToId(\r\n                property_name\r\n            )\r\n        )\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        if property_id < 0:\r\n            return False\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DATA TYPE\r\n    # --------------------------------------------------------\r\n\r\n    if isinstance(value, bool):\r\n\r\n        final_value = value\r\n\r\n    elif isinstance(\r\n        value,\r\n        (int, float)\r\n    ):\r\n\r\n        final_value = float(value)\r\n\r\n    else:\r\n\r\n        final_value = str(value)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # WRITE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        pset.SetAt(\r\n            property_id,\r\n            final_value\r\n        )\r\n\r\n        return True\r\n\r\n    except:\r\n\r\n        # Some AEC properties are picky about datatype.\r\n        try:\r\n\r\n            pset.SetAt(\r\n                property_id,\r\n                str(final_value)\r\n            )\r\n\r\n            return True\r\n\r\n        except:\r\n\r\n            return False\r\n\r\n\r\n# ============================================================\r\n# PREPARE\r\n# ============================================================\r\n\r\nrecords = as_list(\r\n    data_input\r\n)\r\n\r\npset_name = clean_text(\r\n    pset_name_input\r\n)\r\n\r\nassigned = []\r\nerrors = []\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = (\r\n    Application\r\n    .DocumentManager\r\n    .MdiActiveDocument\r\n)\r\n\r\ndb = doc.Database\r\n\r\ndoc_lock = None\r\ntransaction = None\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    # --------------------------------------------------------\r\n    # LOCK DOCUMENT\r\n    # --------------------------------------------------------\r\n\r\n    doc_lock = doc.LockDocument()\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TRANSACTION\r\n    # --------------------------------------------------------\r\n\r\n    transaction = (\r\n        db.TransactionManager\r\n        .StartTransaction()\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FIND PSET DEFINITION\r\n    # ========================================================\r\n\r\n    definition_id = (\r\n        get_pset_definition_id(\r\n            db,\r\n            pset_name\r\n        )\r\n    )\r\n\r\n\r\n    if definition_id is None:\r\n\r\n        raise Exception(\r\n            \"Property Set Definition '{}' could not be resolved.\"\r\n            .format(\r\n                pset_name\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS OBJECTS\r\n    # ========================================================\r\n\r\n    for index, record in enumerate(records):\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # HANDLE\r\n        # ----------------------------------------------------\r\n\r\n        handle_text = clean_text(\r\n            get_value(\r\n                record,\r\n                \"Handle\"\r\n            )\r\n        )\r\n\r\n\r\n        if handle_text == \"\":\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Reason\":\r\n                    \"Handle is empty\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # HANDLE → OBJECT ID\r\n        # ----------------------------------------------------\r\n\r\n        object_id = (\r\n            get_object_id_from_handle(\r\n                db,\r\n                handle_text\r\n            )\r\n        )\r\n\r\n\r\n        if object_id is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Could not resolve ObjectId from Handle\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OPEN BLOCKREFERENCE / AUTOCAD OBJECT\r\n        # ----------------------------------------------------\r\n\r\n        try:\r\n\r\n            db_object = transaction.GetObject(\r\n                object_id,\r\n                OpenMode.ForWrite\r\n            )\r\n\r\n        except Exception as ex:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Could not open AutoCAD object\",\r\n\r\n                \"Detail\":\r\n                    str(ex)\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # CHECK IF PSET ALREADY EXISTS\r\n        # ====================================================\r\n\r\n        pset_id = (\r\n            find_attached_pset(\r\n                db_object,\r\n                definition_id,\r\n                transaction\r\n            )\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # ATTACH PSET IF NECESSARY\r\n        # ====================================================\r\n\r\n        if pset_id is None:\r\n\r\n            try:\r\n\r\n                PropertyDataServices.AddPropertySet(\r\n                    db_object,\r\n                    definition_id\r\n                )\r\n\r\n            except Exception as ex:\r\n\r\n                errors.append({\r\n\r\n                    \"Index\":\r\n                        index,\r\n\r\n                    \"Handle\":\r\n                        handle_text,\r\n\r\n                    \"Reason\":\r\n                        \"Could not attach Property Set\",\r\n\r\n                    \"Detail\":\r\n                        str(ex)\r\n                })\r\n\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # FIND NEWLY ATTACHED PSET\r\n            # ------------------------------------------------\r\n\r\n            pset_id = (\r\n                find_attached_pset(\r\n                    db_object,\r\n                    definition_id,\r\n                    transaction\r\n                )\r\n            )\r\n\r\n\r\n        if pset_id is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"Handle\":\r\n                    handle_text,\r\n\r\n                \"Reason\":\r\n                    \"Pset was not found after AddPropertySet\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # OPEN PSET FOR WRITE\r\n        # ====================================================\r\n\r\n        pset = transaction.GetObject(\r\n            pset_id,\r\n            OpenMode.ForWrite\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # COMMON PROPERTIES\r\n        # ====================================================\r\n\r\n        properties_to_write = {\r\n\r\n            \"ParentID\":\r\n                get_value(record, \"ParentID\"),\r\n\r\n            \"ID\":\r\n                get_value(record, \"ID\"),\r\n                \r\n            \"Type\":\r\n                get_value(record, \"Type\"),\r\n\r\n            \"BarrierFamily\":\r\n                get_value(record, \"BarrierFamily\"),\r\n               \r\n             \"IfcEntity\":\r\n                get_value(record, \"IFCEntity\"),\r\n\r\n            \"BarrierType\":\r\n                get_value(record, \"BarrierType\"),\r\n\r\n            \"Block\":\r\n                get_value(record, \"Block\"),\r\n\r\n            \"Side\":\r\n                get_value(record, \"Side\"),\r\n\r\n            \"PKStartValue\":\r\n                get_value(record, \"PKStartValue\"),\r\n\r\n            \"PKEndValue\":\r\n                get_value(record, \"PKEndValue\"),\r\n\r\n            \"PKStartLabel\":\r\n                get_value(record, \"PKStartLabel\"),\r\n\r\n            \"PKEndLabel\":\r\n                get_value(record, \"PKEndLabel\"),\r\n\r\n            \"Offset\":\r\n                get_value(record, \"Offset\"),\r\n\r\n            \"CoordinateX\":\r\n                get_value(record, \"CoordinateX\"),\r\n\r\n            \"CoordinateY\":\r\n                get_value(record, \"CoordinateY\"),\r\n\r\n            \"CoordinateZ\":\r\n                get_value(record, \"CoordinateZ\"),\r\n\r\n            \"Elevation\":\r\n                get_value(record, \"Elevation\"),\r\n\r\n            \"Height\":\r\n                get_value(record, \"Height\"),\r\n\r\n            \"Width\":\r\n                get_value(record, \"Width\"),\r\n\r\n            \"Material\":\r\n                get_value(record, \"Material\"),\r\n\r\n            \"Layer\":\r\n                get_value(record, \"Layer\"),\r\n\r\n            \"ContainmentLevel\":\r\n                get_value(record, \"ContainmentLevel\"),\r\n\r\n            \"WorkingWidth\":\r\n                get_value(record, \"WorkingWidth\"),\r\n\r\n            \"TimeUnitLength(h)\":\r\n                get_value(record, \"TimeUnitLength(h)\"),\r\n\r\n            \"CostUnitLength\":\r\n                get_value(record, \"CostUnitLength\"),\r\n\r\n            \"TimeSegment(h)\":\r\n                get_value(record, \"TimeSegment(h)\"),\r\n\r\n            \"CostSegment\":\r\n                get_value(record, \"CostSegment\"),\r\n\r\n            \"Notes\":\r\n                get_value(record, \"Notes\"),\r\n\r\n            \"ObjectGUID\":\r\n                get_value(record, \"ObjectGUID\")\r\n        }\r\n\r\n\r\n        # ====================================================\r\n        # COMPONENT-SPECIFIC PROPERTIES\r\n        # ====================================================\r\n\r\n        component_type = clean_text(\r\n            get_value(\r\n                record,\r\n                \"ComponentType\"\r\n            )\r\n        ).upper()\r\n\r\n\r\n        if component_type == \"POST\":\r\n\r\n            properties_to_write[\r\n                \"PostSpacing\"\r\n            ] = get_value(\r\n                record,\r\n                \"PostSpacing\"\r\n            )\r\n\r\n\r\n        elif component_type == \"LINEAR\":\r\n\r\n            properties_to_write[\r\n                \"ModuleLength\"\r\n            ] = get_value(\r\n                record,\r\n                \"ModuleLength\"\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # WRITE PROPERTY VALUES\r\n        # ====================================================\r\n\r\n        written_count = 0\r\n        skipped_properties = []\r\n\r\n\r\n        for (\r\n            property_name,\r\n            property_value\r\n        ) in properties_to_write.items():\r\n\r\n            if set_property(\r\n                pset,\r\n                property_name,\r\n                property_value\r\n            ):\r\n\r\n                written_count += 1\r\n\r\n            else:\r\n\r\n                skipped_properties.append(\r\n                    property_name\r\n                )\r\n\r\n\r\n        # ====================================================\r\n        # SUCCESS\r\n        # ====================================================\r\n\r\n        assigned.append({\r\n\r\n            \"Index\":\r\n                index,\r\n\r\n            \"Handle\":\r\n                handle_text,\r\n\r\n            \"Pset\":\r\n                pset_name,\r\n\r\n            \"ParentID\":\r\n                get_value(\r\n                    record,\r\n                    \"ParentID\"\r\n                ),\r\n\r\n            \"ID\":\r\n                get_value(\r\n                    record,\r\n                    \"ID\"\r\n                ),\r\n\r\n            \"ComponentType\":\r\n                component_type,\r\n\r\n            \"PropertiesWritten\":\r\n                written_count,\r\n\r\n            \"PropertiesSkipped\":\r\n                skipped_properties\r\n        })\r\n\r\n\r\n    # ========================================================\r\n    # COMMIT\r\n    # ========================================================\r\n\r\n    transaction.Commit()\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Abort()\r\n        except:\r\n            pass\r\n\r\n\r\n    errors.append({\r\n\r\n        \"GeneralError\":\r\n            str(ex)\r\n    })\r\n\r\n\r\nfinally:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n    if doc_lock is not None:\r\n\r\n        try:\r\n            doc_lock.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# SUMMARY\r\n# ============================================================\r\n\r\nsummary = {\r\n\r\n    \"PsetName\":\r\n        pset_name,\r\n\r\n    \"InputRecords\":\r\n        len(records),\r\n\r\n    \"AssignedObjects\":\r\n        len(assigned),\r\n\r\n    \"ErrorCount\":\r\n        len(errors)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    assigned,      # 0\r\n    errors,        # 1\r\n    summary        # 2\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6a4f8e4a8a3c407faa9bade47e245097",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d24f30de30d547e9b5d0fd6c29abe915",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6fad8b4cda68487d998fe16b5ee8e781",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "741807bc88834405a51d7ee5d8efd684",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
