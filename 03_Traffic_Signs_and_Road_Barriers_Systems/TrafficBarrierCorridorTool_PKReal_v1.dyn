    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "eabc9bd9257441dc8a6057ae84e1dcb3",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "44491c6a4a1b4a068586c29002df8cd2",
          "Name": "x",
          "Description": "X coordinate\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "533232f187a74362a09a1fab46678a6b",
          "Name": "y",
          "Description": "Y coordinate\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "62c2d1c89c0a4c3892f589f4c8f30fd2",
          "Name": "z",
          "Description": "Z coordinate\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a630ee5b95754878991462cc65f9aacc",
          "Name": "Point",
          "Description": "Point created by coordinates",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Point.ByCoordinates@double,double,double",
      "Replication": "Auto",
      "Description": "Form a Point given 3 cartesian coordinates\n\nPoint.ByCoordinates (x: double = 0, y: double = 0, z: double = 0): Point"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - LINEAR_ORIENTATION_GENERATOR\r\n#\r\n# IN[0] = CoordinateSystems for linear modules\r\n# IN[1] = Module metadata\r\n#\r\n# OUT[0] = Rotation angles in radians\r\n# OUT[1] = Linear orientation metadata\r\n# OUT[2] = Warnings\r\n\r\nimport math\r\n\r\ncoordinate_systems_input = IN[0]\r\nmodule_metadata_input = IN[1]\r\n\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ncoordinate_systems = as_list(\r\n    coordinate_systems_input\r\n)\r\n\r\nmodule_metadata = as_list(\r\n    module_metadata_input\r\n)\r\n\r\n\r\nrotation_angles = []\r\norientation_data = []\r\nwarnings = []\r\n\r\n\r\ncount = min(\r\n    len(coordinate_systems),\r\n    len(module_metadata)\r\n)\r\n\r\n\r\nfor index in range(count):\r\n\r\n    cs = coordinate_systems[index]\r\n    meta = module_metadata[index]\r\n\r\n    segment_id = clean_text(\r\n        get_value(meta, \"ID\")\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_value(meta, \"ParentID\")\r\n    )\r\n\r\n    station = get_value(\r\n        meta,\r\n        \"Station\"\r\n    )\r\n\r\n    side = clean_text(\r\n        get_value(meta, \"Side\")\r\n    ).upper()\r\n\r\n\r\n    try:\r\n\r\n        # --------------------------------------------\r\n        # Local alignment tangent\r\n        # --------------------------------------------\r\n\r\n        x_axis = cs.XAxis\r\n\r\n        x = float(x_axis.X)\r\n        y = float(x_axis.Y)\r\n\r\n        tangent_angle = math.atan2(\r\n            y,\r\n            x\r\n        )\r\n\r\n\r\n        # --------------------------------------------\r\n        # IMPORTANT:\r\n        #\r\n        # Linear block was modeled pointing RIGHT.\r\n        #\r\n        # RIGHT:\r\n        # block follows alignment tangent.\r\n        #\r\n        # LEFT:\r\n        # block is reversed 180 degrees.\r\n        # --------------------------------------------\r\n\r\n        rotation_angle = tangent_angle\r\n\r\n\r\n        if side == \"LEFT\":\r\n\r\n            rotation_angle += math.pi\r\n\r\n\r\n        # Normalize 0 → 2*pi\r\n\r\n        rotation_angle = (\r\n            rotation_angle\r\n            % (2.0 * math.pi)\r\n        )\r\n\r\n\r\n        rotation_angles.append(\r\n            rotation_angle\r\n        )\r\n\r\n\r\n        orientation_data.append({\r\n\r\n            \"ModuleIndex\":\r\n                index,\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"Station\":\r\n                station,\r\n\r\n            \"Side\":\r\n                side,\r\n\r\n            \"TangentAngle\":\r\n                tangent_angle,\r\n\r\n            \"RotationAngle\":\r\n                rotation_angle\r\n        })\r\n\r\n\r\n    except Exception as error:\r\n\r\n        rotation_angles.append(\r\n            None\r\n        )\r\n\r\n        warnings.append(\r\n            \"Linear module {} | Segment '{}': {}\"\r\n            .format(\r\n                index,\r\n                segment_id,\r\n                str(error)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# COUNT CHECK\r\n# ============================================================\r\n\r\nif (\r\n    len(coordinate_systems)\r\n    != len(module_metadata)\r\n):\r\n\r\n    warnings.append(\r\n        \"CoordinateSystem count ({}) differs from \"\r\n        \"Module metadata count ({}).\"\r\n        .format(\r\n            len(coordinate_systems),\r\n            len(module_metadata)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    rotation_angles,     # 0\r\n    orientation_data,    # 1\r\n    warnings             # 2\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "145afd843f80406cad1b053f78fa981e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "7e3acbfd4f0f46e9a6e7a1a97e0f894b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "aeba0917745c4d699ea20905915c2966",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7628571d84304e91939c970351ef87e9",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "4044539fb7f542c798aafacaf24f3cd4",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "373404223b814c17a0edcf7a4ae66610",
          "Name": "linrot",
          "Description": "linrot",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "65ef06b383924abb92586ebd10977444",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(linrot, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1e511c3d62ef49ebbf3a1128fedaad74",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(linrot, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0e381c83af7440b1ae2bd4335a2e8c2f",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(linrot, 2)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "linrot[0];\nlinrot[1];\nlinrot[2];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# INSERT_BARRIER_LINEAR_V3\r\n# CPython3 - Civil 3D / AutoCAD\r\n#\r\n# RELOADS BLOCK DEFINITIONS FROM DWG ON EVERY DYNAMO RUN\r\n#\r\n# IN[0] = Linear Module Points\r\n# IN[1] = Linear DWG Paths\r\n# IN[2] = Rotation Angles [radians]\r\n# IN[3] = Module Metadata\r\n# IN[4] = MaxCount\r\n#         0 = ALL\r\n#\r\n# OUT[0] = Inserted objects metadata\r\n# OUT[1] = Handles\r\n# OUT[2] = Errors\r\n# OUT[3] = Summary\r\n# ============================================================\r\n\r\nimport clr\r\nimport os\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\n\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    BlockTableRecord,\r\n    BlockReference,\r\n    Database,\r\n    OpenMode,\r\n    FileOpenMode,\r\n    ObjectIdCollection,\r\n    IdMapping,\r\n    DuplicateRecordCloning\r\n)\r\n\r\nfrom Autodesk.AutoCAD.Geometry import Point3d\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\npoints_input = IN[0]\r\npaths_input = IN[1]\r\nrotations_input = IN[2]\r\nmetadata_input = IN[3]\r\nmax_count_input = IN[4]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n\r\n        result = []\r\n\r\n        for item in value:\r\n\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef to_int(value, default=0):\r\n\r\n    try:\r\n        return int(value)\r\n\r\n    except:\r\n        return default\r\n\r\n\r\ndef point_xyz(point):\r\n\r\n    try:\r\n\r\n        return (\r\n            float(point.X),\r\n            float(point.Y),\r\n            float(point.Z)\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# BLOCK RELOAD FUNCTION\r\n# ============================================================\r\n\r\ndef reload_existing_block(\r\n    target_db,\r\n    target_transaction,\r\n    block_id,\r\n    dwg_path\r\n):\r\n\r\n    \"\"\"\r\n    Replaces the geometry contained inside an existing block\r\n    definition using the current contents of the external DWG.\r\n\r\n    The BlockTableRecord ObjectId is preserved.\r\n\r\n    Therefore, existing BlockReferences in the drawing should\r\n    use the updated definition automatically.\r\n    \"\"\"\r\n\r\n    source_db = Database(\r\n        False,\r\n        True\r\n    )\r\n\r\n    source_transaction = None\r\n\r\n    try:\r\n\r\n        # ----------------------------------------------------\r\n        # READ CURRENT EXTERNAL DWG\r\n        # ----------------------------------------------------\r\n\r\n        source_db.ReadDwgFile(\r\n            dwg_path,\r\n            FileOpenMode.OpenForReadAndAllShare,\r\n            True,\r\n            \"\"\r\n        )\r\n\r\n        source_db.CloseInput(\r\n            True\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OPEN SOURCE DATABASE\r\n        # ----------------------------------------------------\r\n\r\n        source_transaction = (\r\n            source_db.TransactionManager.StartTransaction()\r\n        )\r\n\r\n        source_block_table = (\r\n            source_transaction.GetObject(\r\n                source_db.BlockTableId,\r\n                OpenMode.ForRead\r\n            )\r\n        )\r\n\r\n        source_model_space_id = (\r\n            source_block_table.get_Item(\r\n                BlockTableRecord.ModelSpace\r\n            )\r\n        )\r\n\r\n        source_model_space = (\r\n            source_transaction.GetObject(\r\n                source_model_space_id,\r\n                OpenMode.ForRead\r\n            )\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OPEN EXISTING TARGET BLOCK\r\n        # ----------------------------------------------------\r\n\r\n        target_block = (\r\n            target_transaction.GetObject(\r\n                block_id,\r\n                OpenMode.ForWrite\r\n            )\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # REMOVE OLD GEOMETRY FROM BLOCK DEFINITION\r\n        # ----------------------------------------------------\r\n\r\n        old_ids = []\r\n\r\n        for entity_id in target_block:\r\n\r\n            old_ids.append(\r\n                entity_id\r\n            )\r\n\r\n\r\n        for entity_id in old_ids:\r\n\r\n            try:\r\n\r\n                entity = (\r\n                    target_transaction.GetObject(\r\n                        entity_id,\r\n                        OpenMode.ForWrite\r\n                    )\r\n                )\r\n\r\n                entity.Erase()\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # COLLECT NEW GEOMETRY FROM EXTERNAL DWG\r\n        # ----------------------------------------------------\r\n\r\n        source_ids = ObjectIdCollection()\r\n\r\n        for entity_id in source_model_space:\r\n\r\n            source_ids.Add(\r\n                entity_id\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # CLONE NEW GEOMETRY INTO EXISTING BLOCK DEFINITION\r\n        # ----------------------------------------------------\r\n\r\n        if source_ids.Count > 0:\r\n\r\n            id_mapping = IdMapping()\r\n\r\n            source_db.WblockCloneObjects(\r\n                source_ids,\r\n                block_id,\r\n                id_mapping,\r\n                DuplicateRecordCloning.Replace,\r\n                False\r\n            )\r\n\r\n\r\n        source_transaction.Commit()\r\n\r\n        return True, \"\"\r\n\r\n\r\n    except Exception as ex:\r\n\r\n        if source_transaction is not None:\r\n\r\n            try:\r\n                source_transaction.Abort()\r\n            except:\r\n                pass\r\n\r\n        return False, str(ex)\r\n\r\n\r\n    finally:\r\n\r\n        if source_transaction is not None:\r\n\r\n            try:\r\n                source_transaction.Dispose()\r\n            except:\r\n                pass\r\n\r\n        try:\r\n            source_db.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUT LISTS\r\n# ============================================================\r\n\r\npoints = as_list(\r\n    points_input\r\n)\r\n\r\npaths = as_list(\r\n    paths_input\r\n)\r\n\r\nrotations = as_list(\r\n    rotations_input\r\n)\r\n\r\nmetadata = as_list(\r\n    metadata_input\r\n)\r\n\r\n\r\nmax_count = to_int(\r\n    max_count_input,\r\n    0\r\n)\r\n\r\n\r\navailable_count = min(\r\n    len(points),\r\n    len(paths),\r\n    len(rotations),\r\n    len(metadata)\r\n)\r\n\r\n\r\nif max_count > 0:\r\n\r\n    process_count = min(\r\n        available_count,\r\n        max_count\r\n    )\r\n\r\nelse:\r\n\r\n    process_count = available_count\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\ninserted_data = []\r\nhandles = []\r\nerrors = []\r\n\r\nreloaded_blocks = []\r\nloaded_blocks = []\r\n\r\n\r\n# Cache avoids reloading the same DWG hundreds of times\r\nblock_cache = {}\r\n\r\n\r\n# ============================================================\r\n# AUTOCAD DOCUMENT\r\n# ============================================================\r\n\r\ndoc = (\r\n    Application\r\n    .DocumentManager\r\n    .MdiActiveDocument\r\n)\r\n\r\ndb = doc.Database\r\n\r\ndoc_lock = None\r\ntransaction = None\r\n\r\n\r\ntry:\r\n\r\n    # ========================================================\r\n    # LOCK CURRENT DRAWING\r\n    # ========================================================\r\n\r\n    doc_lock = doc.LockDocument()\r\n\r\n\r\n    # ========================================================\r\n    # START TRANSACTION\r\n    # ========================================================\r\n\r\n    transaction = (\r\n        db.TransactionManager.StartTransaction()\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # BLOCK TABLE\r\n    # ========================================================\r\n\r\n    block_table = (\r\n        transaction.GetObject(\r\n            db.BlockTableId,\r\n            OpenMode.ForRead\r\n        )\r\n    )\r\n\r\n\r\n    model_space_id = (\r\n        block_table.get_Item(\r\n            BlockTableRecord.ModelSpace\r\n        )\r\n    )\r\n\r\n\r\n    model_space = (\r\n        transaction.GetObject(\r\n            model_space_id,\r\n            OpenMode.ForWrite\r\n        )\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS MODULES\r\n    # ========================================================\r\n\r\n    for index in range(process_count):\r\n\r\n        point = points[index]\r\n\r\n        path = clean_text(\r\n            paths[index]\r\n        )\r\n\r\n        meta = metadata[index]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # METADATA\r\n        # ----------------------------------------------------\r\n\r\n        segment_id = clean_text(\r\n            get_value(\r\n                meta,\r\n                \"ID\"\r\n            )\r\n        )\r\n\r\n        parent_id = clean_text(\r\n            get_value(\r\n                meta,\r\n                \"ParentID\"\r\n            )\r\n        )\r\n\r\n        station = get_value(\r\n            meta,\r\n            \"Station\"\r\n        )\r\n\r\n        side = clean_text(\r\n            get_value(\r\n                meta,\r\n                \"Side\"\r\n            )\r\n        )\r\n\r\n        section_type = clean_text(\r\n            get_value(\r\n                meta,\r\n                \"SectionType\"\r\n            )\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # VALIDATE POINT\r\n        # ----------------------------------------------------\r\n\r\n        xyz = point_xyz(\r\n            point\r\n        )\r\n\r\n\r\n        if xyz is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"ID\":\r\n                    segment_id,\r\n\r\n                \"Reason\":\r\n                    \"Invalid insertion point\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # VALIDATE DWG PATH\r\n        # ----------------------------------------------------\r\n\r\n        if (\r\n            path == \"\"\r\n            or not os.path.isfile(path)\r\n        ):\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"ID\":\r\n                    segment_id,\r\n\r\n                \"Path\":\r\n                    path,\r\n\r\n                \"Reason\":\r\n                    \"DWG file not found\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # ROTATION\r\n        # ----------------------------------------------------\r\n\r\n        try:\r\n\r\n            rotation = float(\r\n                rotations[index]\r\n            )\r\n\r\n        except:\r\n\r\n            errors.append({\r\n\r\n                \"Index\":\r\n                    index,\r\n\r\n                \"ID\":\r\n                    segment_id,\r\n\r\n                \"Reason\":\r\n                    \"Invalid rotation\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # BLOCK NAME FROM DWG NAME\r\n        # ----------------------------------------------------\r\n\r\n        block_name = (\r\n            os.path.splitext(\r\n                os.path.basename(\r\n                    path\r\n                )\r\n            )[0]\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # LOAD / RELOAD BLOCK DEFINITION\r\n        #\r\n        # IMPORTANT:\r\n        # Only once per unique BlockName per Dynamo execution.\r\n        # ====================================================\r\n\r\n        if block_name in block_cache:\r\n\r\n            block_id = (\r\n                block_cache[\r\n                    block_name\r\n                ]\r\n            )\r\n\r\n\r\n        else:\r\n\r\n            # ------------------------------------------------\r\n            # BLOCK ALREADY EXISTS IN DRAWING\r\n            # → RELOAD FROM EXTERNAL DWG\r\n            # ------------------------------------------------\r\n\r\n            if block_table.Has(\r\n                block_name\r\n            ):\r\n\r\n                block_id = (\r\n                    block_table.get_Item(\r\n                        block_name\r\n                    )\r\n                )\r\n\r\n\r\n                reload_ok, reload_message = (\r\n                    reload_existing_block(\r\n                        db,\r\n                        transaction,\r\n                        block_id,\r\n                        path\r\n                    )\r\n                )\r\n\r\n\r\n                if reload_ok:\r\n\r\n                    reloaded_blocks.append(\r\n                        block_name\r\n                    )\r\n\r\n\r\n                else:\r\n\r\n                    errors.append({\r\n\r\n                        \"Index\":\r\n                            index,\r\n\r\n                        \"ID\":\r\n                            segment_id,\r\n\r\n                        \"BlockName\":\r\n                            block_name,\r\n\r\n                        \"Reason\":\r\n                            \"Block reload failed\",\r\n\r\n                        \"Detail\":\r\n                            reload_message\r\n                    })\r\n\r\n                    continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # BLOCK DOES NOT EXIST\r\n            # → LOAD IT FOR FIRST TIME\r\n            # ------------------------------------------------\r\n\r\n            else:\r\n\r\n                source_db = Database(\r\n                    False,\r\n                    True\r\n                )\r\n\r\n                try:\r\n\r\n                    source_db.ReadDwgFile(\r\n                        path,\r\n                        FileOpenMode.OpenForReadAndAllShare,\r\n                        True,\r\n                        \"\"\r\n                    )\r\n\r\n                    source_db.CloseInput(\r\n                        True\r\n                    )\r\n\r\n\r\n                    block_id = db.Insert(\r\n                        block_name,\r\n                        source_db,\r\n                        False\r\n                    )\r\n\r\n\r\n                    loaded_blocks.append(\r\n                        block_name\r\n                    )\r\n\r\n\r\n                finally:\r\n\r\n                    try:\r\n                        source_db.Dispose()\r\n                    except:\r\n                        pass\r\n\r\n\r\n            # ------------------------------------------------\r\n            # SAVE IN CACHE\r\n            # ------------------------------------------------\r\n\r\n            block_cache[\r\n                block_name\r\n            ] = block_id\r\n\r\n\r\n        # ====================================================\r\n        # INSERT BLOCKREFERENCE\r\n        # ====================================================\r\n\r\n        insertion_point = Point3d(\r\n            xyz[0],\r\n            xyz[1],\r\n            xyz[2]\r\n        )\r\n\r\n\r\n        block_ref = BlockReference(\r\n            insertion_point,\r\n            block_id\r\n        )\r\n\r\n\r\n        block_ref.Rotation = (\r\n            rotation\r\n        )\r\n\r\n\r\n        model_space.AppendEntity(\r\n            block_ref\r\n        )\r\n\r\n\r\n        transaction.AddNewlyCreatedDBObject(\r\n            block_ref,\r\n            True\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # IDENTIFIERS\r\n        # ====================================================\r\n\r\n        handle = str(\r\n            block_ref.Handle\r\n        )\r\n\r\n\r\n        object_id = str(\r\n            block_ref.ObjectId\r\n        )\r\n\r\n\r\n        handles.append(\r\n            handle\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # ENRICHED OBJECT DATA\r\n        # ====================================================\r\n\r\n        inserted_data.append({\r\n\r\n            \"ComponentType\":\r\n                \"LINEAR\",\r\n\r\n            \"ModuleIndex\":\r\n                index,\r\n\r\n            \"ObjectId\":\r\n                object_id,\r\n\r\n            \"Handle\":\r\n                handle,\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"Station\":\r\n                station,\r\n\r\n            \"Side\":\r\n                side,\r\n\r\n            \"SectionType\":\r\n                section_type,\r\n\r\n            \"BlockName\":\r\n                block_name,\r\n\r\n            \"BlockPath\":\r\n                path,\r\n\r\n            \"Rotation\":\r\n                rotation,\r\n\r\n            \"X\":\r\n                xyz[0],\r\n\r\n            \"Y\":\r\n                xyz[1],\r\n\r\n            \"Z\":\r\n                xyz[2]\r\n        })\r\n\r\n\r\n    # ========================================================\r\n    # COMMIT\r\n    # ========================================================\r\n\r\n    transaction.Commit()\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Abort()\r\n        except:\r\n            pass\r\n\r\n\r\n    errors.append({\r\n\r\n        \"GeneralError\":\r\n            str(ex)\r\n    })\r\n\r\n\r\nfinally:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n    if doc_lock is not None:\r\n\r\n        try:\r\n            doc_lock.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# SUMMARY\r\n# ============================================================\r\n\r\nsummary = {\r\n\r\n    \"AvailableItems\":\r\n        available_count,\r\n\r\n    \"RequestedItems\":\r\n        process_count,\r\n\r\n    \"CreatedItems\":\r\n        len(inserted_data),\r\n\r\n    \"ReloadedBlockDefinitions\":\r\n        len(reloaded_blocks),\r\n\r\n    \"LoadedNewBlockDefinitions\":\r\n        len(loaded_blocks),\r\n\r\n    \"ReloadedBlocks\":\r\n        reloaded_blocks,\r\n\r\n    \"LoadedBlocks\":\r\n        loaded_blocks,\r\n\r\n    \"ErrorCount\":\r\n        len(errors)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    inserted_data,     # 0\r\n    handles,           # 1\r\n    errors,            # 2\r\n    summary            # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "772a782fb7a7497d97f839661344698f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
