    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "4bef27d23355428588bb1521479e0113",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "2a80a504fef8476ab3ff0d383610c2f5",
          "Name": "integer",
          "Description": "1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "1;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - GROUP_POINTS_BY_SEGMENT\r\n#\r\n# PURPOSE:\r\n# Rebuilds the point list structure using the GeometryPointCount\r\n# stored for each barrier segment.\r\n#\r\n# IN[0] = Flat geometry point list\r\n# IN[1] = Segment summary from BARRIER_STATION_GENERATOR\r\n#\r\n# OUT[0] = Points grouped by segment\r\n# OUT[1] = Segment information\r\n# OUT[2] = Invalid segments\r\n# OUT[3] = Warnings\r\n\r\n\r\npoints_input = IN[0]\r\nsummary_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef to_integer(value):\r\n    if value is None:\r\n        return None\r\n\r\n    try:\r\n        return int(round(float(value)))\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUTS\r\n# ============================================================\r\n\r\npoints = as_list(points_input)\r\nsummary = as_list(summary_input)\r\n\r\ngrouped_points = []\r\nsegment_information = []\r\ninvalid_segments = []\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# REBUILD POINT GROUPS\r\n# ============================================================\r\n\r\ncursor = 0\r\n\r\n\r\nfor index, item in enumerate(summary):\r\n\r\n    segment_id = clean_text(\r\n        get_value(item, \"ID\")\r\n    )\r\n\r\n    start_station = get_value(\r\n        item,\r\n        \"StartStation\"\r\n    )\r\n\r\n    end_station = get_value(\r\n        item,\r\n        \"EndStation\"\r\n    )\r\n\r\n    geometry_point_count = to_integer(\r\n        get_value(\r\n            item,\r\n            \"GeometryPointCount\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Validate point count\r\n    # --------------------------------------------------------\r\n\r\n    if geometry_point_count is None:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"Reason\":\r\n                \"GeometryPointCount is missing or invalid.\"\r\n        })\r\n\r\n        continue\r\n\r\n\r\n    if geometry_point_count < 2:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"Reason\":\r\n                \"At least 2 points are required to create a curve.\"\r\n        })\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Calculate slice\r\n    # --------------------------------------------------------\r\n\r\n    start_index = cursor\r\n\r\n    end_index = (\r\n        cursor + geometry_point_count\r\n    )\r\n\r\n\r\n    if end_index > len(points):\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"ExpectedPoints\":\r\n                geometry_point_count,\r\n\r\n            \"AvailablePoints\":\r\n                max(0, len(points) - cursor),\r\n\r\n            \"Reason\":\r\n                \"Not enough geometry points are available.\"\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}': expected {} points, \"\r\n            \"but only {} points remain.\"\r\n            .format(\r\n                segment_id,\r\n                geometry_point_count,\r\n                max(0, len(points) - cursor)\r\n            )\r\n        )\r\n\r\n        break\r\n\r\n\r\n    segment_points = points[\r\n        start_index:end_index\r\n    ]\r\n\r\n\r\n    grouped_points.append(\r\n        segment_points\r\n    )\r\n\r\n\r\n    segment_information.append({\r\n\r\n        \"ID\":\r\n            segment_id,\r\n\r\n        \"StartStation\":\r\n            start_station,\r\n\r\n        \"EndStation\":\r\n            end_station,\r\n\r\n        \"PointCount\":\r\n            len(segment_points),\r\n\r\n        \"StartPointIndex\":\r\n            start_index,\r\n\r\n        \"EndPointIndex\":\r\n            end_index - 1\r\n    })\r\n\r\n\r\n    cursor = end_index\r\n\r\n\r\n# ============================================================\r\n# FINAL CONSISTENCY CHECK\r\n# ============================================================\r\n\r\nif cursor < len(points):\r\n\r\n    warnings.append(\r\n        \"{} geometry points were not assigned \"\r\n        \"to any barrier segment.\"\r\n        .format(\r\n            len(points) - cursor\r\n        )\r\n    )\r\n\r\n\r\nelif cursor > len(points):\r\n\r\n    warnings.append(\r\n        \"The requested segment point counts exceed \"\r\n        \"the available geometry point count.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    grouped_points,          # 0\r\n    segment_information,     # 1\r\n    invalid_segments,        # 2\r\n    warnings                 # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "fad55be9da70436787059b03f5d7f4c9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b332c8f0fccf416aab29eaa7d8cd6529",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3a42b353647b42bb8370ff362449ca05",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a4bba9553a404c929f0ff679e91acc9d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
