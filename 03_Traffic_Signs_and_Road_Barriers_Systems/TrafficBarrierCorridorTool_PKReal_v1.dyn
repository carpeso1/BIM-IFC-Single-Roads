    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "28644f45265a4f2d94846d9c6e06bddf",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "584ef253a7c342e189214ee28c207f37",
          "Name": "baselineRegion",
          "Description": "Autodesk.Civil.DynamoNodes.BaselineRegion",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "522a6aafad474031bddaec5593d415d9",
          "Name": "Assembly",
          "Description": "Assembly assigned to baseline region",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.Civil.DynamoNodes.BaselineRegion.Assembly",
      "Replication": "Auto",
      "Description": "Returns the assembly assigned to a baseline region\n\nBaselineRegion.Assembly: Assembly"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - SECTION_OFFSET_SOLVER_V1\r\n#\r\n# PURPOSE:\r\n# Splits each barrier into subsegments according to\r\n# Civil 3D corridor baseline regions.\r\n#\r\n# IN[0] = Clean BarrierData\r\n# IN[1] = Region Start Stations\r\n# IN[2] = Region End Stations\r\n# IN[3] = Region Assemblies\r\n#\r\n# OUT[0] = BarrierSegmentData\r\n# OUT[1] = InvalidSegments\r\n# OUT[2] = Warnings\r\n# OUT[3] = Summary\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nbarrier_data = IN[0]\r\nregion_starts_input = IN[1]\r\nregion_ends_input = IN[2]\r\nregion_assemblies_input = IN[3]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    \"\"\"\r\n    Converts Dynamo inputs into a flat Python list.\r\n    \"\"\"\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    \"\"\"\r\n    Converts any value to clean text.\r\n    \"\"\"\r\n    if value is None:\r\n        return \"\"\r\n\r\n    text = str(value)\r\n\r\n    text = text.replace(\"\\u00A0\", \" \")\r\n    text = text.replace(\"\\u200B\", \"\")\r\n    text = text.replace(\"\\ufeff\", \"\")\r\n    text = text.replace(\"\\r\", \"\")\r\n    text = text.replace(\"\\n\", \"\")\r\n\r\n    return text.strip()\r\n\r\n\r\ndef to_number(value):\r\n    \"\"\"\r\n    Converts Dynamo / Excel numeric values to float.\r\n    \"\"\"\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = clean_text(value).replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_dict_value(dictionary, key):\r\n    \"\"\"\r\n    Safely reads a value from a Python or Dynamo dictionary.\r\n    \"\"\"\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_assembly_name(value):\r\n    \"\"\"\r\n    Attempts to obtain the Assembly name from the Civil 3D object.\r\n    \"\"\"\r\n    if value is None:\r\n        return \"\"\r\n\r\n    # Civil 3D / Dynamo object may expose Name directly\r\n    try:\r\n        if hasattr(value, \"Name\"):\r\n            return clean_text(value.Name)\r\n    except Exception:\r\n        pass\r\n\r\n    # Fall back to string representation\r\n    text = clean_text(value)\r\n\r\n    # Common Dynamo representation:\r\n    # Assembly(Name = ST_2)\r\n    if \"Name =\" in text:\r\n        try:\r\n            name_part = text.split(\"Name =\", 1)[1]\r\n            name_part = name_part.split(\")\", 1)[0]\r\n            return clean_text(name_part)\r\n        except Exception:\r\n            pass\r\n\r\n    return text\r\n\r\n\r\n# ============================================================\r\n# PREPARE REGION DATA\r\n# ============================================================\r\n\r\nregion_starts = as_list(region_starts_input)\r\nregion_ends = as_list(region_ends_input)\r\nregion_assemblies = as_list(region_assemblies_input)\r\n\r\nbarriers = as_list(barrier_data)\r\n\r\n\r\nbarrier_segments = []\r\ninvalid_segments = []\r\nwarnings = []\r\nsummary = []\r\n\r\n\r\n# ============================================================\r\n# VALIDATE REGION INPUT LENGTHS\r\n# ============================================================\r\n\r\nregion_count = min(\r\n    len(region_starts),\r\n    len(region_ends),\r\n    len(region_assemblies)\r\n)\r\n\r\nif region_count == 0:\r\n\r\n    warnings.append(\r\n        \"No valid corridor region data was received.\"\r\n    )\r\n\r\nelse:\r\n\r\n    # Build a clean list of corridor regions\r\n    corridor_regions = []\r\n\r\n    for index in range(region_count):\r\n\r\n        start_station = to_number(\r\n            region_starts[index]\r\n        )\r\n\r\n        end_station = to_number(\r\n            region_ends[index]\r\n        )\r\n\r\n        assembly_name = get_assembly_name(\r\n            region_assemblies[index]\r\n        )\r\n\r\n        if start_station is None or end_station is None:\r\n\r\n            warnings.append(\r\n                \"Region {}: invalid start or end station.\"\r\n                .format(index)\r\n            )\r\n\r\n            continue\r\n\r\n        if end_station <= start_station:\r\n\r\n            warnings.append(\r\n                \"Region {}: EndStation must be greater \"\r\n                \"than StartStation.\"\r\n                .format(index)\r\n            )\r\n\r\n            continue\r\n\r\n        corridor_regions.append({\r\n            \"RegionIndex\": index,\r\n            \"StartStation\": start_station,\r\n            \"EndStation\": end_station,\r\n            \"Assembly\": assembly_name\r\n        })\r\n\r\n\r\n    # Sort regions by station\r\n    corridor_regions = sorted(\r\n        corridor_regions,\r\n        key=lambda item: item[\"StartStation\"]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS BARRIERS\r\n    # ========================================================\r\n\r\n    for barrier_index, barrier in enumerate(barriers):\r\n\r\n        barrier_id = clean_text(\r\n            get_dict_value(barrier, \"ID\")\r\n        )\r\n\r\n        side = clean_text(\r\n            get_dict_value(barrier, \"Side\")\r\n        ).upper()\r\n\r\n        barrier_start = to_number(\r\n            get_dict_value(\r\n                barrier,\r\n                \"PKStartValue\"\r\n            )\r\n        )\r\n\r\n        barrier_end = to_number(\r\n            get_dict_value(\r\n                barrier,\r\n                \"PKEndValue\"\r\n            )\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # Basic barrier validation\r\n        # ----------------------------------------------------\r\n\r\n        if barrier_id == \"\":\r\n            barrier_id = \"Barrier_{}\".format(\r\n                barrier_index + 1\r\n            )\r\n\r\n        if barrier_start is None or barrier_end is None:\r\n\r\n            invalid_segments.append({\r\n                \"ParentID\": barrier_id,\r\n                \"Reason\": \"Invalid PKStartValue or PKEndValue.\"\r\n            })\r\n\r\n            continue\r\n\r\n        if barrier_end <= barrier_start:\r\n\r\n            invalid_segments.append({\r\n                \"ParentID\": barrier_id,\r\n                \"Reason\":\r\n                    \"PKEndValue must be greater than PKStartValue.\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Find intersections with corridor regions\r\n        # ----------------------------------------------------\r\n\r\n        generated_count = 0\r\n\r\n        covered_length = 0.0\r\n\r\n        for region in corridor_regions:\r\n\r\n            region_start = region[\"StartStation\"]\r\n            region_end = region[\"EndStation\"]\r\n\r\n            # Intersection of:\r\n            #\r\n            # [barrier_start, barrier_end]\r\n            #\r\n            # with\r\n            #\r\n            # [region_start, region_end]\r\n\r\n            segment_start = max(\r\n                barrier_start,\r\n                region_start\r\n            )\r\n\r\n            segment_end = min(\r\n                barrier_end,\r\n                region_end\r\n            )\r\n\r\n            # No overlap\r\n            if segment_end <= segment_start:\r\n                continue\r\n\r\n            segment_length = (\r\n                segment_end - segment_start\r\n            )\r\n\r\n            generated_count += 1\r\n            covered_length += segment_length\r\n\r\n            # ------------------------------------------------\r\n            # Unique segment ID\r\n            # ------------------------------------------------\r\n\r\n            segment_id = \"{}_S{:02d}\".format(\r\n                barrier_id,\r\n                generated_count\r\n            )\r\n\r\n            # ------------------------------------------------\r\n            # Create segment record\r\n            # ------------------------------------------------\r\n\r\n            segment_record = {\r\n\r\n                \"ID\": segment_id,\r\n\r\n                \"ParentID\": barrier_id,\r\n\r\n                \"SegmentIndex\":\r\n                    generated_count,\r\n\r\n                \"StartStation\":\r\n                    segment_start,\r\n\r\n                \"EndStation\":\r\n                    segment_end,\r\n\r\n                \"Length\":\r\n                    segment_length,\r\n\r\n                \"Side\":\r\n                    side,\r\n\r\n                \"Assembly\":\r\n                    region[\"Assembly\"],\r\n\r\n                \"RegionIndex\":\r\n                    region[\"RegionIndex\"],\r\n\r\n                # Keep complete parent data so later modules\r\n                # do not need to return to Excel.\r\n                \"ParentData\":\r\n                    barrier\r\n            }\r\n\r\n            barrier_segments.append(\r\n                segment_record\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # No intersecting region found\r\n        # ----------------------------------------------------\r\n\r\n        if generated_count == 0:\r\n\r\n            invalid_segments.append({\r\n                \"ParentID\": barrier_id,\r\n                \"StartStation\": barrier_start,\r\n                \"EndStation\": barrier_end,\r\n                \"Reason\":\r\n                    \"Barrier does not intersect any corridor region.\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Check whether complete barrier length was covered\r\n        # ----------------------------------------------------\r\n\r\n        original_length = (\r\n            barrier_end - barrier_start\r\n        )\r\n\r\n        difference = abs(\r\n            original_length - covered_length\r\n        )\r\n\r\n        if difference > 0.001:\r\n\r\n            warnings.append(\r\n                \"Barrier '{}': corridor regions cover \"\r\n                \"{:.3f} m of {:.3f} m. \"\r\n                \"Uncovered length = {:.3f} m.\"\r\n                .format(\r\n                    barrier_id,\r\n                    covered_length,\r\n                    original_length,\r\n                    difference\r\n                )\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Barrier summary\r\n        # ----------------------------------------------------\r\n\r\n        summary.append({\r\n            \"ParentID\":\r\n                barrier_id,\r\n\r\n            \"StartStation\":\r\n                barrier_start,\r\n\r\n            \"EndStation\":\r\n                barrier_end,\r\n\r\n            \"OriginalLength\":\r\n                original_length,\r\n\r\n            \"GeneratedSegments\":\r\n                generated_count,\r\n\r\n            \"CoveredLength\":\r\n                covered_length\r\n        })\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    barrier_segments,   # 0 - BarrierSegmentData\r\n    invalid_segments,   # 1 - InvalidSegments\r\n    warnings,           # 2 - Warnings\r\n    summary             # 3 - Summary\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8416ff98b9374301ba728e2cbcf6e823",
      "NodeType": "PythonScriptNode",
      "Inputs": [
