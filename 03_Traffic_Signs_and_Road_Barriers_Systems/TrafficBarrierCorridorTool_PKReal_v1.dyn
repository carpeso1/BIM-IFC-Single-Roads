    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - PREPARE_COORDINATE_INPUTS_V2\r\n#\r\n# IN[0] = Geometry station data\r\n# IN[1] = Post station data\r\n# IN[2] = Module station data\r\n#\r\n# OUT[0:3]   Geometry\r\n# OUT[4:7]   Posts\r\n# OUT[8:11]  Modules\r\n\r\n\r\ngeometry_data = IN[0]\r\npost_data = IN[1]\r\nmodule_data = IN[2]\r\n\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    try:\r\n        return float(\r\n            str(value).strip().replace(\",\", \".\")\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef extract(data):\r\n\r\n    stations = []\r\n    offsets = []\r\n    elevations = []\r\n    metadata = []\r\n\r\n    for item in as_list(data):\r\n\r\n        station = to_number(\r\n            get_value(item, \"Station\")\r\n        )\r\n\r\n        final_offset = to_number(\r\n            get_value(item, \"FinalOffset\")\r\n        )\r\n\r\n        elevation = to_number(\r\n            get_value(item, \"ReferenceElevation\")\r\n        )\r\n\r\n        if (\r\n            station is None\r\n            or final_offset is None\r\n            or elevation is None\r\n        ):\r\n            continue\r\n\r\n\r\n        stations.append(\r\n            station\r\n        )\r\n\r\n        offsets.append(\r\n            final_offset\r\n        )\r\n\r\n        elevations.append(\r\n            elevation\r\n        )\r\n\r\n\r\n        metadata.append({\r\n\r\n            \"ID\":\r\n                get_value(item, \"ID\"),\r\n\r\n            \"ParentID\":\r\n                get_value(item, \"ParentID\"),\r\n\r\n            \"Side\":\r\n                get_value(item, \"Side\"),\r\n\r\n            \"SectionType\":\r\n                get_value(item, \"SectionType\"),\r\n\r\n            \"ComponentType\":\r\n                get_value(item, \"ComponentType\"),\r\n\r\n            \"Station\":\r\n                station,\r\n\r\n            \"FinalOffset\":\r\n                final_offset,\r\n\r\n            \"ReferenceOffset\":\r\n                get_value(\r\n                    item,\r\n                    \"ReferenceOffset\"\r\n                ),\r\n\r\n            \"ReferenceFeatureLine\":\r\n                get_value(\r\n                    item,\r\n                    \"ReferenceFeatureLine\"\r\n                )\r\n        })\r\n\r\n\r\n    return (\r\n        stations,\r\n        offsets,\r\n        elevations,\r\n        metadata\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GEOMETRY\r\n# ============================================================\r\n\r\ng_sta, g_off, g_z, g_meta = extract(\r\n    geometry_data\r\n)\r\n\r\n\r\n# ============================================================\r\n# POSTS\r\n# ============================================================\r\n\r\np_sta, p_off, p_z, p_meta = extract(\r\n    post_data\r\n)\r\n\r\n\r\n# ============================================================\r\n# MODULES\r\n# ============================================================\r\n\r\nm_sta, m_off, m_z, m_meta = extract(\r\n    module_data\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n\r\n    # GEOMETRY\r\n    g_sta,    # 0\r\n    g_off,    # 1\r\n    g_z,      # 2\r\n    g_meta,   # 3\r\n\r\n    # POSTS\r\n    p_sta,    # 4\r\n    p_off,    # 5\r\n    p_z,      # 6\r\n    p_meta,   # 7\r\n\r\n    # MODULES\r\n    m_sta,    # 8\r\n    m_off,    # 9\r\n    m_z,      # 10\r\n    m_meta    # 11\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "4e640297d20f42be9c10b0836086179e",
