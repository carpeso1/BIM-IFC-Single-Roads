    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - BLOCK_PATH_RESOLVER\r\n#\r\n# IN[0] = Base block directory\r\n# IN[1] = Post block names\r\n# IN[2] = Module block names\r\n#\r\n# OUT[0] = Full DWG paths for posts\r\n# OUT[1] = Full DWG paths for modules\r\n# OUT[2] = Missing files\r\n# OUT[3] = Warnings\r\n\r\nimport os\r\n\r\nbase_directory = IN[0]\r\npost_names_input = IN[1]\r\nmodule_names_input = IN[2]\r\n\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n    return str(value).strip()\r\n\r\n\r\ndef resolve_directory(value):\r\n    \"\"\"\r\n    Handles normal string paths and Dynamo file/directory objects.\r\n    \"\"\"\r\n    if value is None:\r\n        return \"\"\r\n\r\n    try:\r\n        if hasattr(value, \"DirectoryName\"):\r\n            return clean_text(value.DirectoryName)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        if hasattr(value, \"FullName\"):\r\n            return clean_text(value.FullName)\r\n    except:\r\n        pass\r\n\r\n    return clean_text(value)\r\n\r\n\r\ndef normalize_block_name(value):\r\n    name = clean_text(value)\r\n\r\n    if name == \"\":\r\n        return \"\"\r\n\r\n    if name.lower().endswith(\".dwg\"):\r\n        return name\r\n\r\n    return name + \".dwg\"\r\n\r\n\r\ndef build_paths(names, base_dir, component_type):\r\n\r\n    paths = []\r\n    missing = []\r\n    warnings = []\r\n\r\n    for index, value in enumerate(names):\r\n\r\n        block_name = normalize_block_name(value)\r\n\r\n        if block_name == \"\":\r\n            paths.append(None)\r\n\r\n            warnings.append(\r\n                \"{} item {} has an empty BlockName.\"\r\n                .format(component_type, index)\r\n            )\r\n\r\n            continue\r\n\r\n        full_path = os.path.normpath(\r\n            os.path.join(\r\n                base_dir,\r\n                block_name\r\n            )\r\n        )\r\n\r\n        paths.append(full_path)\r\n\r\n        if not os.path.isfile(full_path):\r\n\r\n            missing.append({\r\n                \"ComponentType\": component_type,\r\n                \"Index\": index,\r\n                \"BlockName\": block_name,\r\n                \"Path\": full_path\r\n            })\r\n\r\n    return paths, missing, warnings\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUTS\r\n# ============================================================\r\n\r\nbase_dir = resolve_directory(\r\n    base_directory\r\n)\r\n\r\npost_names = as_list(\r\n    post_names_input\r\n)\r\n\r\nmodule_names = as_list(\r\n    module_names_input\r\n)\r\n\r\nmissing_files = []\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# VALIDATE BASE DIRECTORY\r\n# ============================================================\r\n\r\nif base_dir == \"\":\r\n\r\n    warnings.append(\r\n        \"Barrier block directory is empty.\"\r\n    )\r\n\r\nelif not os.path.isdir(base_dir):\r\n\r\n    warnings.append(\r\n        \"Barrier block directory does not exist: {}\"\r\n        .format(base_dir)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# POSTS\r\n# ============================================================\r\n\r\npost_paths, post_missing, post_warnings = build_paths(\r\n    post_names,\r\n    base_dir,\r\n    \"POST\"\r\n)\r\n\r\nmissing_files.extend(\r\n    post_missing\r\n)\r\n\r\nwarnings.extend(\r\n    post_warnings\r\n)\r\n\r\n\r\n# ============================================================\r\n# MODULES\r\n# ============================================================\r\n\r\nmodule_paths, module_missing, module_warnings = build_paths(\r\n    module_names,\r\n    base_dir,\r\n    \"MODULE\"\r\n)\r\n\r\nmissing_files.extend(\r\n    module_missing\r\n)\r\n\r\nwarnings.extend(\r\n    module_warnings\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    post_paths,      # 0\r\n    module_paths,    # 1\r\n    missing_files,   # 2\r\n    warnings         # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ee46b05c31da46a78fa880fe8e7e6302",
      "NodeType": "PythonScriptNode",
      "Inputs": [
