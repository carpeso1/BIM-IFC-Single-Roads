        }
      ],
      "Outputs": [
        {
          "Id": "90e2c056c83b4c0a8f0acda46458db1f",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(seg, 0)",
          "UsingDefaultValue": false,
