      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "seg[0];\nseg[1];\nseg[2];\nseg[3];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - SECTION_OFFSET_SOLVER_V2\r\n#\r\n# PURPOSE:\r\n# Adds section-dependent LEFT/RIGHT offsets to each barrier segment.\r\n#\r\n# IN[0] = BarrierSegmentData from SECTION_OFFSET_SOLVER_V1\r\n# IN[1] = Clean SectionTypeOffset data\r\n#\r\n# OUT[0] = Enriched BarrierSegmentData\r\n# OUT[1] = InvalidSegments\r\n# OUT[2] = Warnings\r\n# OUT[3] = Summary\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nsegment_data = IN[0]\r\nsection_offset_data = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    text = str(value)\r\n\r\n    text = text.replace(\"\\u00A0\", \" \")\r\n    text = text.replace(\"\\u200B\", \"\")\r\n    text = text.replace(\"\\ufeff\", \"\")\r\n    text = text.replace(\"\\r\", \"\")\r\n    text = text.replace(\"\\n\", \"\")\r\n\r\n    return text.strip()\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = clean_text(value).replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_dict_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef copy_dictionary(dictionary):\r\n    \"\"\"\r\n    Converts incoming Dynamo/Python dictionary into\r\n    a normal Python dictionary when possible.\r\n    \"\"\"\r\n    if dictionary is None:\r\n        return {}\r\n\r\n    if isinstance(dictionary, dict):\r\n        return dict(dictionary)\r\n\r\n    result = {}\r\n\r\n    try:\r\n        keys = dictionary.Keys\r\n\r\n        for key in keys:\r\n            result[str(key)] = dictionary.ValueAtKey(key)\r\n\r\n        return result\r\n\r\n    except Exception:\r\n        return result\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUTS\r\n# ============================================================\r\n\r\nsegments = as_list(segment_data)\r\nsection_offsets = as_list(section_offset_data)\r\n\r\nenriched_segments = []\r\ninvalid_segments = []\r\nwarnings = []\r\nsummary = []\r\n\r\n\r\n# ============================================================\r\n# BUILD SECTION OFFSET LOOKUP\r\n#\r\n# Key = SectionType / Assembly name\r\n#\r\n# Example:\r\n# ST_1 ->\r\n#   OffsetLeft  = 4.68\r\n#   OffsetRight = 4.68\r\n# ============================================================\r\n\r\nsection_lookup = {}\r\n\r\nfor index, record in enumerate(section_offsets):\r\n\r\n    section_type = clean_text(\r\n        get_dict_value(record, \"SectionType\")\r\n    ).upper()\r\n\r\n    baseline = clean_text(\r\n        get_dict_value(record, \"Baseline\")\r\n    )\r\n\r\n    offset_left = to_number(\r\n        get_dict_value(record, \"OffsetLeft\")\r\n    )\r\n\r\n    offset_right = to_number(\r\n        get_dict_value(record, \"OffsetRight\")\r\n    )\r\n\r\n    if section_type == \"\":\r\n\r\n        warnings.append(\r\n            \"SectionTypeOffset item {}: SectionType is empty.\"\r\n            .format(index)\r\n        )\r\n\r\n        continue\r\n\r\n    section_lookup[section_type] = {\r\n        \"Baseline\": baseline,\r\n        \"OffsetLeft\": offset_left,\r\n        \"OffsetRight\": offset_right\r\n    }\r\n\r\n\r\n# ============================================================\r\n# PROCESS BARRIER SEGMENTS\r\n# ============================================================\r\n\r\nfor index, segment in enumerate(segments):\r\n\r\n    parent_id = clean_text(\r\n        get_dict_value(segment, \"ParentID\")\r\n    )\r\n\r\n    segment_id = clean_text(\r\n        get_dict_value(segment, \"ID\")\r\n    )\r\n\r\n    assembly = clean_text(\r\n        get_dict_value(segment, \"Assembly\")\r\n    ).upper()\r\n\r\n    side = clean_text(\r\n        get_dict_value(segment, \"Side\")\r\n    ).upper()\r\n\r\n    start_station = to_number(\r\n        get_dict_value(segment, \"StartStation\")\r\n    )\r\n\r\n    end_station = to_number(\r\n        get_dict_value(segment, \"EndStation\")\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Validate basic segment data\r\n    # --------------------------------------------------------\r\n\r\n    row_errors = []\r\n\r\n    if assembly == \"\":\r\n        row_errors.append(\"Assembly is empty\")\r\n\r\n    if side not in [\"LEFT\", \"RIGHT\"]:\r\n        row_errors.append(\"invalid Side\")\r\n\r\n    if start_station is None:\r\n        row_errors.append(\"invalid StartStation\")\r\n\r\n    if end_station is None:\r\n        row_errors.append(\"invalid EndStation\")\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Find section offset record\r\n    # --------------------------------------------------------\r\n\r\n    section_record = section_lookup.get(\r\n        assembly\r\n    )\r\n\r\n    if section_record is None:\r\n\r\n        row_errors.append(\r\n            \"Assembly '{}' was not found in SectionTypeOffset\"\r\n            .format(assembly)\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Stop if invalid\r\n    # --------------------------------------------------------\r\n\r\n    if len(row_errors) > 0:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"ParentID\": parent_id,\r\n            \"Assembly\": assembly,\r\n            \"Side\": side,\r\n            \"Reason\": \"; \".join(row_errors)\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}' | Parent '{}': {}.\"\r\n            .format(\r\n                segment_id,\r\n                parent_id,\r\n                \"; \".join(row_errors)\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Select LEFT or RIGHT offset\r\n    # --------------------------------------------------------\r\n\r\n    if side == \"LEFT\":\r\n\r\n        selected_offset = section_record[\r\n            \"OffsetLeft\"\r\n        ]\r\n\r\n        offset_source = \"OffsetLeft\"\r\n\r\n    else:\r\n\r\n        selected_offset = section_record[\r\n            \"OffsetRight\"\r\n        ]\r\n\r\n        offset_source = \"OffsetRight\"\r\n\r\n\r\n    if selected_offset is None:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"ParentID\": parent_id,\r\n            \"Assembly\": assembly,\r\n            \"Side\": side,\r\n            \"Reason\":\r\n                \"{} is null or invalid.\"\r\n                .format(offset_source)\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}': {} for '{}' is invalid.\"\r\n            .format(\r\n                segment_id,\r\n                offset_source,\r\n                assembly\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Create enriched segment\r\n    # --------------------------------------------------------\r\n\r\n    enriched = copy_dictionary(segment)\r\n\r\n    enriched[\"SectionType\"] = assembly\r\n\r\n    enriched[\"SectionOffset\"] = selected_offset\r\n\r\n    enriched[\"OffsetSource\"] = offset_source\r\n\r\n    enriched[\"SectionBaseline\"] = section_record[\r\n        \"Baseline\"\r\n    ]\r\n\r\n    enriched_segments.append(\r\n        enriched\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Summary\r\n    # --------------------------------------------------------\r\n\r\n    summary.append({\r\n        \"ID\": segment_id,\r\n        \"ParentID\": parent_id,\r\n        \"SectionType\": assembly,\r\n        \"Side\": side,\r\n        \"StartStation\": start_station,\r\n        \"EndStation\": end_station,\r\n        \"SectionOffset\": selected_offset,\r\n        \"OffsetSource\": offset_source\r\n    })\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    enriched_segments,   # 0\r\n    invalid_segments,    # 1\r\n    warnings,            # 2\r\n    summary              # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a2573e3f60124b0a9a6a83c602a5c6ac",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
