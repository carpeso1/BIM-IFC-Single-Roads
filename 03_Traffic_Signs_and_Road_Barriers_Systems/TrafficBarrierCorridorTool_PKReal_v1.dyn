        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a number.",
      "InputValue": 1.0
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - GEOMETRY_OFFSET_SAMPLER_V2\r\n#\r\n# IN[0] = Segment data from BARRIER_STATION_GENERATOR_V2\r\n# IN[1] = LEFT ETW/EPS feature lines\r\n# IN[2] = RIGHT ETW/EPS feature lines\r\n#\r\n# OUT[0] = Enriched SegmentData\r\n# OUT[1] = Geometry station data\r\n# OUT[2] = Post station data\r\n# OUT[3] = Module station data\r\n# OUT[4] = Warnings\r\n\r\n\r\nsegment_data = IN[0]\r\nleft_feature_lines_input = IN[1]\r\nright_feature_lines_input = IN[2]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = str(value).strip().replace(\" \", \"\")\r\n    text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef get_dict_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef copy_dictionary(dictionary):\r\n    if dictionary is None:\r\n        return {}\r\n\r\n    if isinstance(dictionary, dict):\r\n        return dict(dictionary)\r\n\r\n    result = {}\r\n\r\n    try:\r\n        for key in dictionary.Keys:\r\n            result[str(key)] = dictionary.ValueAtKey(key)\r\n\r\n    except:\r\n        pass\r\n\r\n    return result\r\n\r\n\r\ndef get_result_value(result, key):\r\n    if result is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(result, dict):\r\n            return result.get(key)\r\n\r\n        if hasattr(result, \"ValueAtKey\"):\r\n            return result.ValueAtKey(key)\r\n\r\n        return result[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef feature_line_name(feature_line):\r\n    try:\r\n        return str(feature_line)\r\n\r\n    except:\r\n        return \"CorridorFeatureLine\"\r\n\r\n\r\n# ============================================================\r\n# SOLVE ONE STATION\r\n# ============================================================\r\n\r\ndef solve_station(\r\n    station,\r\n    side,\r\n    section_offset,\r\n    feature_lines\r\n):\r\n\r\n    candidates = []\r\n\r\n    for line_index, feature_line in enumerate(feature_lines):\r\n\r\n        if feature_line is None:\r\n            continue\r\n\r\n        try:\r\n\r\n            result = feature_line.OffsetElevationByStation(\r\n                station\r\n            )\r\n\r\n            reference_offset = to_number(\r\n                get_result_value(\r\n                    result,\r\n                    \"Offset\"\r\n                )\r\n            )\r\n\r\n            elevation = to_number(\r\n                get_result_value(\r\n                    result,\r\n                    \"Elevation\"\r\n                )\r\n            )\r\n\r\n            if reference_offset is None:\r\n                continue\r\n\r\n\r\n            # -----------------------------------------------\r\n            # Respect expected geometric side\r\n            # -----------------------------------------------\r\n\r\n            if (\r\n                side == \"LEFT\"\r\n                and reference_offset >= 0\r\n            ):\r\n                continue\r\n\r\n            if (\r\n                side == \"RIGHT\"\r\n                and reference_offset <= 0\r\n            ):\r\n                continue\r\n\r\n\r\n            candidates.append({\r\n\r\n                \"ReferenceOffset\":\r\n                    reference_offset,\r\n\r\n                \"ReferenceElevation\":\r\n                    elevation,\r\n\r\n                \"ReferenceFeatureLine\":\r\n                    feature_line_name(\r\n                        feature_line\r\n                    ),\r\n\r\n                \"ReferenceLineIndex\":\r\n                    line_index\r\n            })\r\n\r\n\r\n        except:\r\n            continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # No ETW/EPS available\r\n    # --------------------------------------------------------\r\n\r\n    if len(candidates) == 0:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Select outermost ETW/EPS\r\n    # --------------------------------------------------------\r\n\r\n    selected = max(\r\n        candidates,\r\n        key=lambda item:\r\n            abs(item[\"ReferenceOffset\"])\r\n    )\r\n\r\n\r\n    reference_offset = (\r\n        selected[\"ReferenceOffset\"]\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Apply additional SectionOffset outward\r\n    # --------------------------------------------------------\r\n\r\n    if side == \"LEFT\":\r\n\r\n        final_offset = (\r\n            reference_offset\r\n            - abs(section_offset)\r\n        )\r\n\r\n    else:\r\n\r\n        final_offset = (\r\n            reference_offset\r\n            + abs(section_offset)\r\n        )\r\n\r\n\r\n    return {\r\n\r\n        \"Station\":\r\n            station,\r\n\r\n        \"ReferenceOffset\":\r\n            reference_offset,\r\n\r\n        \"ReferenceElevation\":\r\n            selected[\"ReferenceElevation\"],\r\n\r\n        \"SectionOffset\":\r\n            section_offset,\r\n\r\n        \"FinalOffset\":\r\n            final_offset,\r\n\r\n        \"ReferenceFeatureLine\":\r\n            selected[\"ReferenceFeatureLine\"],\r\n\r\n        \"ReferenceLineIndex\":\r\n            selected[\"ReferenceLineIndex\"]\r\n    }\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nsegments = as_list(\r\n    segment_data\r\n)\r\n\r\nleft_feature_lines = as_list(\r\n    left_feature_lines_input\r\n)\r\n\r\nright_feature_lines = as_list(\r\n    right_feature_lines_input\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\nenriched_segments = []\r\n\r\ngeometry_station_data = []\r\n\r\npost_station_data = []\r\n\r\nmodule_station_data = []\r\n\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# PROCESS SEGMENTS\r\n# ============================================================\r\n\r\nfor segment in segments:\r\n\r\n    segment_id = clean_text(\r\n        get_dict_value(\r\n            segment,\r\n            \"ID\"\r\n        )\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_dict_value(\r\n            segment,\r\n            \"ParentID\"\r\n        )\r\n    )\r\n\r\n    side = clean_text(\r\n        get_dict_value(\r\n            segment,\r\n            \"Side\"\r\n        )\r\n    ).upper()\r\n\r\n    section_type = clean_text(\r\n        get_dict_value(\r\n            segment,\r\n            \"SectionType\"\r\n        )\r\n    )\r\n\r\n    section_offset = to_number(\r\n        get_dict_value(\r\n            segment,\r\n            \"SectionOffset\"\r\n        )\r\n    )\r\n\r\n\r\n    geometry_stations = as_list(\r\n        get_dict_value(\r\n            segment,\r\n            \"GeometryStations\"\r\n        )\r\n    )\r\n\r\n    post_stations = as_list(\r\n        get_dict_value(\r\n            segment,\r\n            \"PostStations\"\r\n        )\r\n    )\r\n\r\n    module_stations = as_list(\r\n        get_dict_value(\r\n            segment,\r\n            \"ModuleStations\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Select Feature Lines by Side\r\n    # --------------------------------------------------------\r\n\r\n    if side == \"LEFT\":\r\n\r\n        feature_lines = (\r\n            left_feature_lines\r\n        )\r\n\r\n    elif side == \"RIGHT\":\r\n\r\n        feature_lines = (\r\n            right_feature_lines\r\n        )\r\n\r\n    else:\r\n\r\n        warnings.append(\r\n            \"Segment '{}': invalid Side.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    if section_offset is None:\r\n\r\n        warnings.append(\r\n            \"Segment '{}': invalid SectionOffset.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # FUNCTION TO PROCESS A STATION COLLECTION\r\n    # ========================================================\r\n\r\n    def process_stations(\r\n        stations,\r\n        component_type\r\n    ):\r\n\r\n        results = []\r\n\r\n        for station_value in stations:\r\n\r\n            station = to_number(\r\n                station_value\r\n            )\r\n\r\n            if station is None:\r\n                continue\r\n\r\n\r\n            solved = solve_station(\r\n                station,\r\n                side,\r\n                section_offset,\r\n                feature_lines\r\n            )\r\n\r\n\r\n            if solved is None:\r\n\r\n                warnings.append(\r\n                    \"Segment '{}': no ETW/EPS reference \"\r\n                    \"at {} station {}.\"\r\n                    .format(\r\n                        segment_id,\r\n                        component_type,\r\n                        station\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            solved[\"ID\"] = segment_id\r\n\r\n            solved[\"ParentID\"] = parent_id\r\n\r\n            solved[\"Side\"] = side\r\n\r\n            solved[\r\n                \"SectionType\"\r\n            ] = section_type\r\n\r\n            solved[\r\n                \"ComponentType\"\r\n            ] = component_type\r\n\r\n\r\n            results.append(\r\n                solved\r\n            )\r\n\r\n\r\n        return results\r\n\r\n\r\n    # ========================================================\r\n    # GEOMETRY\r\n    # ========================================================\r\n\r\n    geometry_results = process_stations(\r\n        geometry_stations,\r\n        \"GEOMETRY\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # POSTS\r\n    # ========================================================\r\n\r\n    post_results = process_stations(\r\n        post_stations,\r\n        \"POST\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # MODULES\r\n    # ========================================================\r\n\r\n    module_results = process_stations(\r\n        module_stations,\r\n        \"MODULE\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FLAT OUTPUT LISTS\r\n    # ========================================================\r\n\r\n    geometry_station_data.extend(\r\n        geometry_results\r\n    )\r\n\r\n    post_station_data.extend(\r\n        post_results\r\n    )\r\n\r\n    module_station_data.extend(\r\n        module_results\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # ENRICH SEGMENT\r\n    # ========================================================\r\n\r\n    enriched = copy_dictionary(\r\n        segment\r\n    )\r\n\r\n    enriched[\r\n        \"GeometryOffsetData\"\r\n    ] = geometry_results\r\n\r\n    enriched[\r\n        \"PostOffsetData\"\r\n    ] = post_results\r\n\r\n    enriched[\r\n        \"ModuleOffsetData\"\r\n    ] = module_results\r\n\r\n\r\n    enriched[\r\n        \"ValidGeometryPointCount\"\r\n    ] = len(\r\n        geometry_results\r\n    )\r\n\r\n    enriched[\r\n        \"ValidPostPointCount\"\r\n    ] = len(\r\n        post_results\r\n    )\r\n\r\n    enriched[\r\n        \"ValidModulePointCount\"\r\n    ] = len(\r\n        module_results\r\n    )\r\n\r\n\r\n    enriched_segments.append(\r\n        enriched\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    enriched_segments,       # 0\r\n    geometry_station_data,   # 1\r\n    post_station_data,       # 2\r\n    module_station_data,     # 3\r\n    warnings                 # 4\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f07535da8f2d4dcbaba1d7f27cf7d2c5",
      "NodeType": "PythonScriptNode",
