        }
      ],
      "Outputs": [
        {
          "Id": "5077be8f6636436fa1ee24b56cfe04e2",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(v2, 0)",
          "UsingDefaultValue": false,
