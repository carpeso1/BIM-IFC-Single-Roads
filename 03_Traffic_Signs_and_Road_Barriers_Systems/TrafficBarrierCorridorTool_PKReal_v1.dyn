        {
          "Id": "f84ea2295b6f4f47a6fbb736e565f2f8",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(ref, 3)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "ref[0];\nref[1];\nref[2];\nref[3];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - BARRIER_STATION_GENERATOR_V2\r\n#\r\n# IN[0] = BarrierSegmentData from REFERENCE_OFFSET_SOLVER\r\n# IN[1] = GeometrySampling step\r\n#\r\n# OUT[0] = Enriched SegmentData\r\n# OUT[1] = Post station data\r\n# OUT[2] = Module station data\r\n# OUT[3] = Summary\r\n\r\n\r\nsegment_data = IN[0]\r\nsampling_step_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    try:\r\n        return float(str(value).replace(\",\", \".\"))\r\n    except:\r\n        return None\r\n\r\n\r\ndef get_dict_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef copy_dictionary(dictionary):\r\n    if dictionary is None:\r\n        return {}\r\n\r\n    if isinstance(dictionary, dict):\r\n        return dict(dictionary)\r\n\r\n    result = {}\r\n\r\n    try:\r\n        keys = dictionary.Keys\r\n\r\n        for key in keys:\r\n            result[str(key)] = dictionary.ValueAtKey(key)\r\n\r\n    except:\r\n        pass\r\n\r\n    return result\r\n\r\n\r\ndef generate_stations(start, end, step):\r\n    \"\"\"\r\n    Generates stations including start and end.\r\n    \"\"\"\r\n    stations = []\r\n\r\n    if step is None or step <= 0:\r\n        return stations\r\n\r\n    stations.append(round(start, 6))\r\n\r\n    current = start\r\n\r\n    while current + step < end:\r\n        current += step\r\n        stations.append(round(current, 6))\r\n\r\n    if abs(stations[-1] - end) > 1e-6:\r\n        stations.append(round(end, 6))\r\n\r\n    return stations\r\n\r\n\r\ndef generate_module_stations(start, end, module_length):\r\n    \"\"\"\r\n    Generates module insertion stations.\r\n    The stations represent module START positions.\r\n\r\n    Example:\r\n    start = 200\r\n    end = 210\r\n    module_length = 2\r\n\r\n    -> 200, 202, 204, 206, 208\r\n    \"\"\"\r\n\r\n    stations = []\r\n\r\n    if module_length is None or module_length <= 0:\r\n        return stations\r\n\r\n    current = start\r\n\r\n    while current < end - 1e-6:\r\n\r\n        stations.append(\r\n            round(current, 6)\r\n        )\r\n\r\n        current += module_length\r\n\r\n    return stations\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nsegments = as_list(segment_data)\r\n\r\nsampling_step = to_number(\r\n    sampling_step_input\r\n)\r\n\r\nif sampling_step is None or sampling_step <= 0:\r\n    sampling_step = 1.0\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\nenriched_segments = []\r\n\r\npost_station_data = []\r\n\r\nmodule_station_data = []\r\n\r\nsummary = []\r\n\r\n\r\n# ============================================================\r\n# PROCESS SEGMENTS\r\n# ============================================================\r\n\r\nfor segment in segments:\r\n\r\n    segment_id = clean_text(\r\n        get_dict_value(segment, \"ID\")\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_dict_value(segment, \"ParentID\")\r\n    )\r\n\r\n    start_station = to_number(\r\n        get_dict_value(\r\n            segment,\r\n            \"StartStation\"\r\n        )\r\n    )\r\n\r\n    end_station = to_number(\r\n        get_dict_value(\r\n            segment,\r\n            \"EndStation\"\r\n        )\r\n    )\r\n\r\n    parent_data = get_dict_value(\r\n        segment,\r\n        \"ParentData\"\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Read component parameters\r\n    # --------------------------------------------------------\r\n\r\n    post_spacing = to_number(\r\n        get_dict_value(\r\n            parent_data,\r\n            \"PostSpacing\"\r\n        )\r\n    )\r\n\r\n    module_length = to_number(\r\n        get_dict_value(\r\n            parent_data,\r\n            \"ModuleLength\"\r\n        )\r\n    )\r\n\r\n\r\n    if post_spacing is None:\r\n        post_spacing = 0.0\r\n\r\n    if module_length is None:\r\n        module_length = 0.0\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Validate segment\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        start_station is None\r\n        or end_station is None\r\n        or end_station <= start_station\r\n    ):\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # 1. GEOMETRY STATIONS\r\n    # ========================================================\r\n\r\n    geometry_stations = generate_stations(\r\n        start_station,\r\n        end_station,\r\n        sampling_step\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # 2. POST STATIONS\r\n    # ========================================================\r\n\r\n    if post_spacing > 0:\r\n\r\n        post_stations = generate_stations(\r\n            start_station,\r\n            end_station,\r\n            post_spacing\r\n        )\r\n\r\n    else:\r\n\r\n        post_stations = []\r\n\r\n\r\n    # ========================================================\r\n    # 3. MODULE STATIONS\r\n    # ========================================================\r\n\r\n    if module_length > 0:\r\n\r\n        module_stations = generate_module_stations(\r\n            start_station,\r\n            end_station,\r\n            module_length\r\n        )\r\n\r\n    else:\r\n\r\n        module_stations = []\r\n\r\n\r\n    # ========================================================\r\n    # ENRICH SEGMENT\r\n    # ========================================================\r\n\r\n    enriched = copy_dictionary(\r\n        segment\r\n    )\r\n\r\n    enriched[\r\n        \"GeometryStations\"\r\n    ] = geometry_stations\r\n\r\n    enriched[\r\n        \"PostStations\"\r\n    ] = post_stations\r\n\r\n    enriched[\r\n        \"ModuleStations\"\r\n    ] = module_stations\r\n\r\n    enriched[\r\n        \"GeometrySampling\"\r\n    ] = sampling_step\r\n\r\n    enriched[\r\n        \"PostSpacing\"\r\n    ] = post_spacing\r\n\r\n    enriched[\r\n        \"ModuleLength\"\r\n    ] = module_length\r\n\r\n    enriched[\r\n        \"PostCount\"\r\n    ] = len(post_stations)\r\n\r\n    enriched[\r\n        \"ModuleCount\"\r\n    ] = len(module_stations)\r\n\r\n\r\n    enriched_segments.append(\r\n        enriched\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # POST DATA\r\n    # ========================================================\r\n\r\n    if len(post_stations) > 0:\r\n\r\n        post_station_data.append({\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"PostStations\":\r\n                post_stations,\r\n\r\n            \"PostSpacing\":\r\n                post_spacing,\r\n\r\n            \"PostCount\":\r\n                len(post_stations)\r\n        })\r\n\r\n\r\n    # ========================================================\r\n    # MODULE DATA\r\n    # ========================================================\r\n\r\n    if len(module_stations) > 0:\r\n\r\n        module_station_data.append({\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"ModuleStations\":\r\n                module_stations,\r\n\r\n            \"ModuleLength\":\r\n                module_length,\r\n\r\n            \"ModuleCount\":\r\n                len(module_stations)\r\n        })\r\n\r\n\r\n    # ========================================================\r\n    # SUMMARY\r\n    # ========================================================\r\n\r\n    summary.append({\r\n\r\n        \"ID\":\r\n            segment_id,\r\n\r\n        \"ParentID\":\r\n            parent_id,\r\n\r\n        \"StartStation\":\r\n            start_station,\r\n\r\n        \"EndStation\":\r\n            end_station,\r\n\r\n        \"GeometryPointCount\":\r\n            len(geometry_stations),\r\n\r\n        \"PostSpacing\":\r\n            post_spacing,\r\n\r\n        \"PostCount\":\r\n            len(post_stations),\r\n\r\n        \"ModuleLength\":\r\n            module_length,\r\n\r\n        \"ModuleCount\":\r\n            len(module_stations)\r\n    })\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    enriched_segments,     # 0\r\n    post_station_data,     # 1\r\n    module_station_data,   # 2\r\n    summary                # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "547dbb3234e447d6886a564e6ea09b60",
      "NodeType": "PythonScriptNode",
      "Inputs": [
