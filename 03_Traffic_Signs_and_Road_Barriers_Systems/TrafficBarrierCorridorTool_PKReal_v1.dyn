          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSOffice.Data.OpenXMLImportExcel@string,string,int,int,bool",
      "Replication": "Auto",
      "Description": "Data.OpenXMLImportExcel (filePath: string, sheetName: string, startRow: int = 0, startColumn: int = 0, readAsString: bool = false): var[][]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - READ_VALIDATE_BARRIER_DATA_V3\r\n#\r\n# IN[0] = BARRIERS worksheet\r\n# IN[1] = SectionTypeOffset worksheet\r\n#\r\n# OUT[0] = Valid BarrierData\r\n# OUT[1] = Valid SectionTypeOffset\r\n# OUT[2] = InvalidRows\r\n# OUT[3] = Warnings\r\n\r\nimport re\r\n\r\nbarrier_data = IN[0]\r\nsection_data = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    text = str(value)\r\n\r\n    text = text.replace(\"\\u00A0\", \" \")\r\n    text = text.replace(\"\\u200B\", \"\")\r\n    text = text.replace(\"\\ufeff\", \"\")\r\n    text = text.replace(\"\\r\", \"\")\r\n    text = text.replace(\"\\n\", \"\")\r\n\r\n    return text.strip()\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = clean_text(value).replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    # Allows station labels such as 6+300.00\r\n    text = text.replace(\"+\", \"\")\r\n\r\n    # Decimal comma\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    # Keep only valid numeric characters\r\n    text = re.sub(r\"[^0-9.\\-]\", \"\", text)\r\n\r\n    try:\r\n        return float(text)\r\n    except:\r\n        return None\r\n\r\n\r\ndef norm_side(value):\r\n    text = clean_text(value).upper()\r\n\r\n    if text in [\r\n        \"LEFT\",\r\n        \"L\",\r\n        \"IZQUIERDA\",\r\n        \"IZQ\",\r\n        \"I\"\r\n    ]:\r\n        return \"LEFT\"\r\n\r\n    if text in [\r\n        \"RIGHT\",\r\n        \"R\",\r\n        \"DERECHA\",\r\n        \"DER\",\r\n        \"D\"\r\n    ]:\r\n        return \"RIGHT\"\r\n\r\n    return text\r\n\r\n\r\ndef is_empty_row(row):\r\n    if row is None:\r\n        return True\r\n\r\n    if not isinstance(row, (list, tuple)):\r\n        return True\r\n\r\n    for value in row:\r\n        if value is not None and clean_text(value) != \"\":\r\n            return False\r\n\r\n    return True\r\n\r\n\r\ndef is_barrier_header(row):\r\n    if row is None or len(row) == 0:\r\n        return False\r\n\r\n    return clean_text(row[0]).upper() == \"ID\"\r\n\r\n\r\ndef is_section_header(row):\r\n    if row is None or len(row) < 2:\r\n        return False\r\n\r\n    first = clean_text(row[0]).upper()\r\n    second = clean_text(row[1]).upper()\r\n\r\n    return (\r\n        first == \"BASELINE\"\r\n        or second in [\r\n            \"SECTIONTYPE\",\r\n            \"SECTION TYPE\"\r\n        ]\r\n    )\r\n\r\n\r\ndef pad_row(row, required_length):\r\n    \"\"\"\r\n    Completes short OpenXML rows with None.\r\n    Excel/OpenXML may omit trailing empty cells.\r\n    \"\"\"\r\n    if row is None:\r\n        return [None] * required_length\r\n\r\n    result = list(row)\r\n\r\n    if len(result) < required_length:\r\n        result += [None] * (\r\n            required_length - len(result)\r\n        )\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\nvalid_barriers = []\r\nclean_sections = []\r\n\r\ninvalid_rows = []\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# READ SECTIONTYPEOFFSET\r\n#\r\n# Expected useful columns:\r\n#\r\n# 0 Baseline\r\n# 1 SectionType\r\n# 2 OffsetLeft\r\n# 3 OffsetRight\r\n# ============================================================\r\n\r\nif section_data is None:\r\n    section_data = []\r\n\r\nfor idx, original_row in enumerate(section_data):\r\n\r\n    excel_row = idx + 2\r\n\r\n    if is_empty_row(original_row):\r\n        continue\r\n\r\n    if is_section_header(original_row):\r\n        continue\r\n\r\n    # Protect against omitted trailing cells\r\n    row = pad_row(\r\n        original_row,\r\n        4\r\n    )\r\n\r\n    baseline = clean_text(\r\n        row[0]\r\n    )\r\n\r\n    section_type = clean_text(\r\n        row[1]\r\n    )\r\n\r\n    offset_left = to_number(\r\n        row[2]\r\n    )\r\n\r\n    offset_right = to_number(\r\n        row[3]\r\n    )\r\n\r\n    errors = []\r\n\r\n    if baseline == \"\":\r\n        errors.append(\r\n            \"Baseline is empty\"\r\n        )\r\n\r\n    if section_type == \"\":\r\n        errors.append(\r\n            \"SectionType is empty\"\r\n        )\r\n\r\n    if offset_left is None:\r\n        errors.append(\r\n            \"invalid OffsetLeft\"\r\n        )\r\n\r\n    if offset_right is None:\r\n        errors.append(\r\n            \"invalid OffsetRight\"\r\n        )\r\n\r\n\r\n    if len(errors) > 0:\r\n\r\n        invalid_rows.append({\r\n            \"Source\":\r\n                \"SectionTypeOffset\",\r\n\r\n            \"Row\":\r\n                excel_row,\r\n\r\n            \"Data\":\r\n                list(original_row)\r\n        })\r\n\r\n        warnings.append(\r\n            \"SectionTypeOffset row {}: {}.\"\r\n            .format(\r\n                excel_row,\r\n                \"; \".join(errors)\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    clean_sections.append({\r\n\r\n        \"Baseline\":\r\n            baseline,\r\n\r\n        \"SectionType\":\r\n            section_type,\r\n\r\n        \"OffsetLeft\":\r\n            offset_left,\r\n\r\n        \"OffsetRight\":\r\n            offset_right\r\n    })\r\n\r\n\r\n# ============================================================\r\n# READ BARRIERS\r\n#\r\n# CURRENT DEFINITIVE ORDER\r\n#\r\n#  0 ID\r\n#  1 Side\r\n#  2 PKStartValue\r\n#  3 PKEndValue\r\n#  4 Offset\r\n#  5 Type\r\n#  6 PKStartLabel\r\n#  7 PKEndLabel\r\n#  8 BarrierFamily\r\n#  9 BarrierType\r\n# 10 BlockLinear\r\n# 11 BlockPost\r\n# 12 IFCEntity\r\n# 13 Material\r\n# 14 PostSpacing\r\n# 15 ModuleLength\r\n# 16 Height\r\n# 17 Width\r\n# 18 ContainmentLevel\r\n# 19 WorkingWidth\r\n# 20 Layer\r\n# 21 TimeUnitLength(h)\r\n# 22 CostUnitLength\r\n# 23 Notes\r\n#\r\n# OpenXML may return fewer than 24 cells if\r\n# trailing Excel cells are empty.\r\n# ============================================================\r\n\r\nif barrier_data is None:\r\n    barrier_data = []\r\n\r\nfor idx, original_row in enumerate(barrier_data):\r\n\r\n    excel_row = idx + 2\r\n\r\n    if is_empty_row(original_row):\r\n        continue\r\n\r\n    if is_barrier_header(original_row):\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # IMPORTANT FIX:\r\n    # Complete the row instead of rejecting it.\r\n    # ========================================================\r\n\r\n    row = pad_row(\r\n        original_row,\r\n        24\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # READ VALUES\r\n    # --------------------------------------------------------\r\n\r\n    barrier_id = clean_text(\r\n        row[0]\r\n    )\r\n\r\n    side = norm_side(\r\n        row[1]\r\n    )\r\n\r\n    pk_start = to_number(\r\n        row[2]\r\n    )\r\n\r\n    pk_end = to_number(\r\n        row[3]\r\n    )\r\n\r\n    default_offset = to_number(\r\n        row[4]\r\n    )\r\n\r\n    type_code = clean_text(\r\n        row[5]\r\n    )\r\n\r\n    pk_start_label = clean_text(\r\n        row[6]\r\n    )\r\n\r\n    pk_end_label = clean_text(\r\n        row[7]\r\n    )\r\n\r\n    barrier_family = clean_text(\r\n        row[8]\r\n    )\r\n\r\n    barrier_type = clean_text(\r\n        row[9]\r\n    )\r\n\r\n    block_linear = clean_text(\r\n        row[10]\r\n    )\r\n\r\n    block_post = clean_text(\r\n        row[11]\r\n    )\r\n\r\n    ifc_entity = clean_text(\r\n        row[12]\r\n    )\r\n\r\n    material = clean_text(\r\n        row[13]\r\n    )\r\n\r\n    post_spacing = to_number(\r\n        row[14]\r\n    )\r\n\r\n    module_length = to_number(\r\n        row[15]\r\n    )\r\n\r\n    height = to_number(\r\n        row[16]\r\n    )\r\n\r\n    width = to_number(\r\n        row[17]\r\n    )\r\n\r\n    containment_level = clean_text(\r\n        row[18]\r\n    )\r\n\r\n    working_width = clean_text(\r\n        row[19]\r\n    )\r\n\r\n    layer = clean_text(\r\n        row[20]\r\n    )\r\n\r\n    time_unit_length = to_number(\r\n        row[21]\r\n    )\r\n\r\n    cost_unit_length = to_number(\r\n        row[22]\r\n    )\r\n\r\n    notes = clean_text(\r\n        row[23]\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DEFAULT VALUES\r\n    #\r\n    # 0 means that component is not applicable.\r\n    # --------------------------------------------------------\r\n\r\n    if post_spacing is None:\r\n        post_spacing = 0.0\r\n\r\n    if module_length is None:\r\n        module_length = 0.0\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # VALIDATION\r\n    # --------------------------------------------------------\r\n\r\n    errors = []\r\n\r\n\r\n    if barrier_id == \"\":\r\n        errors.append(\r\n            \"ID is empty\"\r\n        )\r\n\r\n\r\n    if side not in [\r\n        \"LEFT\",\r\n        \"RIGHT\"\r\n    ]:\r\n        errors.append(\r\n            \"invalid Side\"\r\n        )\r\n\r\n\r\n    if pk_start is None:\r\n        errors.append(\r\n            \"invalid PKStartValue\"\r\n        )\r\n\r\n\r\n    if pk_end is None:\r\n        errors.append(\r\n            \"invalid PKEndValue\"\r\n        )\r\n\r\n\r\n    if (\r\n        pk_start is not None\r\n        and pk_end is not None\r\n        and pk_end <= pk_start\r\n    ):\r\n        errors.append(\r\n            \"PKEndValue must be greater than PKStartValue\"\r\n        )\r\n\r\n\r\n    if type_code == \"\":\r\n        errors.append(\r\n            \"Type is empty\"\r\n        )\r\n\r\n\r\n    if height is None:\r\n        errors.append(\r\n            \"invalid Height\"\r\n        )\r\n\r\n\r\n    if width is None:\r\n        errors.append(\r\n            \"invalid Width\"\r\n        )\r\n\r\n\r\n    if post_spacing < 0:\r\n        errors.append(\r\n            \"PostSpacing cannot be negative\"\r\n        )\r\n\r\n\r\n    if module_length < 0:\r\n        errors.append(\r\n            \"ModuleLength cannot be negative\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COMPONENT CONSISTENCY\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        post_spacing > 0\r\n        and block_post == \"\"\r\n    ):\r\n        errors.append(\r\n            \"PostSpacing > 0 but BlockPost is empty\"\r\n        )\r\n\r\n\r\n    if (\r\n        module_length > 0\r\n        and block_linear == \"\"\r\n    ):\r\n        errors.append(\r\n            \"ModuleLength > 0 but BlockLinear is empty\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # INVALID ROW\r\n    # --------------------------------------------------------\r\n\r\n    if len(errors) > 0:\r\n\r\n        invalid_rows.append({\r\n\r\n            \"Source\":\r\n                \"BARRIERS\",\r\n\r\n            \"Row\":\r\n                excel_row,\r\n\r\n            \"ID\":\r\n                barrier_id,\r\n\r\n            \"Data\":\r\n                list(original_row)\r\n        })\r\n\r\n\r\n        warnings.append(\r\n            \"BARRIERS row {} | ID '{}': {}.\"\r\n            .format(\r\n                excel_row,\r\n                barrier_id,\r\n                \"; \".join(errors)\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COMPONENT LOGIC\r\n    # --------------------------------------------------------\r\n\r\n    has_posts = (\r\n        post_spacing > 0\r\n    )\r\n\r\n    has_modules = (\r\n        module_length > 0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STRUCTURED RECORD\r\n    # --------------------------------------------------------\r\n\r\n    record = {\r\n\r\n        \"ID\":\r\n            barrier_id,\r\n\r\n        \"Side\":\r\n            side,\r\n\r\n        \"PKStartValue\":\r\n            pk_start,\r\n\r\n        \"PKEndValue\":\r\n            pk_end,\r\n\r\n        \"DefaultOffset\":\r\n            default_offset,\r\n\r\n        \"Type\":\r\n            type_code,\r\n\r\n        \"PKStartLabel\":\r\n            pk_start_label,\r\n\r\n        \"PKEndLabel\":\r\n            pk_end_label,\r\n\r\n        \"BarrierFamily\":\r\n            barrier_family,\r\n\r\n        \"BarrierType\":\r\n            barrier_type,\r\n\r\n        \"BlockLinear\":\r\n            block_linear,\r\n\r\n        \"BlockPost\":\r\n            block_post,\r\n\r\n        \"IFCEntity\":\r\n            ifc_entity,\r\n\r\n        \"Material\":\r\n            material,\r\n\r\n        \"PostSpacing\":\r\n            post_spacing,\r\n\r\n        \"ModuleLength\":\r\n            module_length,\r\n\r\n        \"HasPosts\":\r\n            has_posts,\r\n\r\n        \"HasModules\":\r\n            has_modules,\r\n\r\n        \"Height\":\r\n            height,\r\n\r\n        \"Width\":\r\n            width,\r\n\r\n        \"ContainmentLevel\":\r\n            containment_level,\r\n\r\n        \"WorkingWidth\":\r\n            working_width,\r\n\r\n        \"Layer\":\r\n            layer,\r\n\r\n        \"TimeUnitLength(h)\":\r\n            time_unit_length,\r\n\r\n        \"CostUnitLength\":\r\n            cost_unit_length,\r\n\r\n        \"Notes\":\r\n            notes,\r\n\r\n        # Store the normalized 24-column row\r\n        \"SourceRow\":\r\n            list(row[:24])\r\n    }\r\n\r\n\r\n    valid_barriers.append(\r\n        record\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    valid_barriers,   # 0 - BarrierData\r\n    clean_sections,   # 1 - SectionTypeOffset\r\n    invalid_rows,     # 2 - Invalid rows\r\n    warnings          # 3 - Warnings\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "dc29df57cce442229f00106b2e517ff1",
      "NodeType": "PythonScriptNode",
      "Inputs": [
