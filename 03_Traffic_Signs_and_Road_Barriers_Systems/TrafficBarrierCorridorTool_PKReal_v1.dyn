        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "v2[0];\nv2[1];\nv2[2];\nv2[3];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - REFERENCE_OFFSET_SOLVER\r\n#\r\n# PURPOSE:\r\n# For each barrier segment:\r\n#   1. Reads Side (LEFT / RIGHT)\r\n#   2. Selects the corresponding Feature Line collection\r\n#   3. Evaluates ETW/EPS at the segment StartStation\r\n#   4. Selects the outermost valid reference\r\n#   5. Applies the SectionOffset outward\r\n#\r\n# IN[0] = BarrierSegmentData from SECTION_OFFSET_SOLVER_V2\r\n# IN[1] = LEFT corridor feature lines (ETW/EPS)\r\n# IN[2] = RIGHT corridor feature lines (ETW/EPS)\r\n#\r\n# OUT[0] = Enriched BarrierSegmentData\r\n# OUT[1] = InvalidSegments\r\n# OUT[2] = Warnings\r\n# OUT[3] = Summary\r\n\r\n\r\nsegment_data = IN[0]\r\nleft_feature_lines_input = IN[1]\r\nright_feature_lines_input = IN[2]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    text = str(value)\r\n\r\n    text = text.replace(\"\\u00A0\", \" \")\r\n    text = text.replace(\"\\u200B\", \"\")\r\n    text = text.replace(\"\\ufeff\", \"\")\r\n    text = text.replace(\"\\r\", \"\")\r\n    text = text.replace(\"\\n\", \"\")\r\n\r\n    return text.strip()\r\n\r\n\r\ndef to_number(value):\r\n    if value is None:\r\n        return None\r\n\r\n    if isinstance(value, (int, float)):\r\n        return float(value)\r\n\r\n    text = clean_text(value).replace(\" \", \"\")\r\n\r\n    if text == \"\":\r\n        return None\r\n\r\n    text = text.replace(\"+\", \"\")\r\n\r\n    if \",\" in text and \".\" not in text:\r\n        text = text.replace(\",\", \".\")\r\n\r\n    try:\r\n        return float(text)\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef get_dict_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef copy_dictionary(dictionary):\r\n    if dictionary is None:\r\n        return {}\r\n\r\n    if isinstance(dictionary, dict):\r\n        return dict(dictionary)\r\n\r\n    result = {}\r\n\r\n    try:\r\n        keys = dictionary.Keys\r\n\r\n        for key in keys:\r\n            result[str(key)] = dictionary.ValueAtKey(key)\r\n\r\n    except Exception:\r\n        pass\r\n\r\n    return result\r\n\r\n\r\ndef get_value(result, key):\r\n    \"\"\"\r\n    Reads Offset or Elevation from the dictionary returned by\r\n    CorridorFeatureLine.OffsetElevationByStation().\r\n    \"\"\"\r\n    if result is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(result, dict):\r\n            return result.get(key)\r\n\r\n        if hasattr(result, \"ValueAtKey\"):\r\n            return result.ValueAtKey(key)\r\n\r\n        return result[key]\r\n\r\n    except Exception:\r\n        return None\r\n\r\n\r\ndef feature_line_label(feature_line):\r\n    if feature_line is None:\r\n        return \"\"\r\n\r\n    try:\r\n        return str(feature_line)\r\n\r\n    except Exception:\r\n        return \"CorridorFeatureLine\"\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUTS\r\n# ============================================================\r\n\r\nsegments = as_list(segment_data)\r\n\r\nleft_feature_lines = as_list(\r\n    left_feature_lines_input\r\n)\r\n\r\nright_feature_lines = as_list(\r\n    right_feature_lines_input\r\n)\r\n\r\nenriched_segments = []\r\ninvalid_segments = []\r\nwarnings = []\r\nsummary = []\r\n\r\n\r\n# ============================================================\r\n# PROCESS SEGMENTS\r\n# ============================================================\r\n\r\nfor index, segment in enumerate(segments):\r\n\r\n    segment_id = clean_text(\r\n        get_dict_value(segment, \"ID\")\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_dict_value(segment, \"ParentID\")\r\n    )\r\n\r\n    side = clean_text(\r\n        get_dict_value(segment, \"Side\")\r\n    ).upper()\r\n\r\n    start_station = to_number(\r\n        get_dict_value(segment, \"StartStation\")\r\n    )\r\n\r\n    section_offset = to_number(\r\n        get_dict_value(segment, \"SectionOffset\")\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Basic validation\r\n    # --------------------------------------------------------\r\n\r\n    errors = []\r\n\r\n    if start_station is None:\r\n        errors.append(\"invalid StartStation\")\r\n\r\n    if section_offset is None:\r\n        errors.append(\"invalid SectionOffset\")\r\n\r\n    if side not in [\"LEFT\", \"RIGHT\"]:\r\n        errors.append(\"invalid Side\")\r\n\r\n    if len(errors) > 0:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"ParentID\": parent_id,\r\n            \"Reason\": \"; \".join(errors)\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}': {}.\"\r\n            .format(\r\n                segment_id,\r\n                \"; \".join(errors)\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Select Feature Lines according to Side\r\n    # --------------------------------------------------------\r\n\r\n    if side == \"LEFT\":\r\n\r\n        feature_lines = left_feature_lines\r\n\r\n    else:\r\n\r\n        feature_lines = right_feature_lines\r\n\r\n\r\n    if len(feature_lines) == 0:\r\n\r\n        invalid_segments.append({\r\n            \"ID\": segment_id,\r\n            \"ParentID\": parent_id,\r\n            \"Side\": side,\r\n            \"Reason\":\r\n                \"No feature lines were received for this side.\"\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}': no {} feature lines were received.\"\r\n            .format(\r\n                segment_id,\r\n                side\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Evaluate ETW / EPS candidates\r\n    # --------------------------------------------------------\r\n\r\n    candidates = []\r\n\r\n    for line_index, feature_line in enumerate(feature_lines):\r\n\r\n        if feature_line is None:\r\n            continue\r\n\r\n        try:\r\n\r\n            result = feature_line.OffsetElevationByStation(\r\n                start_station\r\n            )\r\n\r\n            offset = to_number(\r\n                get_value(result, \"Offset\")\r\n            )\r\n\r\n            elevation = to_number(\r\n                get_value(result, \"Elevation\")\r\n            )\r\n\r\n            if offset is None:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Verify geometric side\r\n            # ------------------------------------------------\r\n\r\n            if side == \"LEFT\" and offset >= 0:\r\n                continue\r\n\r\n            if side == \"RIGHT\" and offset <= 0:\r\n                continue\r\n\r\n\r\n            candidates.append({\r\n                \"LineIndex\":\r\n                    line_index,\r\n\r\n                \"FeatureLine\":\r\n                    feature_line,\r\n\r\n                \"FeatureLineLabel\":\r\n                    feature_line_label(\r\n                        feature_line\r\n                    ),\r\n\r\n                \"ReferenceOffset\":\r\n                    offset,\r\n\r\n                \"ReferenceElevation\":\r\n                    elevation\r\n            })\r\n\r\n\r\n        except Exception:\r\n            # Feature line may not exist in this region/station\r\n            continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # No valid reference\r\n    # --------------------------------------------------------\r\n\r\n    if len(candidates) == 0:\r\n\r\n        invalid_segments.append({\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"StartStation\":\r\n                start_station,\r\n\r\n            \"Side\":\r\n                side,\r\n\r\n            \"Reason\":\r\n                \"No valid ETW/EPS reference was found.\"\r\n        })\r\n\r\n        warnings.append(\r\n            \"Segment '{}': no valid ETW/EPS reference \"\r\n            \"was found at station {}.\"\r\n            .format(\r\n                segment_id,\r\n                start_station\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Select outermost ETW/EPS\r\n    # --------------------------------------------------------\r\n\r\n    selected = max(\r\n        candidates,\r\n        key=lambda item:\r\n            abs(item[\"ReferenceOffset\"])\r\n    )\r\n\r\n    reference_offset = selected[\r\n        \"ReferenceOffset\"\r\n    ]\r\n\r\n    reference_elevation = selected[\r\n        \"ReferenceElevation\"\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Apply SectionOffset outward\r\n    # --------------------------------------------------------\r\n\r\n    if side == \"LEFT\":\r\n        direction = -1.0\r\n    else:\r\n        direction = 1.0\r\n\r\n\r\n    final_offset = (\r\n        reference_offset\r\n        + direction * abs(section_offset)\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Enrich SegmentData\r\n    # --------------------------------------------------------\r\n\r\n    enriched = copy_dictionary(segment)\r\n\r\n    enriched[\"ReferenceOffset\"] = (\r\n        reference_offset\r\n    )\r\n\r\n    enriched[\"ReferenceElevation\"] = (\r\n        reference_elevation\r\n    )\r\n\r\n    enriched[\"FinalOffset\"] = (\r\n        final_offset\r\n    )\r\n\r\n    enriched[\"ReferenceFeatureLine\"] = (\r\n        selected[\"FeatureLineLabel\"]\r\n    )\r\n\r\n    enriched[\"ReferenceLineIndex\"] = (\r\n        selected[\"LineIndex\"]\r\n    )\r\n\r\n    enriched[\"ReferenceSide\"] = side\r\n\r\n\r\n    enriched_segments.append(\r\n        enriched\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Summary\r\n    # --------------------------------------------------------\r\n\r\n    summary.append({\r\n\r\n        \"ID\":\r\n            segment_id,\r\n\r\n        \"ParentID\":\r\n            parent_id,\r\n\r\n        \"StartStation\":\r\n            start_station,\r\n\r\n        \"Side\":\r\n            side,\r\n\r\n        \"ReferenceOffset\":\r\n            reference_offset,\r\n\r\n        \"SectionOffset\":\r\n            section_offset,\r\n\r\n        \"FinalOffset\":\r\n            final_offset,\r\n\r\n        \"ReferenceFeatureLine\":\r\n            selected[\"FeatureLineLabel\"]\r\n    })\r\n\r\n\r\n# ============================================================\r\n# OUTPUTS\r\n# ============================================================\r\n\r\nOUT = (\r\n    enriched_segments,   # 0\r\n    invalid_segments,    # 1\r\n    warnings,            # 2\r\n    summary              # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8d941d6320f740bdbfa9becac898ef9b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "58bba5ba22ea4cceafe594d272f39c48",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "82aedb6cd17b4c109ee599cdc423a5fa",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "02be7a2c0f174b93a328cbd861c6dd44",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4d4c3314cb8f43018e827c90b13d17bb",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "bd6f68e0dea64ecaa25d559edfe4aef0",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "317a8a0caea74660a776ba8185db09d4",
          "Name": "ref",
          "Description": "ref",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5558a6c4112a4bcdac61fcd6ee02b149",
          "Name": "function",
          "Description": "DesignScript.Builtin.Get.ValueAtIndex(ref, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "eaad2346d91d4852a9a70b1b4388419f",
