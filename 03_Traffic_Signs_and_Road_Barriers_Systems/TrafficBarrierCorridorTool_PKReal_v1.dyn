    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# POST_ORIENTATION_GENERATOR_V2\r\n# CPython3 - Dynamo / Civil 3D\r\n#\r\n# PURPOSE\r\n# Calculates the rotation of vertical barrier components\r\n# (posts, plates and bolts) according to alignment direction\r\n# and barrier side.\r\n#\r\n# BLOCK STANDARD:\r\n# BLOCK_POST_BM_STD is modeled in its base orientation.\r\n#\r\n# RIGHT → tangent + 90°  (counterclockwise)\r\n# LEFT  → tangent - 90°  (clockwise)\r\n#\r\n# IN[0] = CoordinateSystems at post positions\r\n# IN[1] = Post Metadata\r\n#\r\n# OUT[0] = Rotation angles [radians]\r\n# OUT[1] = Orientation metadata\r\n# OUT[2] = Warnings\r\n# ============================================================\r\n\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ncoordinate_systems_input = IN[0]\r\npost_metadata_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n\r\n        result = []\r\n\r\n        for item in value:\r\n\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef normalize_angle(angle):\r\n\r\n    \"\"\"\r\n    Normalizes angle between 0 and 2*pi.\r\n    \"\"\"\r\n\r\n    return angle % (2.0 * math.pi)\r\n\r\n\r\n# ============================================================\r\n# PREPARE INPUTS\r\n# ============================================================\r\n\r\ncoordinate_systems = as_list(\r\n    coordinate_systems_input\r\n)\r\n\r\npost_metadata = as_list(\r\n    post_metadata_input\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT COLLECTIONS\r\n# ============================================================\r\n\r\nrotation_angles = []\r\norientation_data = []\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# CHECK LIST LENGTH\r\n# ============================================================\r\n\r\ncount = min(\r\n    len(coordinate_systems),\r\n    len(post_metadata)\r\n)\r\n\r\n\r\nif len(coordinate_systems) != len(post_metadata):\r\n\r\n    warnings.append(\r\n        \"CoordinateSystem count ({}) differs from \"\r\n        \"Post Metadata count ({}).\"\r\n        .format(\r\n            len(coordinate_systems),\r\n            len(post_metadata)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PROCESS POSTS\r\n# ============================================================\r\n\r\nfor index in range(count):\r\n\r\n    cs = coordinate_systems[index]\r\n    meta = post_metadata[index]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # METADATA\r\n    # --------------------------------------------------------\r\n\r\n    segment_id = clean_text(\r\n        get_value(\r\n            meta,\r\n            \"ID\"\r\n        )\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_value(\r\n            meta,\r\n            \"ParentID\"\r\n        )\r\n    )\r\n\r\n    station = get_value(\r\n        meta,\r\n        \"Station\"\r\n    )\r\n\r\n    side = clean_text(\r\n        get_value(\r\n            meta,\r\n            \"Side\"\r\n        )\r\n    ).upper()\r\n\r\n    section_type = clean_text(\r\n        get_value(\r\n            meta,\r\n            \"SectionType\"\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # VALIDATE SIDE\r\n    # --------------------------------------------------------\r\n\r\n    if side not in [\r\n        \"LEFT\",\r\n        \"RIGHT\"\r\n    ]:\r\n\r\n        rotation_angles.append(\r\n            None\r\n        )\r\n\r\n        warnings.append(\r\n            \"Post {} | Segment '{}': invalid Side '{}'.\"\r\n            .format(\r\n                index,\r\n                segment_id,\r\n                side\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    try:\r\n\r\n        # ====================================================\r\n        # ALIGNMENT TANGENT\r\n        # ====================================================\r\n\r\n        x_axis = cs.XAxis\r\n\r\n        x = float(\r\n            x_axis.X\r\n        )\r\n\r\n        y = float(\r\n            x_axis.Y\r\n        )\r\n\r\n\r\n        tangent_angle = math.atan2(\r\n            y,\r\n            x\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # POST ORIENTATION\r\n        #\r\n        # RIGHT\r\n        #   +90 degrees counterclockwise\r\n        #\r\n        # LEFT\r\n        #   -90 degrees clockwise\r\n        # ====================================================\r\n\r\n        if side == \"RIGHT\":\r\n\r\n            rotation_angle = (\r\n                tangent_angle\r\n                + math.pi / 2.0\r\n            )\r\n\r\n\r\n        elif side == \"LEFT\":\r\n\r\n            rotation_angle = (\r\n                tangent_angle\r\n                - math.pi / 2.0\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # NORMALIZE ANGLE\r\n        # ====================================================\r\n\r\n        rotation_angle = normalize_angle(\r\n            rotation_angle\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # OUTPUT ANGLE\r\n        # ====================================================\r\n\r\n        rotation_angles.append(\r\n            rotation_angle\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # ENRICHED METADATA\r\n        # ====================================================\r\n\r\n        orientation_data.append({\r\n\r\n            \"PostIndex\":\r\n                index,\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"Station\":\r\n                station,\r\n\r\n            \"Side\":\r\n                side,\r\n\r\n            \"SectionType\":\r\n                section_type,\r\n\r\n            \"TangentAngle\":\r\n                tangent_angle,\r\n\r\n            \"TangentAngleDeg\":\r\n                math.degrees(\r\n                    tangent_angle\r\n                ),\r\n\r\n            \"RotationAngle\":\r\n                rotation_angle,\r\n\r\n            \"RotationAngleDeg\":\r\n                math.degrees(\r\n                    rotation_angle\r\n                ),\r\n\r\n            \"RotationRule\":\r\n                (\r\n                    \"Tangent + 90 deg CCW\"\r\n                    if side == \"RIGHT\"\r\n                    else\r\n                    \"Tangent - 90 deg CW\"\r\n                )\r\n        })\r\n\r\n\r\n    except Exception as error:\r\n\r\n        rotation_angles.append(\r\n            None\r\n        )\r\n\r\n        warnings.append(\r\n            \"Post {} | Segment '{}': {}\"\r\n            .format(\r\n                index,\r\n                segment_id,\r\n                str(error)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    rotation_angles,      # 0\r\n    orientation_data,     # 1\r\n    warnings              # 2\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ea79c74eef06480d9b0892f3712c9f76",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "dc4ac5a6293d4a3fbc3bffd9f572c8be",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "48998f4154384c3fbe7db0108658f48e",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "9091660fa7f44253959bb12f04af93de",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "8cda43103e174fbfbbef9d516a735a3b",
      "NodeType": "CodeBlockNode",
      "Inputs": [
