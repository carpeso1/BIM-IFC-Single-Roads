          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.Flatten@var[]..[],int",
      "Replication": "Auto",
      "Description": "Flattens a nested list of lists by a certain amount.\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CPython3 - COMPONENT_BLOCK_SELECTOR\r\n#\r\n# IN[0] = Enriched SegmentData\r\n# IN[1] = Post metadata\r\n# IN[2] = Module metadata\r\n#\r\n# OUT[0] = Post block names aligned with post points\r\n# OUT[1] = Module block names aligned with module points\r\n# OUT[2] = Linear block information by segment\r\n# OUT[3] = Warnings\r\n\r\n\r\nsegment_data = IN[0]\r\npost_metadata = IN[1]\r\nmodule_metadata = IN[2]\r\n\r\n\r\n# ============================================================\r\n# AUXILIARY FUNCTIONS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n        result = []\r\n\r\n        for item in value:\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef get_value(dictionary, key):\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef clean_text(value):\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\nsegments = as_list(segment_data)\r\npost_meta = as_list(post_metadata)\r\nmodule_meta = as_list(module_metadata)\r\n\r\nwarnings = []\r\n\r\n\r\n# ============================================================\r\n# BUILD SEGMENT LOOKUP\r\n#\r\n# ID → component properties\r\n# ============================================================\r\n\r\nsegment_lookup = {}\r\n\r\n\r\nfor segment in segments:\r\n\r\n    segment_id = clean_text(\r\n        get_value(segment, \"ID\")\r\n    )\r\n\r\n    parent_data = get_value(\r\n        segment,\r\n        \"ParentData\"\r\n    )\r\n\r\n    if segment_id == \"\":\r\n        continue\r\n\r\n\r\n    block_post = clean_text(\r\n        get_value(\r\n            parent_data,\r\n            \"BlockPost\"\r\n        )\r\n    )\r\n\r\n    block_linear = clean_text(\r\n        get_value(\r\n            parent_data,\r\n            \"BlockLinear\"\r\n        )\r\n    )\r\n\r\n    barrier_type = clean_text(\r\n        get_value(\r\n            parent_data,\r\n            \"Type\"\r\n        )\r\n    )\r\n\r\n    post_spacing = get_value(\r\n        parent_data,\r\n        \"PostSpacing\"\r\n    )\r\n\r\n    module_length = get_value(\r\n        parent_data,\r\n        \"ModuleLength\"\r\n    )\r\n\r\n\r\n    segment_lookup[segment_id] = {\r\n\r\n        \"BlockPost\":\r\n            block_post,\r\n\r\n        \"BlockLinear\":\r\n            block_linear,\r\n\r\n        \"Type\":\r\n            barrier_type,\r\n\r\n        \"PostSpacing\":\r\n            post_spacing,\r\n\r\n        \"ModuleLength\":\r\n            module_length\r\n    }\r\n\r\n\r\n# ============================================================\r\n# POSTS\r\n# ============================================================\r\n\r\npost_block_names = []\r\n\r\n\r\nfor item in post_meta:\r\n\r\n    segment_id = clean_text(\r\n        get_value(item, \"ID\")\r\n    )\r\n\r\n    info = segment_lookup.get(\r\n        segment_id\r\n    )\r\n\r\n\r\n    if info is None:\r\n\r\n        post_block_names.append(\"\")\r\n\r\n        warnings.append(\r\n            \"Post point for segment '{}' has no segment data.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    block_name = info[\r\n        \"BlockPost\"\r\n    ]\r\n\r\n\r\n    if block_name == \"\":\r\n\r\n        warnings.append(\r\n            \"Segment '{}' generates posts but BlockPost is empty.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n\r\n    post_block_names.append(\r\n        block_name\r\n    )\r\n\r\n\r\n# ============================================================\r\n# MODULES\r\n#\r\n# For modular systems such as New Jersey we use BlockLinear\r\n# as the block representing each repeated module.\r\n# ============================================================\r\n\r\nmodule_block_names = []\r\n\r\n\r\nfor item in module_meta:\r\n\r\n    segment_id = clean_text(\r\n        get_value(item, \"ID\")\r\n    )\r\n\r\n    info = segment_lookup.get(\r\n        segment_id\r\n    )\r\n\r\n\r\n    if info is None:\r\n\r\n        module_block_names.append(\"\")\r\n\r\n        warnings.append(\r\n            \"Module point for segment '{}' has no segment data.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    block_name = info[\r\n        \"BlockLinear\"\r\n    ]\r\n\r\n\r\n    if block_name == \"\":\r\n\r\n        warnings.append(\r\n            \"Segment '{}' generates modules but BlockLinear is empty.\"\r\n            .format(segment_id)\r\n        )\r\n\r\n\r\n    module_block_names.append(\r\n        block_name\r\n    )\r\n\r\n\r\n# ============================================================\r\n# LINEAR ELEMENT DATA\r\n#\r\n# One record per barrier segment.\r\n# Used later for longitudinal bionda / cable / tubular element.\r\n# ============================================================\r\n\r\nlinear_block_data = []\r\n\r\n\r\nfor segment in segments:\r\n\r\n    segment_id = clean_text(\r\n        get_value(segment, \"ID\")\r\n    )\r\n\r\n    parent_id = clean_text(\r\n        get_value(segment, \"ParentID\")\r\n    )\r\n\r\n    parent_data = get_value(\r\n        segment,\r\n        \"ParentData\"\r\n    )\r\n\r\n\r\n    block_linear = clean_text(\r\n        get_value(\r\n            parent_data,\r\n            \"BlockLinear\"\r\n        )\r\n    )\r\n\r\n    barrier_type = clean_text(\r\n        get_value(\r\n            parent_data,\r\n            \"Type\"\r\n        )\r\n    )\r\n\r\n    module_length = get_value(\r\n        parent_data,\r\n        \"ModuleLength\"\r\n    )\r\n\r\n\r\n    linear_block_data.append({\r\n\r\n        \"ID\":\r\n            segment_id,\r\n\r\n        \"ParentID\":\r\n            parent_id,\r\n\r\n        \"Type\":\r\n            barrier_type,\r\n\r\n        \"BlockLinear\":\r\n            block_linear,\r\n\r\n        \"ModuleLength\":\r\n            module_length\r\n    })\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    post_block_names,     # 0\r\n    module_block_names,   # 1\r\n    linear_block_data,    # 2\r\n    warnings              # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e177ecf83f0b402e8977e64ee72e30eb",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e42b5b09f3c040d8afc6d14319f13f54",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d9a75ba5ccb140909dc9fae896bf37fa",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cec0c7bff64c4aa08d31b59909bb295b",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b720057c440f4a5f9da6605b926edb2b",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "a09f014186a644f1bbba225a5211acaf",
