    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# INSERT_BARRIER_POSTS_V2\r\n# CPython3 - Civil 3D / AutoCAD\r\n#\r\n# IN[0] = Post Points\r\n# IN[1] = Post DWG Paths\r\n# IN[2] = Rotation Angles [radians]\r\n# IN[3] = Post Metadata\r\n# IN[4] = MaxCount\r\n#         0 = ALL\r\n#\r\n# OUT[0] = Inserted objects metadata\r\n# OUT[1] = Handles\r\n# OUT[2] = Errors\r\n# OUT[3] = Summary\r\n# ============================================================\r\n\r\nimport clr\r\nimport os\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\n\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    BlockTableRecord,\r\n    BlockReference,\r\n    Database,\r\n    OpenMode,\r\n    FileOpenMode\r\n)\r\n\r\nfrom Autodesk.AutoCAD.Geometry import Point3d\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\npoints_input = IN[0]\r\npaths_input = IN[1]\r\nrotations_input = IN[2]\r\nmetadata_input = IN[3]\r\nmax_count_input = IN[4]\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, (list, tuple)):\r\n\r\n        result = []\r\n\r\n        for item in value:\r\n\r\n            if isinstance(item, (list, tuple)):\r\n                result.extend(as_list(item))\r\n\r\n            else:\r\n                result.append(item)\r\n\r\n        return result\r\n\r\n    return [value]\r\n\r\n\r\ndef clean_text(value):\r\n\r\n    if value is None:\r\n        return \"\"\r\n\r\n    return str(value).strip()\r\n\r\n\r\ndef get_value(dictionary, key):\r\n\r\n    if dictionary is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        if isinstance(dictionary, dict):\r\n            return dictionary.get(key)\r\n\r\n        if hasattr(dictionary, \"ValueAtKey\"):\r\n            return dictionary.ValueAtKey(key)\r\n\r\n        return dictionary[key]\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef to_int(value, default=0):\r\n\r\n    try:\r\n        return int(value)\r\n\r\n    except:\r\n        return default\r\n\r\n\r\ndef point_xyz(point):\r\n\r\n    try:\r\n\r\n        return (\r\n            float(point.X),\r\n            float(point.Y),\r\n            float(point.Z)\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# PREPARE LISTS\r\n# ============================================================\r\n\r\npoints = as_list(points_input)\r\npaths = as_list(paths_input)\r\nrotations = as_list(rotations_input)\r\nmetadata = as_list(metadata_input)\r\n\r\nmax_count = to_int(\r\n    max_count_input,\r\n    0\r\n)\r\n\r\n\r\navailable_count = min(\r\n    len(points),\r\n    len(paths),\r\n    len(rotations),\r\n    len(metadata)\r\n)\r\n\r\n\r\nif max_count > 0:\r\n\r\n    process_count = min(\r\n        available_count,\r\n        max_count\r\n    )\r\n\r\nelse:\r\n\r\n    process_count = available_count\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\ninserted_data = []\r\nhandles = []\r\nerrors = []\r\n\r\n\r\n# ============================================================\r\n# AUTOCAD DOCUMENT\r\n# ============================================================\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\n\r\ndoc_lock = None\r\ntransaction = None\r\n\r\n\r\ntry:\r\n\r\n    # --------------------------------------------------------\r\n    # LOCK DOCUMENT\r\n    # --------------------------------------------------------\r\n\r\n    doc_lock = doc.LockDocument()\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # START TRANSACTION\r\n    # --------------------------------------------------------\r\n\r\n    transaction = (\r\n        db.TransactionManager.StartTransaction()\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BLOCK TABLE\r\n    # --------------------------------------------------------\r\n\r\n    block_table = transaction.GetObject(\r\n        db.BlockTableId,\r\n        OpenMode.ForRead\r\n    )\r\n\r\n\r\n    # IMPORTANT:\r\n    # get_Item() is safer than [] with CPython3\r\n    model_space_id = block_table.get_Item(\r\n        BlockTableRecord.ModelSpace\r\n    )\r\n\r\n\r\n    model_space = transaction.GetObject(\r\n        model_space_id,\r\n        OpenMode.ForWrite\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # INSERT POSTS\r\n    # ========================================================\r\n\r\n    for index in range(process_count):\r\n\r\n        point = points[index]\r\n\r\n        path = clean_text(\r\n            paths[index]\r\n        )\r\n\r\n        meta = metadata[index]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # METADATA\r\n        # ----------------------------------------------------\r\n\r\n        segment_id = clean_text(\r\n            get_value(meta, \"ID\")\r\n        )\r\n\r\n        parent_id = clean_text(\r\n            get_value(meta, \"ParentID\")\r\n        )\r\n\r\n        station = get_value(\r\n            meta,\r\n            \"Station\"\r\n        )\r\n\r\n        side = clean_text(\r\n            get_value(meta, \"Side\")\r\n        )\r\n\r\n        section_type = clean_text(\r\n            get_value(meta, \"SectionType\")\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # POINT\r\n        # ----------------------------------------------------\r\n\r\n        xyz = point_xyz(point)\r\n\r\n        if xyz is None:\r\n\r\n            errors.append({\r\n\r\n                \"Index\": index,\r\n                \"ID\": segment_id,\r\n                \"Reason\": \"Invalid insertion point\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # DWG PATH\r\n        # ----------------------------------------------------\r\n\r\n        if path == \"\" or not os.path.isfile(path):\r\n\r\n            errors.append({\r\n\r\n                \"Index\": index,\r\n                \"ID\": segment_id,\r\n                \"Path\": path,\r\n                \"Reason\": \"DWG file not found\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # ROTATION\r\n        # ----------------------------------------------------\r\n\r\n        try:\r\n\r\n            rotation = float(\r\n                rotations[index]\r\n            )\r\n\r\n        except:\r\n\r\n            errors.append({\r\n\r\n                \"Index\": index,\r\n                \"ID\": segment_id,\r\n                \"Reason\": \"Invalid rotation\"\r\n            })\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # BLOCK NAME\r\n        # ----------------------------------------------------\r\n\r\n        block_name = os.path.splitext(\r\n            os.path.basename(path)\r\n        )[0]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # GET OR LOAD BLOCK DEFINITION\r\n        # ----------------------------------------------------\r\n\r\n        if block_table.Has(block_name):\r\n\r\n            block_id = block_table.get_Item(\r\n                block_name\r\n            )\r\n\r\n\r\n        else:\r\n\r\n            source_db = Database(\r\n                False,\r\n                True\r\n            )\r\n\r\n            try:\r\n\r\n                source_db.ReadDwgFile(\r\n                    path,\r\n                    FileOpenMode.OpenForReadAndAllShare,\r\n                    True,\r\n                    \"\"\r\n                )\r\n\r\n\r\n                block_id = db.Insert(\r\n                    block_name,\r\n                    source_db,\r\n                    False\r\n                )\r\n\r\n\r\n            finally:\r\n\r\n                source_db.Dispose()\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # INSERT BLOCK\r\n        # ----------------------------------------------------\r\n\r\n        insertion_point = Point3d(\r\n            xyz[0],\r\n            xyz[1],\r\n            xyz[2]\r\n        )\r\n\r\n\r\n        block_ref = BlockReference(\r\n            insertion_point,\r\n            block_id\r\n        )\r\n\r\n\r\n        block_ref.Rotation = rotation\r\n\r\n\r\n        model_space.AppendEntity(\r\n            block_ref\r\n        )\r\n\r\n\r\n        transaction.AddNewlyCreatedDBObject(\r\n            block_ref,\r\n            True\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # IDENTIFIERS\r\n        # ----------------------------------------------------\r\n\r\n        handle = str(\r\n            block_ref.Handle\r\n        )\r\n\r\n        object_id = str(\r\n            block_ref.ObjectId\r\n        )\r\n\r\n\r\n        handles.append(\r\n            handle\r\n        )\r\n\r\n\r\n        inserted_data.append({\r\n\r\n            \"ComponentType\":\r\n                \"POST\",\r\n\r\n            \"Index\":\r\n                index,\r\n\r\n            \"ObjectId\":\r\n                object_id,\r\n\r\n            \"Handle\":\r\n                handle,\r\n\r\n            \"ID\":\r\n                segment_id,\r\n\r\n            \"ParentID\":\r\n                parent_id,\r\n\r\n            \"Station\":\r\n                station,\r\n\r\n            \"Side\":\r\n                side,\r\n\r\n            \"SectionType\":\r\n                section_type,\r\n\r\n            \"BlockName\":\r\n                block_name,\r\n\r\n            \"BlockPath\":\r\n                path,\r\n\r\n            \"Rotation\":\r\n                rotation,\r\n\r\n            \"X\":\r\n                xyz[0],\r\n\r\n            \"Y\":\r\n                xyz[1],\r\n\r\n            \"Z\":\r\n                xyz[2]\r\n        })\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COMMIT\r\n    # --------------------------------------------------------\r\n\r\n    transaction.Commit()\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Abort()\r\n        except:\r\n            pass\r\n\r\n\r\n    errors.append({\r\n\r\n        \"GeneralError\":\r\n            str(ex)\r\n    })\r\n\r\n\r\nfinally:\r\n\r\n    if transaction is not None:\r\n\r\n        try:\r\n            transaction.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n    if doc_lock is not None:\r\n\r\n        try:\r\n            doc_lock.Dispose()\r\n        except:\r\n            pass\r\n\r\n\r\n# ============================================================\r\n# SUMMARY\r\n# ============================================================\r\n\r\nsummary = {\r\n\r\n    \"AvailableItems\":\r\n        available_count,\r\n\r\n    \"RequestedItems\":\r\n        process_count,\r\n\r\n    \"CreatedItems\":\r\n        len(inserted_data),\r\n\r\n    \"ErrorCount\":\r\n        len(errors)\r\n}\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    inserted_data,    # 0\r\n    handles,          # 1\r\n    errors,           # 2\r\n    summary           # 3\r\n)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f284b1934bd74887b5531a5296b02218",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
